<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pcp_priority_view_tree" model="ir.ui.view">
        <field name="name">pcp.priority.view.tree</field>
        <field name="model">pcp.priority</field>
        <field name="arch" type="xml">
            <tree string="Priorities" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="pcp_priority_view_search" model="ir.ui.view">
        <field name="name">pcp.priority.view.search</field>
        <field name="model">pcp.priority</field>
        <field name="arch" type="xml">
            <search string="Priorities">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="pcp_priority_action" model="ir.actions.act_window">
        <field name="name">Priorities</field>
        <field name="res_model">pcp.priority</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Production Plan Priority</p>
            <p>Priorities are used to sequence Production Plans (e.g. A1, B1, C1). Users can
                add more (A2, B2, ...) as needed.</p>
        </field>
    </record>

</odoo>
