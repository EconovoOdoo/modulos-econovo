<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_plan_view_tree" model="ir.ui.view">
        <field name="name">mrp.plan.view.tree.pcp</field>
        <field name="model">mrp.plan</field>
        <field name="arch" type="xml">
            <tree string="Production Plans" editable="bottom" decoration-muted="not active">
                <field name="name"/>
                <field name="priority_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="mrp_plan_view_form" model="ir.ui.view">
        <field name="name">mrp.plan.view.form.pcp</field>
        <field name="model">mrp.plan</field>
        <field name="arch" type="xml">
            <form string="Production Plan">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. 933 Tolva A17/21 V2 x 12"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="priority_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Manufacturing Orders" name="manufacture_orders">
                            <field name="manufacture_order_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="reason_id"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_plan_view_search" model="ir.ui.view">
        <field name="name">mrp.plan.view.search.pcp</field>
        <field name="model">mrp.plan</field>
        <field name="arch" type="xml">
            <search string="Production Plans">
                <field name="name"/>
                <field name="priority_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Priority" name="group_by_priority" context="{'group_by': 'priority_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mrp_plan_action" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">mrp.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Production Plan</p>
        </field>
    </record>

</odoo>
