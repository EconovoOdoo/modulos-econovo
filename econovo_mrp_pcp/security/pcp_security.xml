<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_pcp" model="ir.module.category">
        <field name="name">PCP</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_pcp_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_pcp"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record id="group_pcp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_pcp"/>
        <field name="implied_ids" eval="[(4, ref('group_pcp_user'))]"/>
    </record>

</odoo>
