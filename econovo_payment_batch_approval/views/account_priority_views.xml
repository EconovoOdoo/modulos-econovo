<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Expose the payment priority as an optional (hidden by default) column
         in the native payments list view. -->
    <record id="view_account_payment_tree_priority" model="ir.ui.view">
        <field name="name">account.payment.tree.priority.inherit.econovo_payment_batch_approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="payment_priority" widget="priority" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Expose the payment priority as an optional (hidden by default) column
         in the native journal entries list view. -->
    <record id="view_move_tree_priority" model="ir.ui.view">
        <field name="name">account.move.tree.priority.inherit.econovo_payment_batch_approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="payment_priority" widget="priority" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
