<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         BoM form view: Group A structural fields become readonly
         when bom_locked_for_editor is True (active BoM used in MOs,
         no open ECO, current user is not MRP Administrator).
         ============================================================ -->
    <record id="mrp_bom_view_form_inherit_enforce_eco" model="ir.ui.view">
        <field name="name">mrp.bom.view.form.inherit.enforce.eco</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <!-- Invisible field required for readonly expressions on other fields -->
            <field name="code" position="before">
                <field name="bom_locked_for_editor" invisible="1"/>
            </field>

            <!-- Group A: structural header fields -->
            <field name="product_tmpl_id" position="attributes">
                <attribute name="readonly">bom_locked_for_editor</attribute>
            </field>
            <field name="product_id" position="attributes">
                <attribute name="readonly">bom_locked_for_editor</attribute>
            </field>
            <field name="product_qty" position="attributes">
                <attribute name="readonly">bom_locked_for_editor</attribute>
            </field>
            <field name="product_uom_id" position="attributes">
                <attribute name="readonly">bom_locked_for_editor</attribute>
            </field>
            <field name="code" position="attributes">
                <attribute name="readonly">bom_locked_for_editor</attribute>
            </field>
            <field name="type" position="attributes">
                <attribute name="readonly">bom_locked_for_editor</attribute>
            </field>
            <field name="ready_to_produce" position="attributes">
                <attribute name="readonly">bom_locked_for_editor</attribute>
            </field>
            <field name="consumption" position="attributes">
                <attribute name="readonly">bom_locked_for_editor</attribute>
            </field>
            <field name="picking_type_id" position="attributes">
                <attribute name="readonly">bom_locked_for_editor</attribute>
            </field>
        </field>
    </record>

    <!-- "Crear ECO" mass action bound to the BoM list and form -->
    <record id="action_mrp_bom_create_eco" model="ir.actions.server">
        <field name="name">Crear ECO</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_create_eco()</field>
    </record>
</odoo>
