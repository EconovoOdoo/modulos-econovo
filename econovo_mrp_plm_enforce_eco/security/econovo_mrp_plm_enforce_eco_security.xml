<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_rule_write_plm_enforce_eco" model="ir.rule">
        <field name="name">PLM Enforce ECO: write only on revisions, ECO-open or unused BoMs</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="domain_force">['|', '|', ('active', '=', False), ('eco_ids.state', 'in', ('confirmed', 'progress')), ('mo_count', '=', 0)]</field>
        <field name="groups" eval="[(4, ref('group_plm_controlled_editor'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="mrp_bom_rule_unlink_plm_enforce_eco" model="ir.rule">
        <field name="name">PLM Enforce ECO: unlink only on active BoMs without Manufacturing Orders</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="domain_force">['&amp;', ('active', '=', True), ('mo_count', '=', 0)]</field>
        <field name="groups" eval="[(4, ref('group_plm_controlled_editor'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
