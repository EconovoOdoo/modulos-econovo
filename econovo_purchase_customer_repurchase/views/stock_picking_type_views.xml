<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_type_view_form" model="ir.ui.view">
        <field name="name">stock.picking.type.view.form.inherit.econovo_purchase_customer_repurchase</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='second']" position="inside">
                <group name="econovo_customer_repurchase" string="Repurchase from Customer"
                       invisible="code != 'incoming'">
                    <field name="is_customer_repurchase"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
