<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit.econovo_stock_picking_validated_by</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="date_done" position="after">
                <field name="validation_user_id" invisible="state != 'done'"/>
            </field>
        </field>
    </record>

    <record id="vpicktree" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.econovo_stock_picking_validated_by</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="date_done" position="after">
                <field name="validation_user_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_picking_internal_search" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.econovo_stock_picking_validated_by</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="validation_user_id"/>
            </field>
            <filter name="picking_type" position="after">
                <filter name="validation_user" string="Validated By" domain="[]" context="{'group_by': 'validation_user_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
