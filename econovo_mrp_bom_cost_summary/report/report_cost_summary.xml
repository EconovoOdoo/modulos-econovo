<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================
         ir.actions.report — triggers the PDF engine
         ===================================================== -->
    <record id="action_report_mrp_bom_cost_summary" model="ir.actions.report">
        <field name="name">BOM Cost Summary</field>
        <field name="model">mrp.bom</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">econovo_mrp_bom_cost_summary.report_cost_summary</field>
        <field name="report_file">econovo_mrp_bom_cost_summary.report_cost_summary</field>
        <field name="print_report_name">'BOM Cost Summary - %s' % (object.display_name)</field>
    </record>

    <!-- =====================================================
         QWeb PDF template
         ===================================================== -->
    <template id="report_cost_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="doc['bom']"/>
                    <div class="page">

                        <!-- ── Header ── -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <h2>
                                    <t t-esc="doc['bom'].display_name"/>
                                </h2>
                                <p class="text-muted mb-0">
                                    <strong>BOM: </strong>
                                    <t t-esc="doc['bom'].code or '—'"/>
                                    &#160;|&#160;
                                    <strong>Qty: </strong>
                                    <t t-esc="doc['quantity']"/>
                                    <t t-esc="doc['bom'].product_uom_id.name"/>
                                </p>
                            </div>
                        </div>

                        <!-- ── No cost data ── -->
                        <t t-if="not doc['cost_summary']">
                            <div class="alert alert-warning">
                                No cost data available for this BOM.
                            </div>
                        </t>

                        <t t-if="doc['cost_summary']">
                            <t t-set="cs" t-value="doc['cost_summary']"/>
                            <t t-set="cur" t-value="doc['currency']"/>
                            <t t-set="usd" t-value="doc['secondary_currency']"/>

                            <!-- ── Components by category ── -->
                            <t t-if="doc['show_costs'] and cs['categories']">
                                <h4 class="mt-4">Components by Category</h4>
                                <table class="table table-sm table-bordered o_table">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Category / Product</th>
                                            <th class="text-end">%</th>
                                            <th class="text-end">
                                                Cost
                                                <small t-if="cur">
                                                    (<t t-esc="cur.name"/>)
                                                </small>
                                            </th>
                                            <t t-if="usd">
                                                <th class="text-end">
                                                    Cost (USD)
                                                </th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-call="econovo_mrp_bom_cost_summary.report_cost_summary_cat_rows">
                                            <t t-set="nodes" t-value="cs['categories']"/>
                                            <t t-set="cur" t-value="cur"/>
                                            <t t-set="usd" t-value="usd"/>
                                        </t>
                                    </tbody>
                                    <tfoot class="fw-bold bg-light">
                                        <tr>
                                            <td>Total Components</td>
                                            <td class="text-end">100%</td>
                                            <td class="text-end">
                                                <t t-esc="'%.2f' % cs['totals']['components']"/>
                                            </td>
                                            <t t-if="usd">
                                                <td class="text-end">
                                                    <t t-esc="'%.2f' % cs['totals']['components_usd']"
                                                       t-if="cs['totals']['components_usd'] is not False"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </tfoot>
                                </table>
                            </t>

                            <!-- ── Operations by workcenter ── -->
                            <t t-if="doc['show_operations'] and cs['workcenters']">
                                <h4 class="mt-4">Operations by Work Center</h4>
                                <table class="table table-sm table-bordered o_table">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Work Center / Operation</th>
                                            <th class="text-end">Duration (min)</th>
                                            <th class="text-end">%</th>
                                            <th class="text-end">
                                                Cost
                                                <small t-if="cur">
                                                    (<t t-esc="cur.name"/>)
                                                </small>
                                            </th>
                                            <t t-if="usd">
                                                <th class="text-end">Cost (USD)</th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="cs['workcenters']" t-as="wc">
                                            <!-- Workcenter row -->
                                            <tr class="fw-bold bg-light">
                                                <td>
                                                    <t t-esc="wc['name']"/>
                                                    <small class="text-muted ms-1">
                                                        (<t t-esc="len(wc['items'])"/>
                                                        operation<t t-if="len(wc['items']) != 1">s</t>)
                                                    </small>
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="'%.1f' % wc['total_duration']"/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="'%.1f' % wc['percentage'] + '%'"/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="'%.2f' % wc['total']"/>
                                                </td>
                                                <t t-if="usd">
                                                    <td class="text-end">
                                                        <t t-esc="'%.2f' % wc['total_usd']"
                                                           t-if="wc['total_usd'] is not False"/>
                                                    </td>
                                                </t>
                                            </tr>
                                            <!-- Operation rows -->
                                            <t t-foreach="wc['items']" t-as="item">
                                                <tr>
                                                    <td class="ps-4 text-muted">
                                                        <t t-esc="item['name']"/>
                                                        <small t-if="item.get('parent_name')"
                                                               class="ms-1 text-muted">
                                                            ← <t t-esc="item['parent_name']"/>
                                                        </small>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-esc="'%.1f' % item['duration']"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-esc="'%.1f' % item['percentage'] + '%'"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-esc="'%.2f' % item['total']"/>
                                                    </td>
                                                    <t t-if="usd">
                                                        <td class="text-end">
                                                            <t t-esc="'%.2f' % item['total_usd']"
                                                               t-if="item['total_usd'] is not False"/>
                                                        </td>
                                                    </t>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                    <tfoot class="fw-bold bg-light">
                                        <tr>
                                            <td>Total Operations</td>
                                            <td class="text-end">
                                                <t t-esc="'%.1f' % cs['totals']['operations_duration']"/>
                                            </td>
                                            <td class="text-end">100%</td>
                                            <td class="text-end">
                                                <t t-esc="'%.2f' % cs['totals']['operations']"/>
                                            </td>
                                            <t t-if="usd">
                                                <td class="text-end">
                                                    <t t-esc="'%.2f' % cs['totals']['operations_usd']"
                                                       t-if="cs['totals']['operations_usd'] is not False"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </tfoot>
                                </table>
                            </t>

                            <!-- ── Grand Total ── -->
                            <table class="table table-sm table-bordered mt-3 o_table">
                                <tfoot class="fw-bold">
                                    <tr class="table-primary">
                                        <td>Grand Total (Components + Operations)</td>
                                        <td class="text-end">
                                            <t t-esc="'%.2f' % cs['totals']['total']"/>
                                            <small t-if="cur" class="ms-1">
                                                <t t-esc="cur.name"/>
                                            </small>
                                        </td>
                                        <t t-if="usd">
                                            <td class="text-end">
                                                <t t-esc="'%.2f' % cs['totals']['total_usd']"
                                                   t-if="cs['totals']['total_usd'] is not False"/>
                                                <small class="ms-1">USD</small>
                                            </td>
                                        </t>
                                    </tr>
                                </tfoot>
                            </table>

                        </t><!-- end t-if cost_summary -->

                    </div><!-- .page -->
                </t><!-- web.external_layout -->
            </t><!-- foreach docs -->
        </t><!-- web.html_container -->
    </template>

    <!-- =====================================================
         Recursive sub-template: category tree rows
         ===================================================== -->
    <template id="report_cost_summary_cat_rows">
        <t t-foreach="nodes" t-as="node">
            <!-- Category header row -->
            <tr>
                <td>
                    <span t-attf-style="padding-left: #{node['depth'] * 16}px;">
                        <strong t-if="node['depth'] == 0">
                            <t t-esc="node['name']"/>
                        </strong>
                        <t t-else="" t-esc="node['name']"/>
                        <small class="text-muted ms-1">
                            (<t t-esc="len(node['products'])"/>
                            product<t t-if="len(node['products']) != 1">s</t>)
                        </small>
                    </span>
                </td>
                <td class="text-end">
                    <t t-esc="'%.1f' % node['percentage'] + '%'"/>
                </td>
                <td class="text-end fw-bold">
                    <t t-esc="'%.2f' % node['total']"/>
                </td>
                <t t-if="usd">
                    <td class="text-end fw-bold">
                        <t t-esc="'%.2f' % node['total_usd']"
                           t-if="node['total_usd'] is not False"/>
                    </td>
                </t>
            </tr>
            <!-- Product rows under this category -->
            <t t-foreach="node['products']" t-as="prod">
                <tr>
                    <td>
                        <span t-attf-style="padding-left: #{(node['depth'] + 1) * 16}px;"
                              class="text-muted">
                            <t t-esc="prod['name']"/>
                        </span>
                    </td>
                    <td class="text-end text-muted">
                        <t t-esc="'%.1f' % prod['percentage'] + '%'"/>
                    </td>
                    <td class="text-end text-muted">
                        <t t-esc="'%.2f' % prod['total']"/>
                    </td>
                    <t t-if="usd">
                        <td class="text-end text-muted">
                            <t t-esc="'%.2f' % prod['total_usd']"
                               t-if="prod['total_usd'] is not False"/>
                        </td>
                    </t>
                </tr>
            </t>
            <!-- Children categories (recursive) -->
            <t t-if="node['children']">
                <t t-call="econovo_mrp_bom_cost_summary.report_cost_summary_cat_rows">
                    <t t-set="nodes" t-value="node['children']"/>
                    <t t-set="cur" t-value="cur"/>
                    <t t-set="usd" t-value="usd"/>
                </t>
            </t>
        </t>
    </template>

</odoo>
