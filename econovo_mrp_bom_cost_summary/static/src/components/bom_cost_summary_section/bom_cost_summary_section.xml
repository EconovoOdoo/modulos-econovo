<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<div t-name="econovo_mrp_bom_cost_summary.BomCostSummarySection"
     class="o_econovo_cost_summary mt-4">

    <h5 class="o_econovo_cost_summary__title mb-3">
        <i class="fa fa-bar-chart me-2"/>Cost Summary
    </h5>

    <!-- Single unified table ensures all columns are aligned across sections -->
    <table class="table table-sm o_econovo_cost_summary__table mb-0">

        <colgroup>
            <col class="o_econovo_cost_summary__fold-col"/>
            <col/><!-- Name: auto width (takes remaining space) -->
            <col style="width: 7%;"/><!-- Quantity / Duration -->
            <col style="width: 4%;"/><!-- % -->
            <col style="width: 4%;"/><!-- Lead Time -->
            <col style="width: 10%;"/><!-- Route -->
            <col style="width: 10%;"/><!-- BoM Cost -->
            <col t-if="hasSecondary" style="width: 10%;"/><!-- BoM Cost USD -->
            <col style="width: 10%;"/><!-- Product Cost -->
            <col t-if="hasSecondary" style="width: 10%;"/><!-- Product Cost USD -->
        </colgroup>

        <!-- ===== COMPONENTS BY PRODUCT CATEGORY ===== -->
        <t t-if="data.categories.length > 0">
            <thead>
                <tr class="o_econovo_cost_summary__section-header">
                    <th class="o_econovo_cost_summary__fold-col"/>
                    <th>Components by Product Category</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">%</th>
                    <th class="text-end">Lead Time</th>
                    <th>Route</th>
                    <th class="text-end">BoM Cost</th>
                    <th t-if="hasSecondary" class="text-end">BoM Cost <t t-esc="secondaryCurrency.name"/></th>
                    <th class="text-end">Product Cost</th>
                    <th t-if="hasSecondary" class="text-end">Product Cost <t t-esc="secondaryCurrency.name"/></th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="flatCategoryRows" t-as="row" t-key="row.rowKey">
                    <!-- CATEGORY ROW -->
                    <tr t-if="row.type === 'category'"
                        class="o_econovo_cost_summary__group-row"
                        t-on-click="() => this.toggleCategory(row.node.id)">
                        <td class="o_econovo_cost_summary__fold-col"/>
                        <td t-attf-style="padding-left: {{ row.depth * 20 }}px">
                            <button class="btn btn-light btn-sm py-0 px-1 me-1"
                                    t-att-title="isCategoryFolded(row.node.id) ? 'Unfold' : 'Fold'">
                                <i t-att-class="'fa fa-fw ' + (isCategoryFolded(row.node.id) ? 'fa-caret-right' : 'fa-caret-down')"
                                   role="img"/>
                            </button>
                            <strong t-esc="row.node.name"/>
                            <span class="text-muted ms-1 fw-normal">(<t t-esc="categoryCount(row.node)"/>)</span>
                        </td>
                        <td/>
                        <td class="text-end text-muted">
                            <strong t-esc="fmtPct(row.node.percentage)"/>
                        </td>
                        <td/>
                        <td/>
                        <td class="text-end">
                            <strong t-esc="fmtMoney(row.node.total)"/>
                        </td>
                        <td t-if="hasSecondary" class="text-end text-muted">
                            <strong t-esc="fmtUsd(row.node.total_usd)"/>
                        </td>
                        <td class="text-end">
                            <strong t-esc="fmtMoney(row.node.prod_cost_total)"/>
                        </td>
                        <td t-if="hasSecondary" class="text-end text-muted">
                            <strong t-esc="fmtUsd(row.node.prod_cost_total_usd)"/>
                        </td>
                    </tr>
                    <!-- PRODUCT ROW -->
                    <tr t-elif="row.type === 'product'"
                        class="o_econovo_cost_summary__product-row"
                        t-on-click="() => this.toggleProduct(row.node.id, row.prod.product_id)">
                        <td/>
                        <td t-attf-style="padding-left: {{ row.depth * 20 }}px">
                            <button class="btn btn-light btn-sm py-0 px-1 me-1"
                                    t-att-title="isProductFolded(row.node.id, row.prod.product_id) ? 'Show usages' : 'Hide usages'">
                                <i t-att-class="'fa fa-fw ' + (isProductFolded(row.node.id, row.prod.product_id) ? 'fa-caret-right' : 'fa-caret-down')"
                                   role="img"/>
                            </button>
                            <a href="#" class="o_econovo_cost_summary__link"
                               t-on-click.stop.prevent="() => this.openFormDialog(row.prod.link_id, row.prod.link_model)">
                                <t t-esc="row.prod.name"/>
                            </a>
                            <span class="text-muted ms-1">(<t t-esc="row.prod.usages.length"/>)</span>
                        </td>
                        <td class="text-end text-muted">
                            <t t-set="prodQty" t-value="productQuantity(row.prod)"/>
                            <t t-if="prodQty">
                                <t t-esc="formatFloat(prodQty.quantity, {digits: [false, props.precision]})"/>
                                <t t-if="showUom">
                                    <span class="ms-1" t-esc="prodQty.uom_name"/>
                                </t>
                            </t>
                            <t t-else="">
                                <span title="Mixed units of measure">\u2014</span>
                            </t>
                        </td>
                        <td class="text-end text-muted">
                            <t t-esc="fmtPct(row.prod.percentage)"/>
                        </td>
                        <td class="text-end text-muted">
                            <t t-set="prodLt" t-value="productLeadTime(row.prod)"/>
                            <span t-if="prodLt !== false" t-esc="fmtLeadTime(prodLt)"/>
                        </td>
                        <td class="text-muted">
                            <t t-set="prodRoute" t-value="productRoute(row.prod)"/>
                            <div t-if="prodRoute">
                                <span t-esc="prodRoute.route_name"/>: 
                                <a href="#" class="o_econovo_cost_summary__link"
                                   t-on-click.stop.prevent="() => this.goToRoute(prodRoute.route_type, prodRoute.bom_id)"
                                   t-esc="prodRoute.route_detail"/>
                            </div>
                        </td>
                        <td class="text-end">
                            <t t-esc="fmtMoney(row.prod.total)"/>
                        </td>
                        <td t-if="hasSecondary" class="text-end text-muted">
                            <t t-esc="fmtUsd(row.prod.total_usd)"/>
                        </td>
                        <td class="text-end">
                            <t t-esc="fmtMoney(row.prod.prod_cost_total)"/>
                        </td>
                        <td t-if="hasSecondary" class="text-end text-muted">
                            <t t-esc="fmtUsd(row.prod.prod_cost_total_usd)"/>
                        </td>
                    </tr>
                    <!-- USAGE ROW -->
                    <tr t-else=""
                        class="o_econovo_cost_summary__usage-row">
                        <td/>
                        <td t-attf-style="padding-left: {{ row.depth * 20 + 44 }}px">
                            <a href="#" class="o_econovo_cost_summary__link"
                               t-on-click.stop.prevent="() => this.openFormDialog(row.usage.parent_product_id, 'product.product')">
                                <t t-esc="row.usage.parent_name"/>
                            </a>
                        </td>
                        <td class="text-end text-muted">
                            <t t-esc="formatFloat(row.usage.quantity, {digits: [false, props.precision]})"/>
                            <t t-if="showUom">
                                <span class="ms-1" t-esc="row.usage.uom_name"/>
                            </t>
                        </td>
                        <td class="text-end text-muted">
                            <t t-esc="fmtPct(row.usage.percentage)"/>
                        </td>
                        <td class="text-end text-muted">
                            <span t-if="row.usage.lead_time !== false" t-esc="fmtLeadTime(row.usage.lead_time)"/>
                        </td>
                        <td class="text-muted">
                            <div t-if="row.usage.parent_route_name">
                                <span t-esc="row.usage.parent_route_name"/>: 
                                <a href="#" class="o_econovo_cost_summary__link"
                                   t-on-click.stop.prevent="() => this.goToRoute(row.usage.parent_route_type, row.usage.parent_bom_id)"
                                   t-esc="row.usage.parent_route_detail"/>
                            </div>
                        </td>
                        <td class="text-end">
                            <t t-esc="fmtMoney(row.usage.total)"/>
                        </td>
                        <td t-if="hasSecondary" class="text-end text-muted">
                            <t t-esc="fmtUsd(row.usage.total_usd)"/>
                        </td>
                        <td class="text-end">
                            <t t-esc="fmtMoney(row.usage.prod_cost)"/>
                        </td>
                        <td t-if="hasSecondary" class="text-end text-muted">
                            <t t-esc="fmtUsd(row.usage.prod_cost_usd)"/>
                        </td>
                    </tr>
                </t>

                <!-- Subtotal Components -->
                <tr class="o_econovo_cost_summary__subtotal-row">
                    <td/>
                    <td class="text-end"><strong>Subtotal Components</strong></td>
                    <td/>
                    <td/>
                    <td/>
                    <td/>
                    <td class="text-end">
                        <strong t-esc="fmtMoney(data.totals.components)"/>
                    </td>
                    <td t-if="hasSecondary" class="text-end text-muted">
                        <strong t-esc="fmtUsd(data.totals.components_usd)"/>
                    </td>
                    <td class="text-end">
                        <strong t-esc="fmtMoney(data.totals.prod_cost)"/>
                    </td>
                    <td t-if="hasSecondary" class="text-end text-muted">
                        <strong t-esc="fmtUsd(data.totals.prod_cost_usd)"/>
                    </td>
                </tr>
            </tbody>
        </t>

        <br class="my-3"/>

        <!-- ===== OPERATIONS BY WORK CENTER ===== -->
        <t t-if="data.workcenters.length > 0">
            <thead>
                <tr class="o_econovo_cost_summary__section-header">
                    <th class="o_econovo_cost_summary__fold-col"/>
                    <th>Operations by Work Center</th>
                    <th class="text-end">Duration</th>
                    <th class="text-end">%</th>
                    <th class="text-end">Lead Time</th>
                    <th>Route</th>
                    <th class="text-end">BoM Cost</th>
                    <th t-if="hasSecondary" class="text-end">BoM Cost <t t-esc="secondaryCurrency.name"/></th>
                    <th/>
                    <th t-if="hasSecondary"/>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="data.workcenters" t-as="wc" t-key="wc.id">
                    <!-- Level 1: Workcenter -->
                    <tr class="o_econovo_cost_summary__group-row"
                        t-on-click="() => this.toggleWorkcenter(wc.id)">
                        <td class="o_econovo_cost_summary__fold-col"/>
                        <td>
                            <button class="btn btn-light btn-sm py-0 px-1 me-1"
                                    t-att-title="isWorkcenterFolded(wc.id) ? 'Unfold' : 'Fold'">
                                <i t-att-class="'fa fa-fw ' + (isWorkcenterFolded(wc.id) ? 'fa-caret-right' : 'fa-caret-down')"
                                   role="img"/>
                            </button>
                            <strong t-esc="wc.name"/>
                            <span class="text-muted ms-1 fw-normal">(<t t-esc="wc.items.length"/>)</span>
                        </td>
                        <td class="text-end text-muted">
                            <strong t-esc="fmtDuration(wc.total_duration)"/>
                        </td>
                        <td class="text-end text-muted">
                            <strong t-esc="fmtPct(wc.percentage)"/>
                        </td>
                        <td/>
                        <td/>
                        <td class="text-end">
                            <strong t-esc="fmtMoney(wc.total)"/>
                        </td>
                        <td t-if="hasSecondary" class="text-end text-muted">
                            <strong t-esc="fmtUsd(wc.total_usd)"/>
                        </td>
                        <td/>
                        <td t-if="hasSecondary"/>
                    </tr>

                    <t t-if="!isWorkcenterFolded(wc.id)">
                        <t t-foreach="wc.items" t-as="op" t-key="op_index">
                            <!-- Operation + parent product in a single row -->
                            <tr class="o_econovo_cost_summary__product-row">
                                <td/>
                                <td style="padding-left: 58px;">
                                    <a href="#" class="o_econovo_cost_summary__link"
                                       t-on-click.stop.prevent="() => this.openFormDialog(op.link_id, 'mrp.routing.workcenter')">
                                        <t t-esc="op.name"/></a><t t-if="op.parent_name">: 
                                    <a href="#" class="o_econovo_cost_summary__link"
                                       t-on-click.stop.prevent="() => this.openFormDialog(op.parent_product_id, 'product.product')">
                                        <t t-esc="op.parent_name"/>
                                    </a></t>
                                </td>
                                <td class="text-end text-muted">
                                    <t t-esc="fmtDuration(op.duration)"/>
                                </td>
                                <td class="text-end text-muted">
                                    <t t-esc="fmtPct(op.percentage)"/>
                                </td>
                                <td class="text-end text-muted">
                                    <span t-if="op.lead_time !== false" t-esc="fmtLeadTime(op.lead_time)"/>
                                </td>
                                <td class="text-muted">
                                    <div t-if="op.route_name">
                                        <span t-esc="op.route_name"/>: 
                                        <a href="#" class="o_econovo_cost_summary__link"
                                           t-on-click.stop.prevent="() => this.goToRoute(op.route_type, op.bom_id)"
                                           t-esc="op.route_detail"/>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <t t-esc="fmtMoney(op.total)"/>
                                </td>
                                <td t-if="hasSecondary" class="text-end text-muted">
                                    <t t-esc="fmtUsd(op.total_usd)"/>
                                </td>
                                <td/>
                                <td t-if="hasSecondary"/>
                            </tr>
                        </t>
                    </t>
                </t>

                <!-- Subtotal Operations -->
                <tr class="o_econovo_cost_summary__subtotal-row">
                    <td/>
                    <td class="text-end"><strong>Subtotal Operations</strong></td>
                    <td class="text-end">
                        <strong t-esc="fmtDuration(data.totals.operations_duration)"/>
                    </td>
                    <td/>
                    <td/>
                    <td/>
                    <td class="text-end">
                        <strong t-esc="fmtMoney(data.totals.operations)"/>
                    </td>
                    <td t-if="hasSecondary" class="text-end">
                        <strong t-esc="fmtUsd(data.totals.operations_usd)"/>
                    </td>
                    <td/>
                    <td t-if="hasSecondary"/>
                </tr>
            </tbody>
        </t>

        <!-- ===== GRAND TOTAL ===== -->
        <tfoot>
            <tr class="o_econovo_cost_summary__grand-total-row">
                <td class="o_econovo_cost_summary__fold-col"/>
                <td class="text-end"><strong>TOTAL BOM COST</strong></td>
                <td/>
                <td/>
                <td/>
                <td/>
                <td class="text-end">
                    <strong t-esc="fmtMoney(data.totals.total)"/>
                </td>
                <td t-if="hasSecondary" class="text-end">
                    <strong t-esc="fmtUsd(data.totals.total_usd)"/>
                </td>
                <td/>
                <td t-if="hasSecondary"/>
            </tr>
            <tr class="o_econovo_cost_summary__grand-total-row">
                <td class="o_econovo_cost_summary__fold-col"/>
                <td class="text-end"><strong>TOTAL PRODUCT COST</strong></td>
                <td/>
                <td/>
                <td/>
                <td/>
                <td/>
                <td t-if="hasSecondary"/>
                <td class="text-end">
                    <strong t-esc="fmtMoney(data.totals.total_prod)"/>
                </td>
                <td t-if="hasSecondary" class="text-end">
                    <strong t-esc="fmtUsd(data.totals.total_prod_usd)"/>
                </td>
            </tr>
        </tfoot>

    </table>

</div>

</templates>
