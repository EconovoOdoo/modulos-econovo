<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Inherit stock.warehouse form view to add transit checkbox -->
        <record id="view_warehouse_form_inherit_transit" model="ir.ui.view">
            <field name="name">stock.warehouse.form.inherit.econovo.transit</field>
            <field name="model">stock.warehouse</field>
            <field name="inherit_id" ref="stock.view_warehouse"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_ids']" position="after">
                    <field name="is_transit_warehouse" 
                           invisible="user_ids"/>
                    <div class="alert alert-info" role="alert" 
                         invisible="not is_transit_warehouse">
                        <strong>Transit Warehouse:</strong> This warehouse is accessible by all users for transit operations,
                        regardless of their warehouse assignments. Useful for inter-warehouse transfers.
                    </div>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>
