<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Inherit stock.location form view to add transit checkbox -->
        <record id="view_location_form_inherit_transit" model="ir.ui.view">
            <field name="name">stock.location.form.inherit.econovo.transit</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='usage']" position="after">
                    <field name="is_transit_location"/>
                    <div class="alert alert-info" role="alert" 
                         invisible="not is_transit_location">
                        <strong>Transit Location:</strong> This location is accessible by all users for transit operations,
                        even if they don't have access to the parent warehouse. Useful for shared dock/staging areas.
                    </div>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>
