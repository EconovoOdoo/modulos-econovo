<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- 
        ========================================================================
        INVENTORY CONFIGURATION SETTINGS
        ========================================================================
        
        Adds "Restrict Stock Warehouse" setting to Inventory > Configuration.
        When enabled, users must be explicitly assigned to warehouses to access them.
    -->
    
    <!-- Inventory settings form view inherited -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.econovo.user.warehouse.restriction</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="1"/>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='use_own_routes']" position="after">
                <setting id="warehouse_restriction"
                         invisible="group_stock_multi_locations == False"
                         help="Enable warehouse restriction to control which users can access specific warehouses">
                    <field name="group_user_warehouse_restriction" on_change="1"/>
                    <div class="text-muted" invisible="not group_user_warehouse_restriction">
                        When enabled, users must be assigned to warehouses via the "Allowed Users" tab
                        in warehouse configuration. Record Rules will filter inventory operations accordingly.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
