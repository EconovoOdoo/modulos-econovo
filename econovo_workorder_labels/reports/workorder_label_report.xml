<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_workorder_label" model="report.paperformat">
        <field name="name">Workorder Label 100x70mm</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">70</field>
        <field name="page_width">100</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">203</field>
    </record>

    <record id="action_workorder_label_report" model="ir.actions.report">
        <field name="name">Workorder Label</field>
        <field name="model">mrp.workorder</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">econovo_workorder_labels.report_workorder_label</field>
        <field name="report_file">econovo_workorder_labels.report_workorder_label</field>
        <field name="paperformat_id" ref="paperformat_workorder_label"/>
        <field name="binding_model_id" ref="mrp.model_mrp_workorder"/>
        <field name="binding_type">report</field>
    </record>
    
    <template id="report_workorder_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="workorder">
                <div class="page" style="width: 100mm; height: 70mm;">
                    <div class="text-center">
                        <h3>Work Order Label</h3>
                    </div>
                    <table class="table table-sm table-bordered">
                        <tr>
                            <th>Production Date</th>
                            <td><span t-field="workorder.date_planned_start"/></td>
                            <th>Print Date</th>
                            <td t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/>
                        </tr>
                        <tr>
                            <th>Name</th>
                            <td colspan="3"><span t-field="workorder.display_name"/></td>
                        </tr>
                        <tr>
                            <th>Production</th>
                            <td colspan="3"><span t-field="workorder.production_id"/></td>
                        </tr>
                        <tr>
                            <th>Product</th>
                            <td colspan="3"><span t-field="workorder.product_id"/></td>
                        </tr>
                        <tr>
                            <th>Needed By</th>
                            <td colspan="3">
                                <t t-foreach="workorder.needed_by_workorder_ids" t-as="needed">
                                    <span t-field="needed.name"/><t t-if="not needed_last">, </t>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <th>Blocked By</th>
                            <td colspan="3">
                                <t t-foreach="workorder.blocked_by_workorder_ids" t-as="blocked">
                                    <span t-field="blocked.name"/><t t-if="not blocked_last">, </t>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <th>Progress</th>
                            <td colspan="3">
                                <span t-field="workorder.qty_produced"/> / 
                                <span t-field="workorder.qty_producing"/>
                            </td>
                        </tr>
                        <tr>
                            <th>Parent</th>
                            <td colspan="3"><span t-esc="workorder.get_parent_bom_product().name or 'N/A'"/></td>
                        </tr>
                        <tr>
                            <th>Ancestor</th>
                            <td colspan="3"><span t-esc="workorder.get_top_bom_ancestor().name or 'N/A'"/></td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>