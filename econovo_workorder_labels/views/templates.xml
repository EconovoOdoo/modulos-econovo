<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Add "Print Label" button to Work Order form -->
        <record id="view_mrp_workorder_form_inherit" model="ir.ui.view">
            <field name="name">mrp.workorder.form.inherit.label</field>
            <field name="model">mrp.workorder</field>
            <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="print_workorder_label" string="Imprimir Etiqueta de la Operación" type="object" 
                            class="oe_highlight" groups="mrp.group_mrp_user"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>