<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- Location Label Layout Wizard Form View -->
    <record id="view_location_label_layout_form" model="ir.ui.view">
        <field name="name">location.label.layout.form</field>
        <field name="model">location.label.layout</field>
        <field name="arch" type="xml">
            <form string="Print Location Labels">
                <group>
                    <group>
                        <field name="print_format" widget="radio"/>
                    </group>
                    <group>
                        <field name="location_ids" widget="many2many_tags" invisible="1"/>
                        <field name="location_quantity"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_labels" 
                            string="Print" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Wizard Action -->
    <record id="action_open_location_label_layout" model="ir.actions.act_window">
        <field name="name">Print Location Labels</field>
        <field name="res_model">location.label.layout</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_location"/>
    </record>
    
</odoo>
