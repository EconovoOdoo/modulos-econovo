<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Paperformat for 100x50mm labels -->
    <record id="paperformat_location_label_100x50" model="report.paperformat">
        <field name="name">Location Label 100x50mm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">50</field>
        <field name="page_width">100</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">1</field>
        <field name="margin_bottom">1</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- Report action for 100x50mm -->
    <record id="action_report_location_label_100x50" model="ir.actions.report">
        <field name="name">Location Label 100x50mm</field>
        <field name="model">stock.location</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">econovo_location_labels.report_location_label_100x50</field>
        <field name="report_file">econovo_location_labels.report_location_label_100x50</field>
        <field name="print_report_name">'Location Label - %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_location_label_100x50"/>
        <field name="binding_model_id" ref="stock.model_stock_location"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
