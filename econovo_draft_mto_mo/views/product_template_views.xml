<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Add MO Draft Control to Product Template Form -->
    <record id="product_template_form_view_inherit_mo_draft" model="ir.ui.view">
        <field name="name">product.template.form.inherit.econovo.mo.draft</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add after General Information tab or inside it -->
            <xpath expr="//notebook" position="inside">
                <page string="Manufacturing" name="manufacturing_econovo" groups="mrp.group_mrp_user">
                    <group string="Manufacturing Order Draft Control" name="mo_draft_control">
                        <field name="mo_draft_policy" widget="radio"/>
                        
                        <!-- Custom Configuration - only visible when policy is 'custom' -->
                        <group string="Keep Draft for:" invisible="mo_draft_policy != 'custom'" colspan="2">
                            <field name="mo_draft_mto" string="MTO (Sales Orders)"/>
                            <field name="mo_draft_mts" string="MTS (Replenishment)"/>
                            <field name="mo_draft_mps" string="MPS (Master Schedule)"/>
                            <field name="mo_draft_orderpoint" string="Orderpoint (Reorder Rules)"/>
                        </group>
                        
                        <!-- Help text -->
                        <div colspan="2" class="alert alert-info" role="alert" invisible="mo_draft_policy == 'use_global'">
                            <p class="mb-0">
                                <i class="fa fa-info-circle"/> This configuration overrides the global settings for this product.
                                Users can still override this with their personal preferences.
                            </p>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    
</odoo>
