<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_remito_digital" model="report.paperformat">
        <field name="name">Remito Digital A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_remito_digital" model="ir.actions.report">
        <field name="name">Remito Digital</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">econovo_remito_digital.report_remito_digital_document</field>
        <field name="report_file">econovo_remito_digital.report_remito_digital_document</field>
        <field name="paperformat_id" ref="paperformat_remito_digital"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
