<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_remito_digital_document">
    <t t-foreach="docs" t-as="o">
        <t t-set="book" t-value="o.book_id"/>
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="partner" t-value="o.partner_id"/>
        <t t-set="pages" t-value="o._get_remito_digital_grouped_pages()"/>
        <t t-foreach="pages" t-as="page_lines">
            <t t-set="page_num" t-value="page_lines_index + 1"/>
            <t t-set="page_total" t-value="len(pages)"/>
            <div class="page remito-page">

                <!-- ============================================================ -->
                <!-- HEADER                                                        -->
                <!-- ============================================================ -->
                <table class="remito-header-table">
                    <tr>
                        <!-- Left: company info -->
                        <td class="remito-company-cell">
                            <div class="remito-company-logo">
                                <img t-if="company.logo"
                                     t-att-src="'data:image/png;base64,' + company.logo.decode('utf-8')"
                                     class="company-logo-img" alt="Logo"/>
                            </div>
                            <div class="remito-company-info">
                                <div class="company-address" t-out="company.street or ''"/>
                                <div class="company-address"
                                     t-out="(company.city or '') + (', ' + company.zip if company.zip else '')"/>
                                <div class="company-address" t-out="company.website or ''"/>
                                <div class="company-address" t-out="company.email or ''"/>
                            </div>
                            <div class="remito-company-secondary">
                                <t t-out="company.partner_id.name or ''"/>
                            </div>
                            <div class="remito-iva-type">
                                I.V.A. RESPONSABLE INSCRIPTO
                            </div>
                            <div class="remito-phone">
                                <t t-if="company.phone">
                                    &#9990; <t t-out="company.phone"/>
                                </t>
                            </div>
                        </td>

                        <!-- Center: R badge + number block -->
                        <td class="remito-badge-cell">
                            <div class="remito-r-badge">R</div>
                            <div class="remito-codigo">
                                Código Nº 91<br/>
                                DOCUMENTO<br/>
                                NO VALIDO<br/>
                                COMO<br/>
                                FACTURA
                            </div>
                        </td>

                        <!-- Right: voucher number + date -->
                        <td class="remito-number-cell">
                            <div class="remito-number-header">
                                Nº <t t-out="o.voucher_ids and o.voucher_ids[0].name or '_______________'"/>
                            </div>
                            <table class="remito-date-table">
                                <tr>
                                    <th class="remito-th-green">REMITO</th>
                                    <th class="remito-th-green">FECHA</th>
                                </tr>
                                <tr>
                                    <td class="remito-td-empty"></td>
                                    <td class="remito-td-date">
                                        <t t-out="o.date_done and o.date_done.strftime('%d/%m/%Y') or ''"/>
                                    </td>
                                </tr>
                            </table>
                            <!-- Fiscal company data below REMITO/FECHA -->
                            <table class="remito-fiscal-table">
                                <tr>
                                    <td>C.U.I.T.: <strong t-out="company.vat or ''"/></td>
                                    <td>Ing. Brutos C.M. <t t-out="company.l10n_ar_gross_income_number or ''"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        Inicio Actividad
                                        <t t-if="company.l10n_ar_afip_start_date"
                                           t-out="company.l10n_ar_afip_start_date.strftime('%d/%m/%Y')"/>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- ============================================================ -->
                <!-- DESTINATARIO                                                  -->
                <!-- ============================================================ -->
                <table class="remito-recipient-table">
                    <tr>
                        <!-- Left column -->
                        <td class="remito-recipient-left">
                            <div class="remito-field-row">
                                <span class="remito-label">SEÑOR/ES:</span>
                                <span class="remito-value" t-out="partner.name or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">DIRECCIÓN:</span>
                                <span class="remito-value" t-out="partner.street or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">CIUDAD:</span>
                                <span class="remito-value" t-out="partner.city or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">C.P.:</span>
                                <span class="remito-value" t-out="partner.zip or ''"/>
                            </div>
                        </td>
                        <!-- Right column -->
                        <td class="remito-recipient-right">
                            <div class="remito-field-row">
                                <span class="remito-label">Cuenta Nº:</span>
                                <span class="remito-value" t-out="partner.ref or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">C.U.I.T.:</span>
                                <span class="remito-value" t-out="partner.vat or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">Condición:</span>
                                <span class="remito-value"
                                      t-out="partner.l10n_ar_afip_responsibility_type_id.name or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">Ing. Brutos:</span>
                                <span class="remito-value"
                                      t-out="partner.l10n_ar_gross_income_number or ''"/>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- ============================================================ -->
                <!-- TRANSPORTE / ORDEN DE COMPRA / SOLICITADO POR                -->
                <!-- ============================================================ -->
                <table class="remito-transport-table">
                    <tr>
                        <td class="remito-transport-cell">
                            <span class="remito-label">TRANSPORTE:</span>
                            <span class="remito-value"></span>
                        </td>
                        <td class="remito-oc-cell">
                            <span class="remito-label">ORDEN DE COMPRA Nº:</span>
                            <span class="remito-value" t-out="o.origin or ''"/>
                        </td>
                        <td class="remito-solicitado-cell">
                            <span class="remito-label">SOLICITADO POR:</span>
                            <span class="remito-value" t-out="o.user_id.name or ''"/>
                        </td>
                    </tr>
                </table>

                <!-- ============================================================ -->
                <!-- TABLA DE PRODUCTOS                                            -->
                <!-- ============================================================ -->
                <table class="remito-products-table">
                    <thead>
                        <tr>
                            <th class="col-code">CÓDIGO</th>
                            <th class="col-qty">CANTIDAD</th>
                            <th class="col-detail">DETALLE</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="page_lines" t-as="line">
                            <td class="col-code" t-out="line['code']"/>
                            <td class="col-qty">
                                <t t-out="'%.2f' % line['qty_total']"/>
                                <t t-if="line['uom']">
                                    <small> <t t-out="line['uom']"/></small>
                                </t>
                            </td>
                            <td class="col-detail">
                                <div class="product-name" t-out="line['product'].name or ''"/>
                                <t t-if="line['lots_text']">
                                    <div class="product-lots" t-out="line['lots_text']"/>
                                </t>
                            </td>
                        </tr>
                        <!-- Fill empty rows to maintain page height when few lines -->
                        <t t-foreach="range(25 - len(page_lines))" t-as="empty_row">
                            <tr class="remito-empty-row">
                                <td></td><td></td><td></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- ============================================================ -->
                <!-- OBSERVATIONS (from stock_ux)                                 -->
                <!-- ============================================================ -->
                <t t-if="o.observations">
                    <div class="remito-observations">
                        <span class="remito-label">Observaciones: </span>
                        <t t-out="o.observations"/>
                    </div>
                </t>

                <!-- ============================================================ -->
                <!-- FOOTER: TRASLADO + FIRMA                                      -->
                <!-- ============================================================ -->
                <table class="remito-footer-table">
                    <tr>
                        <td class="remito-traslado-cell">
                            <t t-if="book.is_interwarehouse_company_transfer">
                                <div class="remito-traslado-text">
                                    TRASLADO DE MERCADERIA ENTRE SUCURSALES
                                </div>
                            </t>
                        </td>
                        <td class="remito-firma-cell">
                            <div class="remito-conformidad">Conforme Recepción</div>
                            <div class="remito-fecha-firma">
                                Fecha ___________________________
                            </div>
                            <div class="remito-firma-sello">
                                ___________________________________<br/>
                                Firma y Sello del Destinatario
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- ============================================================ -->
                <!-- BOTTOM: IMPRENTA + CAI                                        -->
                <!-- ============================================================ -->
                <table class="remito-imprenta-table">
                    <tr>
                        <!-- Printer data (left) -->
                        <td class="remito-imprenta-cell">
                            <t t-if="book.printer_id">
                                <t t-set="p" t-value="book.printer_id"/>
                                <div class="imprenta-name">
                                    <t t-if="p.logo">
                                        <img t-att-src="'data:image/png;base64,' + p.logo.decode('utf-8')"
                                             class="imprenta-logo-img" alt="Imprenta"/>
                                    </t>
                                    <strong t-out="p.name or ''"/>
                                </div>
                                <div class="imprenta-details">
                                    <t t-if="p.legal_name">
                                        <t t-out="p.legal_name"/>
                                        <t t-if="p.phone"> - Cel. <t t-out="p.phone"/></t>
                                        <br/>
                                    </t>
                                    <t t-if="p.vat">C.U.I.T. <t t-out="p.vat"/> - </t>
                                    <t t-if="p.gross_income">Ing. Brutos <t t-out="p.gross_income"/> - </t>
                                    <t t-if="p.hab_mun">Hab. Mun. Nº <t t-out="p.hab_mun"/> - </t>
                                    <t t-if="p.print_date">
                                        Imp.: <t t-out="p.print_date.strftime('%d %B %Y')"/>
                                    </t>
                                    <t t-if="book.sequence_start and book.sequence_end">
                                        - Del Nº <t t-out="book.sequence_start"/>
                                        al <t t-out="book.sequence_end"/>
                                    </t>
                                </div>
                                <t t-if="p.copies_desc">
                                    <div class="imprenta-copies" t-out="p.copies_desc"/>
                                </t>
                            </t>
                        </td>
                        <!-- CAI data (right) -->
                        <td class="remito-cai-cell">
                            <t t-if="book.l10n_ar_cai">
                                <div class="remito-cai-number">
                                    C.A.I. Nº <strong t-out="book.l10n_ar_cai"/>
                                </div>
                            </t>
                            <t t-if="book.l10n_ar_cai_due">
                                <div class="remito-cai-due">
                                    VTO.
                                    <t t-out="book.l10n_ar_cai_due.strftime('%d/%m/%Y')"/>
                                </div>
                            </t>
                            <t t-if="page_total > 1">
                                <div class="remito-page-num">
                                    Hoja <t t-out="page_num"/> de <t t-out="page_total"/>
                                </div>
                            </t>
                        </td>
                    </tr>
                </table>

            </div><!-- .page -->
        </t><!-- foreach page -->
    </t><!-- foreach doc -->
</template>
</odoo>
