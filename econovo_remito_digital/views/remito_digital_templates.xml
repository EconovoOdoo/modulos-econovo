<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_remito_digital_document">
    <t t-call="web.html_container">
    <t t-foreach="docs" t-as="o">
        <t t-set="book" t-value="o.book_id"/>
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="partner" t-value="o.partner_id"/>
        <t t-set="pages" t-value="o._get_remito_digital_grouped_pages()"/>
        <t t-set="has_lots" t-value="any(bool(line['lots_text']) for page in pages for line in page)"/>
        <t t-foreach="pages" t-as="page_lines">
            <t t-set="page_num" t-value="page_lines_index + 1"/>
            <t t-set="page_total" t-value="len(pages)"/>
            <!-- Full-height table: row1=header / row2=content(flex) / row3=footer -->
            <table class="remito-page-table"
                   t-att-style="'' if page_lines_last else 'page-break-after: always;'"
                   t-att-data-oe-model="o._name"
                   t-att-data-oe-id="o.id"
                   t-att-data-oe-lang="o.env.context.get('lang')">

                <!-- ============================================================ -->
                <!-- ROW 1: HEADER                                                 -->
                <!-- ============================================================ -->
                <tr class="remito-header-row">
                <td class="remito-header-td">

                <!-- ============================================================ -->
                <!-- HEADER                                                        -->
                <!-- ============================================================ -->
                <table class="remito-header-table">
                    <tr>
                        <!-- Left: company info -->
                        <td class="remito-company-cell">
                            <div class="remito-company-top">
                                <div class="remito-company-logo">
                                    <img t-if="company.logo"
                                         t-att-src="'data:image/png;base64,' + company.logo.decode('utf-8')"
                                         class="company-logo-img" alt="Logo"/>
                                </div>
                                <div class="remito-company-info">
                                    <div class="company-address" t-out="company.street or ''"/>
                                    <div class="company-address"
                                         t-out="(company.city or '') + (', ' + company.zip if company.zip else '')"/>
                                    <div class="company-address" t-out="company.website or ''"/>
                                    <div class="company-address" t-out="company.email or ''"/>
                                </div>
                            </div>

                            <div class="remito-company-secondary-line">
                                <div class="remito-company-secondary">
                                    <t t-out="company.partner_id.name or ''"/>
                                </div>
                                <div class="remito-phone" t-if="company.phone">
                                    &#9990; <t t-out="company.phone"/>
                                </div>
                            </div>

                            <div class="remito-iva-type">
                                I.V.A. RESPONSABLE INSCRIPTO
                            </div>
                        </td>

                        <!-- Center: R badge + number block -->
                        <td class="remito-badge-cell">
                            <div class="remito-r-badge">R</div>
                            <div class="remito-codigo">
                                Código Nº 91<br/>
                                DOCUMENTO<br/>
                                NO VALIDO<br/>
                                COMO<br/>
                                FACTURA
                            </div>
                        </td>

                        <!-- Right: voucher number + date -->
                        <td class="remito-number-cell">
                            <table class="remito-date-table">
                                <tr>
                                    <th class="remito-th-green remito-th-full">
                                        REMITO Nº <t t-out="o.voucher_ids and o.voucher_ids[0].name or '_______________'"/>
                                    </th>
                                </tr>
                                <tr>
                                    <td class="remito-td-barcode-full">
                                        <div t-field="o.name"
                                             t-options="{'widget': 'barcode', 'width': 600, 'height': 75, 'img_style': 'display:block;margin:0 auto;max-width:95%;height:9mm;'}">
                                            <div t-out="o.name"/>
                                        </div>
                                        <div class="remito-picking-name-under-barcode" t-out="o.name"/>
                                    </td>
                                </tr>
                            </table>
                            <!-- Fiscal company data below REMITO/FECHA -->
                            <table class="remito-fiscal-table">
                                <tr>
                                    <td>C.U.I.T.: <strong t-out="company.vat or ''"/></td>
                                    <td>Ing. Brutos C.M. <t t-out="company.l10n_ar_gross_income_number or ''"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        Inicio Actividad
                                        <t t-if="company.l10n_ar_afip_start_date"
                                           t-out="company.l10n_ar_afip_start_date.strftime('%d/%m/%Y')"/>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- ============================================================ -->
                <!-- DESTINATARIO                                                  -->
                <!-- ============================================================ -->
                <table class="remito-recipient-table">
                    <tr>
                        <!-- Left column -->
                        <td class="remito-recipient-left">
                            <div class="remito-field-row">
                                <span class="remito-label">SEÑOR/ES:</span>
                                <span class="remito-value" t-out="partner.name or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">DIRECCIÓN:</span>
                                <span class="remito-value" t-out="partner.street or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">CIUDAD:</span>
                                <span class="remito-value" t-out="partner.city or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">C.P.:</span>
                                <span class="remito-value" t-out="partner.zip or ''"/>
                            </div>
                        </td>
                        <!-- Right column -->
                        <td class="remito-recipient-right">
                            <div class="remito-field-row">
                                <span class="remito-label">Cuenta Nº:</span>
                                <span class="remito-value" t-out="partner.ref or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">C.U.I.T.:</span>
                                <span class="remito-value" t-out="partner.vat or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">Condición:</span>
                                <span class="remito-value"
                                      t-out="partner.l10n_ar_afip_responsibility_type_id.name or ''"/>
                            </div>
                            <div class="remito-field-row">
                                <span class="remito-label">Ing. Brutos:</span>
                                <span class="remito-value"
                                      t-out="partner.l10n_ar_gross_income_number or ''"/>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- ============================================================ -->
                <!-- DATOS COMERCIALES / PICKING / TRANSPORTE                     -->
                <!-- ============================================================ -->
                <t t-set="invoice_names" t-value="', '.join(o.invoice_ids.mapped('name'))"/>
                <t t-set="customer_ref" t-value="o.sudo().sale_id.client_order_ref or ''"/>
                <t t-set="source_picking_ref"
                   t-value="(o.backorder_id and o.backorder_id.name) or (o.return_id and o.return_id.name) or (o.origin or '')"/>
                <table class="remito-transport-table">
                    <!-- Fila 1: FACTURA | OV | FECHA -->
                    <tr>
                        <td class="remito-transport-cell">
                            <span class="remito-label">FACTURA Nº:</span>
                            <span class="remito-value" t-out="invoice_names or ''"/>
                        </td>
                        <td class="remito-oc-cell">
                            <span class="remito-label">ORDEN DE VENTA Nº:</span>
                            <span class="remito-value" t-out="o.sale_id.name or o.origin or ''"/>
                        </td>
                        <td class="remito-fecha-cell">
                            <span class="remito-label">FECHA:</span>
                            <span class="remito-value" t-out="o.date_done and o.date_done.strftime('%d/%m/%Y') or ''"/>
                        </td>
                    </tr>
                    <!-- Fila 2: SOLICITADO POR | PICKING EMISOR | ORIGEN -->
                    <tr>
                        <td class="remito-transport-cell">
                            <span class="remito-label">SOLICITADO POR:</span>
                            <span class="remito-value" t-out="o.user_id.name or ''"/>
                        </td>
                        <td class="remito-oc-cell">
                            <span class="remito-label">REF. CLIENTE:</span>
                            <span class="remito-value" t-out="customer_ref"/>
                        </td>
                        <td class="remito-fecha-cell">
                            <span class="remito-label">ORIGEN:</span>
                            <span class="remito-value" t-out="source_picking_ref"/>
                        </td>
                    </tr>
                    <!-- Fila 3: TRANSPORTE (colspan) -->
                    <tr>
                        <td colspan="3" class="remito-transport-full-cell">
                            <span class="remito-label">TRANSPORTE:</span>
                            <span class="remito-value"></span>
                        </td>
                    </tr>
                </table>

                </td>
                </tr><!-- end remito-header-row -->

                <!-- ============================================================ -->
                <!-- ROW 2: CONTENT — expands to fill remaining space             -->
                <!-- ============================================================ -->
                <tr class="remito-content-row">
                <td class="remito-content-td">

                <!-- ============================================================ -->
                <!-- TABLA DE PRODUCTOS                                            -->
                <!-- ============================================================ -->
                <table class="remito-products-table">
                    <thead>
                        <tr>
                            <th class="col-code">CÓDIGO</th>
                            <th class="col-qty">CANTIDAD</th>
                            <th class="col-detail">DETALLE</th>
                            <th class="col-lots" t-if="has_lots">Serie/Lote</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="page_lines" t-as="line">
                            <td class="col-code" t-out="line['code']"/>
                            <td class="col-qty">
                                <t t-out="'%.2f' % line['qty_total']"/>
                                <t t-if="line['uom']">
                                    <small> <t t-out="line['uom']"/></small>
                                </t>
                            </td>
                            <td class="col-detail" t-out="line['product'].name or ''"/>
                            <td class="col-lots" t-if="has_lots" t-raw="line['lots_text']"/>
                        </tr>
                    </tbody>
                </table>

                <!-- ============================================================ -->
                <!-- OBSERVATIONS (solo en última página)                         -->
                <!-- ============================================================ -->
                <t t-if="page_lines_last and o._has_remito_observations()">
                    <div class="remito-observations">
                        <div class="remito-observations-header">Observaciones</div>
                        <div class="remito-observations-body" t-raw="o.observations"/>
                    </div>
                </t>

                </td>
                </tr><!-- end remito-content-row -->

                <!-- ============================================================ -->
                <!-- ROW 3: FOOTER — always at bottom of page                     -->
                <!-- ============================================================ -->
                <tr class="remito-footer-row">
                <td class="remito-footer-td">

                <!-- ============================================================ -->
                <!-- FOOTER: TRASLADO + FIRMA                                      -->
                <!-- ============================================================ -->
                <t t-set="dest_picking_ids" t-value="o.move_ids.mapped('move_dest_ids').mapped('picking_id')"/>
                <t t-set="dest_picking" t-value="dest_picking_ids[0] if dest_picking_ids else False"/>
                <table class="remito-footer-table">
                    <tr>
                        <td class="remito-traslado-cell">
                            <t t-if="book.is_interwarehouse_company_transfer">
                                <div class="remito-traslado-text">
                                    TRASLADO DE MERCADERIA ENTRE SUCURSALES
                                </div>
                            </t>
                            <!-- Footer barcode:
                                 - Interwarehouse: barcode of the DESTINATION picking
                                   (the one the other branch scans to receive from transit)
                                 - Otherwise: barcode of the current picking (o.name) -->
                            <t t-if="book.is_interwarehouse_company_transfer and dest_picking">
                                <div class="remito-picking-barcode-cell">
                                    <div class="remito-picking-barcode-label">Recepción en destino:</div>
                                    <div t-field="dest_picking.name"
                                         t-options="{'widget': 'barcode', 'width': 600, 'height': 75, 'img_style': 'display:block;margin:0 auto;max-width:90%;height:9mm;'}">
                                        <div class="remito-picking-barcode-fallback" t-out="dest_picking.name"/>
                                    </div>
                                    <div class="remito-picking-barcode-text" t-out="dest_picking.name"/>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="remito-picking-barcode-cell">
                                    <div t-field="o.name"
                                         t-options="{'widget': 'barcode', 'width': 600, 'height': 75, 'img_style': 'display:block;margin:0 auto;max-width:90%;height:9mm;'}">
                                        <div class="remito-picking-barcode-fallback" t-out="o.name"/>
                                    </div>
                                    <div class="remito-picking-barcode-text" t-out="o.name"/>
                                </div>
                            </t>
                        </td>
                        <td class="remito-firma-cell">
                            <div class="remito-conformidad">Conforme Recepción</div>
                            <div class="remito-fecha-firma">
                                Fecha ___________________________
                            </div>
                            <div class="remito-firma-sello">
                                ___________________________________<br/>
                                Firma y Sello del Destinatario
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- ============================================================ -->
                <!-- BOTTOM: IMPRENTA + CAI                                        -->
                <!-- ============================================================ -->
                <table class="remito-imprenta-table">
                    <tr>
                        <!-- Printer data (left) -->
                        <td class="remito-imprenta-cell">
                            <t t-if="book.printer_id">
                                <t t-set="p" t-value="book.printer_id"/>
                                <div class="imprenta-wrapper">
                                    <t t-if="p.logo">
                                        <div class="imprenta-logo-wrap">
                                            <img t-att-src="'data:image/png;base64,' + p.logo.decode('utf-8')"
                                                 class="imprenta-logo-img" alt="Imprenta"/>
                                        </div>
                                    </t>
                                    <div class="imprenta-info">
                                        <div class="imprenta-line1">
                                            <t t-if="not p.logo"><strong t-out="p.name or ''"/> - </t>
                                            <t t-if="p.legal_name"><t t-out="p.legal_name"/></t>
                                            <t t-if="p.phone"> - Cel. <t t-out="p.phone"/></t>
                                            <t t-if="p.vat"> - C.U.I.T. <t t-out="p.vat"/></t>
                                            <t t-if="p.gross_income"> - Ing. Brutos <t t-out="p.gross_income"/></t>
                                        </div>
                                        <div class="imprenta-line2">
                                            <t t-if="p.hab_mun">Inscripta Reg. Fiscal de Imprenta - Hab. Mun. Nº <t t-out="p.hab_mun"/></t>
                                            <t t-if="p.print_date"> - Imp.: <t t-out="p.print_date.strftime('%d %B %Y')"/></t>
                                            <t t-if="book.sequence_start and book.sequence_end">
                                                - Del Nº <t t-out="book.sequence_start"/> al <t t-out="book.sequence_end"/>
                                            </t>
                                        </div>

                                    </div>
                                </div>
                            </t>
                        </td>
                        <!-- CAI data (right) -->
                        <td class="remito-cai-cell">
                            <t t-if="book.l10n_ar_cai">
                                <div class="remito-cai-number">
                                    C.A.I. Nº <strong t-out="book.l10n_ar_cai"/>
                                </div>
                            </t>
                            <t t-if="book.l10n_ar_cai_due">
                                <div class="remito-cai-due">
                                    VTO.
                                    <t t-out="book.l10n_ar_cai_due.strftime('%d/%m/%Y')"/>
                                </div>
                            </t>
                            <t t-if="page_total > 1">
                                <div class="remito-page-num">
                                    Hoja <t t-out="page_num"/> de <t t-out="page_total"/>
                                </div>
                            </t>
                        </td>
                    </tr>
                </table>

                </td>
                </tr><!-- end remito-footer-row -->

            </table><!-- end remito-page-table -->

        </t><!-- foreach page -->
    </t><!-- foreach doc -->
    </t><!-- web.html_container -->
</template>
</odoo>
