<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_completion_status" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.completion.status</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='barcode_setting_container']" position="inside">
                <setting id="show_completion_status_setting" 
                         string="Show Completion Status" 
                         help="Show visual feedback (green/red) indicating if counted quantity matches expected"
                         company_dependent="1">
                    <field name="show_completion_status"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
