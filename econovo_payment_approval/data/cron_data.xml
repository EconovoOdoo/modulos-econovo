<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": the cron is user-configurable after install. -->
    <data noupdate="1">

        <record id="ir_cron_alert_missing_substitutions" model="ir.cron">
            <field name="name">Econovo: Alertar aprobadores sin sustitución configurada</field>
            <field name="model_id" ref="model_econovo_approval_substitution"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_missing_substitutions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">1</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
