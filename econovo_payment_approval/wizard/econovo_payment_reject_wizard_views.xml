<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_econovo_payment_reject_wizard_form" model="ir.ui.view">
        <field name="name">econovo.payment.reject.wizard.form</field>
        <field name="model">econovo.payment.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Pago">
                <field name="payment_id" invisible="1"/>
                <group col="1">
                    <field name="reason"
                           placeholder="Describe el motivo del rechazo. Esta nota quedará registrada en el chatter del pago."
                           widget="text"
                           nolabel="1"
                           style="min-height: 100px;"/>
                </group>
                <footer>
                    <button name="action_confirm_rejection"
                            string="Confirmar Rechazo"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_econovo_move_reject_wizard_form" model="ir.ui.view">
        <field name="name">econovo.move.reject.wizard.form</field>
        <field name="model">econovo.move.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Asiento">
                <field name="move_id" invisible="1"/>
                <group col="1">
                    <field name="reason"
                           placeholder="Describe el motivo del rechazo. Esta nota quedará registrada en el chatter del asiento."
                           widget="text"
                           nolabel="1"
                           style="min-height: 100px;"/>
                </group>
                <footer>
                    <button name="action_confirm_rejection"
                            string="Confirmar Rechazo"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_econovo_batch_reject_wizard_form" model="ir.ui.view">
        <field name="name">econovo.batch.reject.wizard.form</field>
        <field name="model">econovo.batch.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Lote de Pagos">
                <field name="batch_id" invisible="1"/>
                <group col="1">
                    <field name="reason"
                           placeholder="Describe el motivo del rechazo. Esta nota quedará registrada en el chatter del lote y se notificará a los responsables de cada pago."
                           widget="text"
                           nolabel="1"
                           style="min-height: 100px;"/>
                </group>
                <footer>
                    <button name="action_confirm_rejection"
                            string="Confirmar Rechazo"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
