<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Menu: Contabilidad > Configuración > Reglas de Aprobación
         Covers both account.payment and account.move rules.
         ================================================================ -->
    <record id="action_econovo_approval_rule" model="ir.actions.act_window">
        <field name="name">Reglas de Aprobación</field>
        <field name="res_model">econovo.approval.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay reglas de aprobación configuradas.
            </p>
            <p>
                Crea reglas para enrutar pagos o asientos al aprobador correcto
                según dominio, monto, empresa o moneda.
            </p>
        </field>
    </record>

    <record id="view_econovo_approval_rule_tree" model="ir.ui.view">
        <field name="name">econovo.approval.rule.tree</field>
        <field name="model">econovo.approval.rule</field>
        <field name="arch" type="xml">
            <tree string="Reglas de Aprobación">
                <field name="sequence" widget="handle"/>
                <field name="target_model"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_econovo_approval_rule_form" model="ir.ui.view">
        <field name="name">econovo.approval.rule.form</field>
        <field name="model">econovo.approval.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de Aprobación">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="target_model"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Dominio de Aplicación">
                        <field name="domain"
                               widget="domain"
                               options="{'model_field': 'target_model'}"
                               nolabel="1"/>
                    </group>
                    <group string="Notas Internas">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_econovo_approval_rule_search" model="ir.ui.view">
        <field name="name">econovo.approval.rule.search</field>
        <field name="model">econovo.approval.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <filter name="payments" string="Pagos"
                        domain="[('target_model', '=', 'account.payment')]"/>
                <filter name="entries" string="Asientos"
                        domain="[('target_model', '=', 'account.move')]"/>
                <separator/>
                <filter name="inactive" string="Inactivas"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_target" string="Aplica a"
                            context="{'group_by': 'target_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_econovo_approval_rule"
              name="Reglas de Aprobación"
              parent="account.menu_finance_configuration"
              action="action_econovo_approval_rule"
              groups="base.group_system"
              sequence="99"/>
</odoo>
