<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_econovo_move_approval_rule_tree" model="ir.ui.view">
        <field name="name">econovo.move.approval.rule.tree</field>
        <field name="model">econovo.move.approval.rule</field>
        <field name="arch" type="xml">
            <tree string="Reglas de Aprobación de Asientos">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="domain"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_econovo_move_approval_rule_form" model="ir.ui.view">
        <field name="name">econovo.move.approval.rule.form</field>
        <field name="model">econovo.move.approval.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de Aprobación de Asientos">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group string="Criterio (Dominio)">
                        <field name="domain" nolabel="1" widget="domain"
                               options="{'model': 'account.move'}"/>
                    </group>
                    <group string="Notas">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_econovo_move_approval_rule" model="ir.actions.act_window">
        <field name="name">Reglas de Aprobación de Asientos</field>
        <field name="res_model">econovo.move.approval.rule</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_econovo_move_approval_rule"
              name="Reglas de Aprobación de Asientos"
              parent="account.menu_finance_configuration"
              action="action_econovo_move_approval_rule"
              sequence="101"/>
</odoo>
