<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Extend account.payment form view with:
          1. "Aprobar Pago" + "Rechazar Pago" buttons (approvers group, posted + pending).
          2. Priority stars (0=Normal … 3=Urgente).
          3. "Aprobado por" read-only field.
    -->
    <record id="view_account_payment_form_inherit_approval" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.econovo_payment_approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Approve / Reject buttons before the state statusbar -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_approve"
                        string="Aprobar Pago"
                        type="object"
                        class="btn-success"
                        groups="econovo_payment_approval.grp_aprobadores_pago"
                        invisible="state != 'posted' or not has_pending_approval_activity"/>
                <button name="action_open_reject_wizard"
                        string="Rechazar Pago"
                        type="object"
                        class="btn-danger"
                        groups="econovo_payment_approval.grp_aprobadores_pago"
                        invisible="state != 'posted' or not has_pending_approval_activity"/>
            </xpath>
            <!-- Priority stars + hidden computed field before first group -->
            <xpath expr="//sheet/group[1]" position="before">
                <field name="has_pending_approval_activity" invisible="1"/>
                <field name="priority" widget="priority"/>
            </xpath>
            <!-- Aprobado por — appended inside the second column of the first group -->
            <xpath expr="//sheet/group[1]/group[2]" position="inside">
                <field name="approved_by_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!--
        Extend account.payment list view to show priority, approved_by_id columns
        and add Aprobar/Rechazar buttons directly in the list header.
    -->
    <record id="view_account_payment_tree_inherit_approval" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.econovo_payment_approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <!-- Add approve/reject buttons alongside the native "Confirm" header button -->
            <xpath expr="//header/button[@name='action_post']" position="after">
                <button name="action_approve"
                        string="Aprobar Pago"
                        type="object"
                        class="btn-success"
                        groups="econovo_payment_approval.grp_aprobadores_pago"/>
                <button name="action_open_reject_wizard"
                        string="Rechazar Pago"
                        type="object"
                        class="btn-danger"
                        groups="econovo_payment_approval.grp_aprobadores_pago"/>
            </xpath>
            <xpath expr="//tree/field[@name='name']" position="before">
                <field name="priority" widget="priority" optional="show"/>
            </xpath>
            <xpath expr="//tree/field[@name='state']" position="after">
                <field name="approved_by_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
