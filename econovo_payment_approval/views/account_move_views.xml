<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Extend account.move form view (journal entries only) with:
          1. "Aprobar Asiento" + "Rechazar Asiento" buttons
             (approvers group, posted, move_type='entry', pending activity).
          2. Priority stars (0=Normal … 3=Urgente).
          3. "Aprobado por" read-only field.
    -->
    <record id="view_account_move_form_inherit_approval" model="ir.ui.view">
        <field name="name">account.move.form.inherit.econovo_payment_approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Approve / Reject buttons before the state statusbar -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_approve"
                        string="Aprobar Asiento"
                        type="object"
                        class="btn-success"
                        groups="econovo_payment_approval.grp_aprobadores_pago"
                        invisible="state != 'posted' or move_type != 'entry' or not has_pending_approval_activity"/>
                <button name="action_open_reject_wizard_entry"
                        string="Rechazar Asiento"
                        type="object"
                        class="btn-danger"
                        groups="econovo_payment_approval.grp_aprobadores_pago"
                        invisible="state != 'posted' or move_type != 'entry' or not has_pending_approval_activity"/>
            </xpath>
            <!-- Priority stars + hidden computed field before first group -->
            <xpath expr="//sheet/group[1]" position="before">
                <field name="has_pending_approval_activity" invisible="1"/>
                <field name="priority"
                       widget="priority"
                       invisible="move_type != 'entry'"/>
            </xpath>
            <!-- Aprobado por — appended inside the second column of the first group -->
            <xpath expr="//sheet/group[1]/group[2]" position="inside">
                <field name="approved_by_id"
                       readonly="1"
                       invisible="move_type != 'entry'"/>
            </xpath>
        </field>
    </record>

    <!--
        Extend account.move list view to add priority, approved_by_id columns
        and Aprobar/Rechazar buttons in the list header.
        account.move's native tree has no <header>, so we inject one.
    -->
    <record id="view_account_move_tree_inherit_approval" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.econovo_payment_approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <!-- Inject a header block with approve/reject buttons -->
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="action_approve"
                            string="Aprobar Asiento"
                            type="object"
                            class="btn-success"
                            groups="econovo_payment_approval.grp_aprobadores_pago"/>
                    <button name="action_open_reject_wizard_entry"
                            string="Rechazar Asiento"
                            type="object"
                            class="btn-danger"
                            groups="econovo_payment_approval.grp_aprobadores_pago"/>
                </header>
            </xpath>
            <xpath expr="//tree/field[@name='name']" position="before">
                <field name="priority" widget="priority" optional="show"/>
            </xpath>
            <xpath expr="//tree/field[@name='state']" position="after">
                <field name="approved_by_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!--
        Server action kept for backward compatibility but hidden from UI.
        The header buttons above are the primary UX entry point.
    -->
    <record id="action_approve_moves_server" model="ir.actions.server">
        <field name="name">Aprobar Asiento</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('econovo_payment_approval.grp_aprobadores_pago'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_approve()</field>
    </record>
</odoo>
