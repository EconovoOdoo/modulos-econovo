<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Server Action: Create Putaway Rule from Quants -->
    <!-- Appears in the Actions menu (gear icon) when selecting quants -->
    <record id="action_stock_quant_putaway" model="ir.actions.server">
        <field name="name">Create Putaway Rule</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="binding_model_id" ref="stock.model_stock_quant"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('econovo_stock_putaway_from_quant.group_stock_putaway_from_quant'))]"/>
        <field name="state">code</field>
        <field name="code">
# Execute action - validation is done inside action_open_putaway()
if records:
    action = records.action_open_putaway()
        </field>
    </record>

</odoo>
