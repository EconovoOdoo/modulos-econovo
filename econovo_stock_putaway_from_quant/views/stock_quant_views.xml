<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit view_stock_quant_tree_editable to add putaway button -->
    <record id="view_stock_quant_tree_editable_putaway" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.inherit.putaway</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_putaway" type="object"
                        string="Create Putaway Rule"
                        groups="econovo_stock_putaway_from_quant.group_stock_putaway_from_quant"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit view_stock_quant_tree (read-only view) to add putaway button -->
    <record id="view_stock_quant_tree_putaway" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit.putaway</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="action_open_putaway" type="object"
                            string="Create Putaway Rule"
                            groups="econovo_stock_putaway_from_quant.group_stock_putaway_from_quant"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Inherit view_stock_quant_tree_inventory_editable to add putaway button -->
    <record id="view_stock_quant_tree_inventory_editable_putaway" model="ir.ui.view">
        <field name="name">stock.quant.tree.inventory.editable.inherit.putaway</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_putaway" type="object"
                        string="Create Putaway Rule"
                        groups="econovo_stock_putaway_from_quant.group_stock_putaway_from_quant"/>
            </xpath>
        </field>
    </record>
</odoo>
