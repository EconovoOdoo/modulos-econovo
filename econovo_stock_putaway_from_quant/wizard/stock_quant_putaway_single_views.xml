<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_quant_putaway_single_view_form" model="ir.ui.view">
        <field name="name">stock.quant.putaway.single.view.form</field>
        <field name="model">stock.quant.putaway.single</field>
        <field name="arch" type="xml">
            <form string="Create Putaway Rule">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group string="Product Information">
                            <field name="product_id"/>
                            <field name="current_location_id"/>
                            <field name="quantity"/>
                            <field name="company_id" invisible="1"/>
                            <field name="quant_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Existing Rules" name="existing_rules">
                            <field name="has_existing_rules" invisible="1"/>
                            <field name="has_rule_for_current_location" invisible="1"/>
                            
                            <div class="alert alert-info" role="alert"
                                 invisible="has_existing_rules">
                                <strong>No existing putaway rules</strong> for this product.
                            </div>
                            
                            <div class="alert alert-success" role="alert"
                                 invisible="not has_rule_for_current_location">
                                <strong>A rule already exists</strong> that points to the current location.
                            </div>

                            <field name="existing_rule_ids" nolabel="1"
                                   invisible="not has_existing_rules">
                                <tree string="Existing Putaway Rules" editable="bottom" create="0" delete="0">
                                    <field name="product_id" column_invisible="1"/>
                                    <field name="location_in_id"/>
                                    <field name="location_out_id"/>
                                    <field name="sequence"/>
                                    <field name="is_current_location" column_invisible="1"/>
                                    <field name="putaway_rule_id" column_invisible="1"/>
                                    <button name="action_delete_rule" type="object"
                                            string="Delete" icon="fa-trash"
                                            class="btn-link text-danger"
                                            confirm="Are you sure you want to delete this putaway rule?"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Create New Rule" name="new_rule">
                            <group>
                                <group string="Source">
                                    <field name="location_in_id" 
                                           options="{'no_create': True}"/>
                                </group>
                                <group string="Destination">
                                    <field name="use_current_location" widget="boolean_toggle"/>
                                    <field name="location_out_id" 
                                           invisible="use_current_location"
                                           required="not use_current_location"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                            <group>
                                <group string="Options">
                                    <field name="sequence"/>
                                    <field name="replace_existing" widget="boolean_toggle"
                                           invisible="not has_existing_rules"/>
                                </group>
                            </group>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not replace_existing">
                                <strong>Warning:</strong> Existing rules for this product 
                                in the selected source location will be deactivated.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_create_rule" string="Create Rule" 
                            type="object" class="btn-primary"/>
                    <button name="action_view_existing_rules" string="View All Rules" 
                            type="object" class="btn-secondary"
                            invisible="not has_existing_rules"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_quant_putaway_single_action" model="ir.actions.act_window">
        <field name="name">Create Putaway Rule</field>
        <field name="res_model">stock.quant.putaway.single</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
