<t t-name="econovo_dymo_labels.report_producttemplatelabel_dymo">
    <t t-call="web.basic_layout">
        <style type="text/css">
            @page {
                size: 100mm 70mm;
                margin: 2mm;
            }

            .main-container {
                width: 100%;
                height: 100%;
                background-color: white;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .product-container {
                width: 100%;
                height: 79mm;
                background-color: white;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .content-container {
                width: 100%;
                height: 100%;
                background-color: white;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-content: space-around;
                gap: 5px;
            }

            .barcode-section {
                width: 100%;
                height: 47%;
                background-color: white;
                display: flex;
                justify-content: center;
                align-items: center;
                position: relative;
            }

            .logo-container {
                position: absolute;
                top: -3px;
                left: 0;
                text-align: center;
                height: 25%;
            }

            .logo-img {
                height: 100%;
                background-color: white;
                padding: 1px;
            }

            .barcode-wrapper {
                padding: 0;
                width: 100%;
                height: 100%;
            }

            .barcode-number {
                position: absolute;
                top: -1px;
                right: 0;
                text-align: right;
            }

            .barcode-number small {
                background-color: white;
                padding: 1px;
                display: block;
            }

            .code-section {
                width: 100%;
                text-align: center;
                color: white;
                background-color: black;
                font-size: 24px;
                font-weight: bold;
                line-height: 1.1;
            }

            .code-locations {
                font-size: 9px;
                text-align: right;
                display: block;
                margin: 0px;
                line-height: 0.8;
            }

            .name-section {
                width: 100%;
                text-align: center;
                background-color: white;
                word-wrap: break-word;
                word-break: break-word;
                font-size: 24px;
                line-height: 1.2;
                overflow: hidden;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                text-overflow: ellipsis;
            }

            span {
                line-height: 1;
            }
        </style>

        <t t-foreach="product_ids" t-as="prod_id">
            <div class="main-container">
                <t t-set="product" t-value="env['product.template'].browse(prod_id)"/>
                <div class="product-container">
                    <div class="content-container">
                        <div class="barcode-section">
                            <div class="logo-container">
                                <img t-att-src="'/web/image/res.company/%s/logo' % env.company.id" class="logo-img"/>
                            </div>
                            <t t-if="product.barcode">
                                <div class="barcode-wrapper">
                                    <span t-field="product.barcode"
                                          t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'width:100%;height:100%'}"/>
                                </div>

                                <t t-set="quants" t-value="env['stock.quant'].search([('product_id', '=', product.product_variant_id.id), ('quantity', '>', 0)])"/>
                                <div class="barcode-number">
                                    <small t-out="product.barcode"/>
                                    <t t-if="quants">
                                        <t t-foreach="quants" t-as="quant">
                                            <small class="code-locations" t-esc="quant.location_id.display_name"/>
                                        </t>
                                    </t>
                                </div>
                            </t>
                        </div>

                        <div class="code-section">
                            <span>[</span>
                            <span t-field="product.default_code"/>
                            <span>]</span>
                        </div>

                        <div class="name-section">
                            <span t-field="product.name"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </t>
</t>
