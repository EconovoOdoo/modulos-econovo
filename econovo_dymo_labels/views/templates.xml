<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_producttemplatelabel_dymo">
        <t t-call="web.basic_layout">
            <div class="o_dymo_label_report">
                <t t-foreach="docs" t-as="o">
                    <div class="main-container">
                        <div class="product-container">
                            <div class="content-container">
                                <div class="barcode-section">
                                    <div class="logo-container">
                                        <img t-att-src="'/web/image/res.company/%s/logo' % env.company.id" class="logo-img"/>
                                    </div>
                                    <t t-if="o.barcode">
                                        <div class="barcode-wrapper">
                                            <span t-field="o.barcode"
                                                  t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'width:100%;height:100%'}"/>
                                        </div>

                                        <div class="barcode-number">
                                            <small t-esc="o.barcode"/>
                                        </div>
                                    </t>
                                </div>

                                <div class="code-section">
                                    <span>[</span>
                                    <span t-field="o.default_code"/>
                                    <span>]</span>
                                </div>
                                <div class="name-section">
                                    <t t-set="product_name" t-value="o.name"/>
                                    <t t-if="len(product_name) > 84">
                                        <span t-esc="product_name[:83] + '…'"/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="product_name"/>
                                    </t>
                                </div>
                                
                                <!-- Source operation information (only when available from picking) -->
                                <t t-if="source_picking_info">
                                    <t t-foreach="source_picking_info" t-as="picking_name">
                                        <div class="barcode-section picking-barcode-section">
                                            <div class="barcode-wrapper">
                                                <span t-esc="picking_name"
                                                      t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'width:100%;height:100%'}"/>
                                            </div>
                                        </div>
                                        <div class="code-section picking-code-section">
                                            <span>[</span>
                                            <span t-esc="picking_name"/>
                                            <span>]</span>
                                        </div>
                                    </t>
                                </t>
                                
                                <!-- Storage location information (intelligent context-aware) -->
                                <t t-set="picking_location" t-value="picking_location_map.get(o.id)"/>
                                <t t-if="picking_location">
                                    <!-- Real location from picking context (more precise) -->
                                    <div class="location-text-section">
                                        <span t-esc="picking_location"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <!-- Fallback to traditional putaway rules filtered by user warehouse -->
                                    <t t-set="putaway_rules" t-value="env['report.econovo_dymo_labels.report_producttemplatelabel_dymo']._get_putaway_rules_by_user_warehouse(o.id)"/>
                                    <t t-if="putaway_rules">
                                        <t t-foreach="putaway_rules" t-as="rule">
                                            <div class="location-text-section">
                                                <span t-esc="rule.location_out_id.display_name"/>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div class="location-error-message">
                                            <span>(SIN REGLAS DE ALMACENAMIENTO DEFINIDAS)</span>
                                        </div>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="report_productlabel_dymo">
        <t t-call="web.html_container">
            <t t-set="barcode_size" t-value="'width:65mm;height:10mm'"/>
            <t t-set="table_style" t-value="'width:100%;height:32mm;'"/>
            <t t-set="padding_page" t-value="'padding: 2mm'"/>

            <t t-foreach="docs" t-as="product">
                <t t-call="econovo_dymo_labels.report_simple_label_dymo"/>
            </t>
        </t>
    </template>

    <template id="report_simple_label_dymo">
        <div class="o_label_sheet o_label_dymo" t-att-style="padding_page">
            <t t-set="quantity" t-value="product.quantity"/>
            <t t-foreach="quantity" t-as="prod_id">
                <t t-set="product" t-value="env['product.template'].browse(int(prod_id))"/>
                <div class="o_label_full" t-att-style="table_style">
                    <div class="text-start o_label_small_barcode">
                        <t t-if="product.barcode">
                            <div t-out="product.barcode" class="barcode-no-padding"
                                 t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': barcode_size}"/>
                            <div class="o_label_name barcode-label">
                                <span t-out="product.barcode"/>
                            </div>
                        </t>
                    </div>
                    <div class="o_label_name product-name-label">
                        <span t-field="product.name"/>
                    </div>
                    <div class="o_label_left_column">
                        <small class="text-nowrap" t-field="product.default_code"/>
                    </div>
                </div>
            </t>
        </div>
    </template>
</odoo>