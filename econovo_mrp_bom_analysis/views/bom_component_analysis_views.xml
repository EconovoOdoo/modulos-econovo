<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================
         TREE VIEW - Main Analysis View
         ==================================================================== -->
    <record id="bom_component_analysis_view_tree" model="ir.ui.view">
        <field name="name">bom.component.analysis.view.tree</field>
        <field name="model">bom.component.analysis</field>
        <field name="arch" type="xml">
            <tree decoration-info="is_subassembly"
                  decoration-bf="level == 0"
                  default_order="root_bom_id, level, sequence"
                  editable="bottom"
                  multi_edit="1">

                <!-- Hidden fields for ordering/grouping -->
                <field name="level" column_invisible="1"/>
                <field name="is_subassembly" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="child_bom_id" column_invisible="1"/>

                <!-- BOM RELATIONSHIP -->
                <field name="root_bom_id" string="Root BOM" readonly="1" optional="hide"/>

                <!-- IDENTIFICATION -->
                <field name="product_id" string="Component" readonly="1"/>
                <field name="source_bom_id" string="Source BOM" readonly="1" optional="show"/>
                <field name="bom_line_id" string="BOM Line" readonly="1" optional="hide"/>

                <!-- CATEGORY -->
                <field name="categ_name" string="Category" readonly="1" optional="show"/>
                <field name="categ_complete_name" string="Category Path" readonly="1" optional="hide"/>
                <field name="origin_type_id" string="Type" optional="show" readonly="1"
                       widget="badge"/>

                <!-- QUANTITIES -->
                <field name="bom_line_qty" string="BOM Qty"
                       readonly="not bom_line_id"/>
                <field name="quantity" string="Exploded Qty" readonly="1" optional="hide"/>
                <field name="uom_id" string="UoM" readonly="1"/>

                <!-- EDITABLE COSTS -->
                <field name="standard_price" string="Unit Cost"/>
                <field name="standard_price_usd" string="Cost USD" optional="show"/>

                <!-- TOTALS -->
                <field name="total_cost" string="Total Cost" sum="Total" readonly="1"/>
                <field name="total_cost_usd" string="Total USD" sum="Total USD"
                       optional="hide" readonly="1"/>

                <!-- ANALYSIS -->
                <field name="cost_share_global_pct" string="Global %"
                       widget="progressbar" optional="show" readonly="1"/>
                <field name="cost_share_local_pct" string="Local %"
                       widget="progressbar" optional="show" readonly="1"/>

                <!-- STOCK -->
                <field name="qty_available" string="On Hand" optional="show" readonly="1"/>
                <field name="free_qty" string="Free" optional="hide" readonly="1"/>

                <!-- SUPPLIER -->
                <field name="supplier_name" string="Supplier" optional="show" readonly="1"/>
                <field name="supplier_price" string="Supplier Price" optional="hide" readonly="1"/>

                <!-- WEIGHT -->
                <field name="weight" string="Unit Weight" optional="hide"/>
                <field name="total_weight" string="Total Weight" sum="Total Weight"
                       optional="hide" readonly="1"/>

                <!-- SALE PRICE -->
                <field name="list_price" string="Sale Price" optional="hide"/>

                <!-- ACTIONS -->
                <button name="action_open_product" type="object"
                        icon="fa-external-link" title="Open Product"/>
                <button name="action_open_bom_line" type="object"
                        icon="fa-list" title="Go to BOM Line"
                        invisible="not bom_line_id"/>
                <button name="action_open_child_bom" type="object"
                        icon="fa-sitemap" title="Open Component BOM"
                        invisible="not child_bom_id"/>
                <button name="action_refresh_from_product" type="object"
                        icon="fa-refresh" title="Refresh from Product"/>
            </tree>
        </field>
    </record>

    <!-- ====================================================================
         SEARCH VIEW - Filters and Groupings
         ==================================================================== -->
    <record id="bom_component_analysis_view_search" model="ir.ui.view">
        <field name="name">bom.component.analysis.view.search</field>
        <field name="model">bom.component.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="categ_name"/>
                <field name="categ_complete_name"/>
                <field name="supplier_name"/>

                <separator/>

                <filter name="subassemblies" string="Subassemblies"
                        domain="[('is_subassembly', '=', True)]"/>
                <filter name="base_components" string="Base Components"
                        domain="[('is_subassembly', '=', False)]"/>

                <separator/>

                <filter name="level_0" string="Level 1"
                        domain="[('level', '=', 0)]"/>
                <filter name="level_1" string="Level 2"
                        domain="[('level', '=', 1)]"/>
                <filter name="level_2_plus" string="Level 3+"
                        domain="[('level', '>=', 2)]"/>

                <separator/>

                <filter name="high_impact_global" string="High Global Impact (>5%)"
                        domain="[('cost_share_global_pct', '>', 5)]"/>
                <filter name="high_impact_local" string="High Local Impact (>20%)"
                        domain="[('cost_share_local_pct', '>', 20)]"/>

                <separator/>

                <!-- GROUPINGS -->
                <group expand="1" string="Group By">
                    <filter name="group_by_category" string="Category"
                            context="{'group_by': 'categ_complete_name'}"/>
                    <filter name="group_by_product" string="Product"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_origin" string="Origin Type"
                            context="{'group_by': 'origin_type_id'}"/>
                    <filter name="group_by_level" string="Level"
                            context="{'group_by': 'level'}"/>
                    <filter name="group_by_source_bom" string="Source BOM"
                            context="{'group_by': 'source_bom_id'}"/>
                    <filter name="group_by_parent" string="Parent Component"
                            context="{'group_by': 'parent_component_id'}"/>
                    <filter name="group_by_supplier" string="Supplier"
                            context="{'group_by': 'supplier_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ====================================================================
         PIVOT VIEW
         ==================================================================== -->
    <record id="bom_component_analysis_view_pivot" model="ir.ui.view">
        <field name="name">bom.component.analysis.view.pivot</field>
        <field name="model">bom.component.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Component Analysis">
                <field name="categ_complete_name" type="row"/>
                <field name="origin_type_id" type="col"/>
                <field name="total_cost" type="measure"/>
                <field name="quantity" type="measure"/>
                <field name="cost_share_global_pct" type="measure"/>
                <field name="cost_share_local_pct" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ====================================================================
         GRAPH VIEW - Pie Chart
         ==================================================================== -->
    <record id="bom_component_analysis_view_graph" model="ir.ui.view">
        <field name="name">bom.component.analysis.view.graph</field>
        <field name="model">bom.component.analysis</field>
        <field name="arch" type="xml">
            <graph string="Cost Distribution" type="pie">
                <field name="origin_type_id"/>
                <field name="total_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ====================================================================
         GRAPH VIEW - Bar Chart by Category
         ==================================================================== -->
    <record id="bom_component_analysis_view_graph_bar" model="ir.ui.view">
        <field name="name">bom.component.analysis.view.graph.bar</field>
        <field name="model">bom.component.analysis</field>
        <field name="arch" type="xml">
            <graph string="Cost by Category" type="bar">
                <field name="categ_complete_name"/>
                <field name="total_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ====================================================================
         ACTION
         ==================================================================== -->
    <record id="bom_component_analysis_action" model="ir.actions.act_window">
        <field name="name">Component Analysis</field>
        <field name="res_model">bom.component.analysis</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="search_view_id" ref="bom_component_analysis_view_search"/>
        <field name="context">{
            'search_default_group_by_category': 1,
            'search_default_group_by_product': 1,
            'search_default_group_by_source_bom': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No component analysis available
            </p>
            <p>
                Access from a Bill of Materials using the "Component Analysis" smart button.
            </p>
        </field>
    </record>

    <!-- ====================================================================
         MENU (under Manufacturing > Reporting)
         ==================================================================== -->
    <menuitem id="menu_bom_component_analysis"
              name="Component Analysis"
              parent="mrp.menu_mrp_reporting"
              action="bom_component_analysis_action"
              sequence="50"/>

</odoo>
