<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Product Category Form View -->
    <record id="product_category_form_view_inherit_origin_type" model="ir.ui.view">
        <field name="name">product.category.form.inherit.econovo.origin.type</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="origin_type_id"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Product Category Tree View -->
    <record id="product_category_tree_view_inherit_origin_type" model="ir.ui.view">
        <field name="name">product.category.tree.inherit.econovo.origin.type</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="origin_type_id" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
