<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!--
    Bridge extension for BomCostSummarySection.

    Inserts two "direct USD" columns (BoM Cost USD / Product Cost USD based on
    ``product.standard_price_usd``) BEFORE the existing exchange-rate USD
    columns in the Components section.

    The exchange-rate USD columns are now hidden unless developer mode is
    active (controlled via the ``showCostsUsd`` getter override in JS).

    Operations section: only gains empty placeholder cells so that column
    alignment is maintained across the shared table.

    Grand Total rows: each gains one direct-USD value cell and one empty
    placeholder cell to keep both cost groups aligned.
-->
<t t-inherit="econovo_mrp_bom_cost_summary.BomCostSummarySection"
   t-inherit-mode="extension">

    <!-- ============================================================ -->
    <!-- 1. COLGROUP – two new col elements for the direct-USD columns -->
    <!-- ============================================================ -->

    <xpath expr="//colgroup/col[@t-if='showCostsUsd'][1]" position="before">
        <!-- BoM Cost USD direct column -->
        <col t-if="showCostsUsdDirect" style="width: 10%;"/>
    </xpath>
    <xpath expr="//colgroup/col[@t-if='showCostsUsd'][2]" position="before">
        <!-- Product Cost USD direct column -->
        <col t-if="showCostsUsdDirect" style="width: 10%;"/>
    </xpath>

    <!-- ============================================================ -->
    <!-- 2. COMPONENTS THEAD – direct-USD column headers              -->
    <!-- ============================================================ -->

    <!-- BoM Cost USD direct header (before exchange-rate BoM Cost USD) -->
    <xpath expr="//thead[1]/tr/th[@t-if='showCostsUsd'][1]" position="before">
        <th t-if="showCostsUsdDirect" class="text-end">BoM Cost <t t-esc="secondaryCurrency.name"/>
            <i class="fa fa-info-circle text-muted ms-1"
               data-tooltip-template="econovo_mrp_bom_cost_summary.ColTooltip"
               t-att-data-tooltip-info="colTooltip('bom_cost_usd_direct')"/>&#8203;
        </th>
    </xpath>

    <!-- Product Cost USD direct header (before exchange-rate Product Cost USD) -->
    <xpath expr="//thead[1]/tr/th[@t-if='showCostsUsd'][2]" position="before">
        <th t-if="showCostsUsdDirect" class="text-end">Product Cost <t t-esc="secondaryCurrency.name"/>
            <i class="fa fa-info-circle text-muted ms-1"
               data-tooltip-template="econovo_mrp_bom_cost_summary.ColTooltip"
               t-att-data-tooltip-info="colTooltip('prod_cost_usd_direct')"/>&#8203;
        </th>
    </xpath>

    <!-- ============================================================ -->
    <!-- 3. COMPONENTS TBODY – category rows                          -->
    <!-- ============================================================ -->

    <xpath expr="//td[strong[@t-esc='fmtUsd(row.node.total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <strong t-esc="fmtUsdDirect(row.node.total_usd_direct)"/>
        </td>
    </xpath>
    <xpath expr="//td[strong[@t-esc='fmtUsd(row.node.prod_cost_total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <strong t-esc="fmtUsdDirect(row.node.prod_cost_total_usd_direct)"/>
        </td>
    </xpath>

    <!-- ============================================================ -->
    <!-- 4. COMPONENTS TBODY – product rows                           -->
    <!-- ============================================================ -->

    <xpath expr="//td[t[@t-esc='fmtUsd(row.prod.total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <t t-esc="fmtUsdDirect(row.prod.total_usd_direct)"/>
        </td>
    </xpath>
    <xpath expr="//td[t[@t-esc='fmtUsd(row.prod.prod_cost_total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <t t-esc="fmtUsdDirect(row.prod.prod_cost_total_usd_direct)"/>
        </td>
    </xpath>

    <!-- ============================================================ -->
    <!-- 5. COMPONENTS TBODY – usage rows                             -->
    <!-- ============================================================ -->

    <xpath expr="//td[t[@t-esc='fmtUsd(row.usage.total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <t t-esc="fmtUsdDirect(row.usage.total_usd_direct)"/>
        </td>
    </xpath>
    <xpath expr="//td[t[@t-esc='fmtUsd(row.usage.prod_cost_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <t t-esc="fmtUsdDirect(row.usage.prod_cost_usd_direct)"/>
        </td>
    </xpath>

    <!-- ============================================================ -->
    <!-- 6. COMPONENTS TBODY – Subtotal Components row                -->
    <!-- ============================================================ -->

    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.components_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <strong t-esc="fmtUsdDirect(data.totals.components_usd_direct)"/>
        </td>
    </xpath>
    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.prod_cost_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <strong t-esc="fmtUsdDirect(data.totals.prod_cost_usd_direct)"/>
        </td>
    </xpath>

    <!-- ============================================================ -->
    <!-- 7. OPERATIONS THEAD – empty placeholder headers              -->
    <!--    (operations have no direct-USD values; cols must be        -->
    <!--     present to keep consistent column alignment)             -->
    <!--    NOTE: //thead[2] does NOT work because each thead is       -->
    <!--    wrapped in its own <t t-if> and they are not siblings.    -->
    <!--    We identify the operations thead by its unique header text -->
    <!-- ============================================================ -->

    <!-- BoM Cost USD direct header in ops section (no Product Cost USD direct for ops) -->
    <xpath expr="//thead[tr/th[contains(normalize-space(.), 'Operations by Work Center')]]/tr/th[@t-if='showCostsUsd']" position="before">
        <th t-if="showCostsUsdDirect" class="text-end">BoM Cost <t t-esc="secondaryCurrency.name"/>
            <i class="fa fa-info-circle text-muted ms-1"
               data-tooltip-template="econovo_mrp_bom_cost_summary.ColTooltip"
               t-att-data-tooltip-info="colTooltip('ops_bom_cost_usd_direct')"/>&#8203;
        </th>
    </xpath>
    <!-- Empty Product Cost USD direct placeholder header (after the ops
         BoM Cost USD column, since Operations has no Product Cost column
         and showCostsUsd is the last th in that thead row) -->
    <xpath expr="//thead[tr/th[contains(normalize-space(.), 'Operations by Work Center')]]/tr/th[@t-if='showCostsUsd']" position="after">
        <th t-if="showCostsUsdDirect"/>
    </xpath>

    <!-- ============================================================ -->
    <!-- 8. OPERATIONS TBODY – Work Center rows (placeholder cells)   -->
    <!-- ============================================================ -->

    <xpath expr="//td[strong[@t-esc='fmtUsd(wc.total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end">
            <strong t-esc="fmtUsdDirect(wc.total_usd_direct)"/>
        </td>
    </xpath>
    <!-- empty placeholder keeps Product Cost USD direct column alignment for ops -->
    <xpath expr="//td[strong[@t-esc='fmtUsd(wc.total_usd)']]" position="after">
        <td t-if="showCostsUsdDirect"/>
    </xpath>

    <!-- ============================================================ -->
    <!-- 9. OPERATIONS TBODY – Operation rows (placeholder cells)     -->
    <!-- ============================================================ -->

    <xpath expr="//td[t[@t-esc='fmtUsd(op.total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <t t-esc="fmtUsdDirect(op.total_usd_direct)"/>
        </td>
    </xpath>
    <!-- empty placeholder keeps Product Cost USD direct column alignment for ops -->
    <xpath expr="//td[t[@t-esc='fmtUsd(op.total_usd)']]" position="after">
        <td t-if="showCostsUsdDirect"/>
    </xpath>

    <!-- ============================================================ -->
    <!-- 10. OPERATIONS TBODY – Subtotal Operations (placeholder)     -->
    <!-- ============================================================ -->

    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.operations_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end">
            <strong t-esc="fmtUsdDirect(data.totals.operations_usd_direct)"/>
        </td>
    </xpath>
    <!-- empty placeholder keeps Product Cost USD direct column alignment for ops -->
    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.operations_usd)']]" position="after">
        <td t-if="showCostsUsdDirect"/>
    </xpath>

    <!-- ============================================================ -->
    <!-- 11 & 12. GRAND TOTAL – "Total of BoM & Product" merged row -->
    <!--     Base module merged the old "TOTAL BOM COST" and          -->
    <!--     "TOTAL PRODUCT COST" rows into a single row that shows   -->
    <!--     all 4 cost columns.  No empty-placeholder XPaths needed. -->
    <!--     col layout: BoM ARS | [direct] | TC | Prod ARS | [direct] | TC -->
    <!-- ============================================================ -->

    <!-- Direct USD BoM Cost total (before exchange-rate total_usd) -->
    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end">
            <strong t-esc="fmtUsdDirect(data.totals.total_usd_direct)"/>
        </td>
    </xpath>
    <!-- Direct USD Product Cost total (before exchange-rate total_prod_usd) -->
    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.total_prod_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end">
            <strong t-esc="fmtUsdDirect(data.totals.total_prod_usd_direct)"/>
        </td>
    </xpath>

    <!-- ============================================================ -->
    <!-- 13. BYPRODUCTS THEAD – two direct-USD column headers         -->
    <!-- ============================================================ -->

    <!-- BoM Cost USD direct header in byproducts section -->
    <xpath expr="//thead[tr/th[contains(normalize-space(.), 'Byproducts by Category')]]/tr/th[@t-if='showCostsUsd'][1]" position="before">
        <th t-if="showCostsUsdDirect" class="text-end">BoM Cost <t t-esc="secondaryCurrency.name"/>
            <i class="fa fa-info-circle text-muted ms-1"
               data-tooltip-template="econovo_mrp_bom_cost_summary.ColTooltip"
               t-att-data-tooltip-info="colTooltip('bom_cost_usd_direct')"/>&#8203;
        </th>
    </xpath>
    <!-- Product Cost USD direct header in byproducts section -->
    <xpath expr="//thead[tr/th[contains(normalize-space(.), 'Byproducts by Category')]]/tr/th[@t-if='showCostsUsd'][2]" position="before">
        <th t-if="showCostsUsdDirect" class="text-end">Product Cost <t t-esc="secondaryCurrency.name"/>
            <i class="fa fa-info-circle text-muted ms-1"
               data-tooltip-template="econovo_mrp_bom_cost_summary.ColTooltip"
               t-att-data-tooltip-info="colTooltip('prod_cost_usd_direct')"/>&#8203;
        </th>
    </xpath>

    <!-- ============================================================ -->
    <!-- 3b. BYPRODUCTS TBODY – category rows                         -->
    <!--     NOTE: Odoo XPath inheritance applies only to the FIRST   -->
    <!--     matching node, so sections 3-5 (which use generic        -->
    <!--     row.node / row.prod / row.usage selectors) only affect   -->
    <!--     the Components tbody.  We need dedicated sections here   -->
    <!--     anchored to the flatByproductCategoryRows foreach loop.  -->
    <!-- ============================================================ -->

    <!-- Direct USD BoM Cost for byproduct category rows -->
    <xpath expr="//t[@t-foreach='flatByproductCategoryRows']//td[strong[@t-esc='fmtUsd(row.node.total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <strong t-esc="fmtUsdDirect(row.node.total_usd_direct)"/>
        </td>
    </xpath>
    <!-- Direct USD Product Cost for byproduct category rows -->
    <xpath expr="//t[@t-foreach='flatByproductCategoryRows']//td[strong[@t-esc='fmtUsd(row.node.prod_cost_total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <strong t-esc="fmtUsdDirect(row.node.prod_cost_total_usd_direct)"/>
        </td>
    </xpath>

    <!-- ============================================================ -->
    <!-- 4b. BYPRODUCTS TBODY – product rows                          -->
    <!-- ============================================================ -->

    <!-- Direct USD BoM Cost for byproduct product rows -->
    <xpath expr="//t[@t-foreach='flatByproductCategoryRows']//td[t[@t-esc='fmtUsd(row.prod.total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <t t-esc="fmtUsdDirect(row.prod.total_usd_direct)"/>
        </td>
    </xpath>
    <!-- Direct USD Product Cost for byproduct product rows -->
    <xpath expr="//t[@t-foreach='flatByproductCategoryRows']//td[t[@t-esc='fmtUsd(row.prod.prod_cost_total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <t t-esc="fmtUsdDirect(row.prod.prod_cost_total_usd_direct)"/>
        </td>
    </xpath>

    <!-- ============================================================ -->
    <!-- 5b. BYPRODUCTS TBODY – usage rows                            -->
    <!-- ============================================================ -->

    <!-- Direct USD BoM Cost for byproduct usage rows -->
    <xpath expr="//t[@t-foreach='flatByproductCategoryRows']//td[t[@t-esc='fmtUsd(row.usage.total_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <t t-esc="fmtUsdDirect(row.usage.total_usd_direct)"/>
        </td>
    </xpath>
    <!-- Direct USD Product Cost for byproduct usage rows -->
    <xpath expr="//t[@t-foreach='flatByproductCategoryRows']//td[t[@t-esc='fmtUsd(row.usage.prod_cost_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <t t-esc="fmtUsdDirect(row.usage.prod_cost_usd_direct)"/>
        </td>
    </xpath>

    <!-- ============================================================ -->
    <!-- 14. BYPRODUCTS SUBTOTAL ROW                                  -->
    <!-- ============================================================ -->

    <!-- Direct USD BoM Cost subtotal byproducts (before exchange-rate byproducts_usd) -->
    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.byproducts_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <strong t-esc="fmtUsdDirect(data.totals.byproducts_usd_direct)"/>
        </td>
    </xpath>
    <!-- Direct USD Product Cost subtotal byproducts (before exchange-rate, no class on strong) -->
    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.byproducts_prod_cost_usd)'][not(@class)]]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end text-muted">
            <strong t-esc="fmtUsdDirect(data.totals.byproducts_prod_cost_usd_direct)"/>
        </td>
    </xpath>

    <!-- ============================================================ -->
    <!-- 15. GRAND TOTAL – BYPRODUCTS RECOVERABLE VALUE row           -->
    <!--     col: …[empty ARS] | [empty direct] | [empty TC] | Prod ARS | [direct] | TC -->
    <!-- ============================================================ -->

    <!-- BoM Cost USD Direct for byproducts recoverable row (before BoM exchange-rate td) -->
    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.byproducts_prod_cost_usd)'][@class='text-success']]/preceding-sibling::td[@t-if='showCostsUsd']" position="before">
        <td t-if="showCostsUsdDirect" class="text-end">
            <strong class="text-success" t-esc="fmtUsdDirect(data.totals.byproducts_usd_direct)"/>
        </td>
    </xpath>
    <!-- Direct USD recoverable value (before exchange-rate, strong has text-success class) -->
    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.byproducts_prod_cost_usd)'][@class='text-success']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end">
            <strong class="text-success" t-esc="fmtUsdDirect(data.totals.byproducts_prod_cost_usd_direct)"/>
        </td>
    </xpath>

    <!-- ============================================================ -->
    <!-- 16. GRAND TOTAL – NET PRODUCT COST row                       -->
    <!--     col: …[empty ARS] | [empty direct] | [empty TC] | Net ARS | [direct] | TC -->
    <!-- ============================================================ -->

    <!-- BoM Cost USD Direct for net product cost row (before BoM exchange-rate td) -->
    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.net_prod_usd)']]/preceding-sibling::td[@t-if='showCostsUsd']" position="before">
        <td t-if="showCostsUsdDirect" class="text-end">
            <strong t-esc="fmtUsdDirect(data.totals.net_bom_usd_direct)"/>
        </td>
    </xpath>
    <!-- Direct USD net product cost (before exchange-rate net_prod_usd) -->
    <xpath expr="//td[strong[@t-esc='fmtUsd(data.totals.net_prod_usd)']]" position="before">
        <td t-if="showCostsUsdDirect" class="text-end">
            <strong t-esc="fmtUsdDirect(data.totals.net_prod_usd_direct)"/>
        </td>
    </xpath>

</t>

</templates>
