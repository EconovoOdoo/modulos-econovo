<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Extend the Work Center form view to show costs_hour_usd
        alongside the existing ARS Cost per Hour field.
    -->
    <record id="mrp_workcenter_view_form_usd" model="ir.ui.view">
        <field name="name">mrp.workcenter.view.form.inherit.usd.direct</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <!--
                The native form wraps costs_hour in:
                  <label for="costs_hour"/>
                  <div id="costs_hour"><field name="costs_hour" .../> per workcenter</div>
                We insert a matching label+div pair immediately after that div
                so it appears as a proper row in the "Costing Information" group.
            -->
            <xpath expr="//div[@id='costs_hour']" position="after">
                <label for="costs_hour_usd"/>
                <div>
                    <field name="costs_hour_usd"
                           widget="monetary"
                           options="{'no_symbol': 1}"
                           class="oe_inline"
                           help="Direct USD hourly rate. Auto-set from the exchange rate when 'Cost per Hour' is saved; can be overridden manually."/> per workcenter (USD)
                </div>
            </xpath>
        </field>
    </record>

    <!--
        Extend the Work Center form view to show employee_costs_hour_usd
        alongside the existing employee_costs_hour field (added by
        mrp_workorder enterprise).  This XPath requires mrp_workorder.
    -->
    <record id="mrp_workcenter_view_form_employee_usd" model="ir.ui.view">
        <field name="name">mrp.workcenter.view.form.inherit.employee.usd.direct</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <!-- Insert employee_costs_hour_usd after the div wrapping
                 employee_costs_hour (added by mrp_workorder). -->
            <xpath expr="//div[field[@name='employee_costs_hour']]" position="after">
                <label for="employee_costs_hour_usd" string=""/>
                <div>
                    <field name="employee_costs_hour_usd"
                           class="oe_inline"
                           help="Direct USD employee hourly rate. Auto-set from the exchange rate when 'Employee Cost per Hour' is saved; can be overridden manually."/> per employee (USD)
                </div>
            </xpath>
        </field>
    </record>

    <!--
        Also add the field to the Work Center list/tree view so that
        operators can review and update the values in bulk.
    -->
    <record id="mrp_workcenter_view_list_usd" model="ir.ui.view">
        <field name="name">mrp.workcenter.view.list.inherit.usd.direct</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='costs_hour']" position="after">
                <field name="costs_hour_usd" string="Cost/h (USD)" optional="show"/>
                <field name="employee_costs_hour_usd" string="Empl. Cost/h (USD)" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
