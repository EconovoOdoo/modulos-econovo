<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VUE LISTE -->
    <record id="view_sunu_login_log_list" model="ir.ui.view">
        <field name="name">sunu.login.log.list</field>
        <field name="model">sunu.login.log</field>
        <field name="arch" type="xml">
            <list string="Journal de Connexion">
                <field name="login_time"  string="Date / Heure"/>
                <field name="user_id"     string="Utilisateur"/>
                <field name="login_email" string="Email"/>
                <field name="ip_address"  string="Adresse IP"/>
                <field name="city"        string="Ville"/>
                <field name="country"     string="Pays"/>
                <field name="device_type" string="Appareil"/>
                <field name="browser"     string="Navigateur"/>
                <field name="os"          string="Système"/>
                <field name="is_admin"    string="Admin"/>
            </list>
        </field>
    </record>

    <!-- VUE FORMULAIRE -->
    <record id="view_sunu_login_log_form" model="ir.ui.view">
        <field name="name">sunu.login.log.form</field>
        <field name="model">sunu.login.log</field>
        <field name="arch" type="xml">
            <form string="Détail de Connexion">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group string="Connexion">
                        <group>
                            <field name="login_time"   string="Date / Heure de connexion" readonly="1"/>
                            <field name="user_id"      string="Utilisateur" readonly="1"/>
                            <field name="login_email"  string="Email de connexion" readonly="1"/>
                            <field name="is_admin"     string="Connexion administrateur" readonly="1"/>
                            <field name="session_id"   string="Identifiant de session" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_name" string="Société" readonly="1"/>
                            <field name="db_name"      string="Base de données" readonly="1"/>
                            <field name="lang"         string="Langue" readonly="1"/>
                            <field name="tz"           string="Fuseau horaire" readonly="1"/>
                        </group>
                    </group>

                    <group string="Localisation">
                        <group>
                            <field name="ip_address" string="Adresse IP" readonly="1"/>
                            <field name="city"       string="Ville" readonly="1"/>
                            <field name="country"    string="Pays" readonly="1"/>
                        </group>
                        <group>
                            <field name="latitude"   string="Latitude GPS" readonly="1"/>
                            <field name="longitude"  string="Longitude GPS" readonly="1"/>
                        </group>
                        <div colspan="2" invisible="not google_maps_url">
                            <field name="google_maps_url"
                                   widget="url"
                                   string="Voir sur Google Maps"
                                   readonly="1"/>
                        </div>
                    </group>

                    <group string="Appareil">
                        <group>
                            <field name="device_type" string="Type d'appareil" readonly="1"/>
                            <field name="browser"     string="Navigateur" readonly="1"/>
                            <field name="os"          string="Système d'exploitation" readonly="1"/>
                        </group>
                        <group>
                            <field name="user_agent"  string="Chaîne User-Agent" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_sunu_login_log" model="ir.actions.act_window">
        <field name="name">Journal de Connexion</field>
        <field name="res_model">sunu.login.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune connexion enregistrée pour le moment.
            </p>
            <p>
                Les connexions utilisateurs apparaîtront ici automatiquement
                dès qu'un utilisateur se connectera à Odoo.
            </p>
        </field>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_sunu_login_log_root"
              name="Journal de Connexion"
              sequence="10"
              web_icon="sunu_login_log,static/description/icon.png"/>

    <menuitem id="menu_sunu_login_log"
              name="Journal de Connexion"
              parent="menu_sunu_login_log_root"
              action="action_sunu_login_log"
              sequence="1"/>

</odoo>
