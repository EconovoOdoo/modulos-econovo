<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================
         STOCK VALUATION LAYER - SECURITY RULES
         
         This bridge module extends warehouse restriction to valuation layers.
         Auto-installed when both econovo_user_warehouse_restriction and
         stock_account are present.
         ============================================================ -->

    <!-- Stock Valuation Layer Restriction
         Uses stock.move restriction logic.
         
         Users can only see valuation layers for moves they have access to.
         Prevents access errors when opening valuation layer forms. -->
    <record id="stock_valuation_layer_rule_users" model="ir.rule">
        <field name="name">Stock Valuation Layer - Warehouse Restriction</field>
        <field name="model_id" ref="stock_account.model_stock_valuation_layer"/>
        <field name="domain_force">['|', '|',
            ('stock_move_id.location_id.warehouse_id.user_permission_ids.user_id', '=', user.id),
            ('stock_move_id.location_dest_id.warehouse_id.user_permission_ids.user_id', '=', user.id),
            ('stock_move_id', '=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('econovo_user_warehouse_restriction.user_warehouse_restriction_group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
