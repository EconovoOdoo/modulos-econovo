<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="mrp_bom_view_form_inherit_subcontracting_chain" model="ir.ui.view">
        <field name="name">mrp.bom.view.form.inherit.subcontracting.chain</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_subcontracting_chain"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-link"
                    invisible="not subcontracting_chain_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Subcontracting</span>
                        <span class="o_stat_text">Chain</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='code']" position="after">
                <field name="subcontracting_chain_id" invisible="1" />
            </xpath>
        </field>
    </record>

</odoo>
