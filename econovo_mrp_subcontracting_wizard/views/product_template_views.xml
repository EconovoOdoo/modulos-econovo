<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_template_view_form_inherit_subcontracting_phantom" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.subcontracting.phantom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="before">
                <widget
                    name="web_ribbon"
                    title="Subcontracting Intermediate"
                    bg_color="text-bg-info"
                    invisible="not is_subcontracting_phantom"
                />
                <field name="is_subcontracting_phantom" invisible="1" />
            </xpath>
        </field>
    </record>

</odoo>
