<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="mrp_routing_workcenter_view_form_inherit_category" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.view.form.inherit.category</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="operation_category_id" />
            </xpath>
        </field>
    </record>

    <record id="mrp_routing_workcenter_view_tree_inherit_category" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.view.tree.inherit.category</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="operation_category_id" optional="show" />
            </xpath>
        </field>
    </record>

</odoo>
