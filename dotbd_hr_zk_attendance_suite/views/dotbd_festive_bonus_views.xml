<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         FESTIVE BONUS — List View
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="dotbd_festive_bonus_view_list" model="ir.ui.view">
        <field name="name">dotbd.festive.bonus.view.list</field>
        <field name="model">dotbd.festive.bonus</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not active">
                <field name="active" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="religion"/>
                <field name="bonus_type"/>
                <field name="percentage"/>
                <field name="fixed_amount"/>
                <field name="apply_to"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         FESTIVE BONUS — Form View
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="dotbd_festive_bonus_view_form" model="ir.ui.view">
        <field name="name">dotbd.festive.bonus.view.form</field>
        <field name="model">dotbd.festive.bonus</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="active" string="Active (auto-applies on next payslip generation)"/>
                        <field name="active" widget="boolean_toggle"/>
                    </div>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="country_id"/>
                            <field name="religion"/>
                            <field name="note" placeholder="Optional description..."/>
                        </group>
                        <group string="Bonus Calculation">
                            <field name="bonus_type"/>
                            <field name="percentage"
                                   invisible="bonus_type == 'fixed'"/>
                            <field name="fixed_amount"
                                   invisible="bonus_type != 'fixed'"/>
                            <field name="currency_id"
                                   invisible="bonus_type != 'fixed'"/>
                        </group>
                    </group>
                    <separator string="Scope"/>
                    <group>
                        <field name="apply_to" widget="radio"/>
                    </group>
                    <group invisible="apply_to != 'template'">
                        <field name="salary_template_ids" widget="many2many_tags"/>
                    </group>
                    <group invisible="apply_to != 'employee'">
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         FESTIVE BONUS — Search View
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="dotbd_festive_bonus_view_search" model="ir.ui.view">
        <field name="name">dotbd.festive.bonus.view.search</field>
        <field name="model">dotbd.festive.bonus</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="religion"/>
                <field name="country_id"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_islam" string="Islam"
                        domain="[('religion', '=', 'islam')]"/>
                <filter name="filter_hindu" string="Hinduism"
                        domain="[('religion', '=', 'hindu')]"/>
                <filter name="filter_christian" string="Christianity"
                        domain="[('religion', '=', 'christian')]"/>
                <filter name="filter_buddhist" string="Buddhism"
                        domain="[('religion', '=', 'buddhist')]"/>
                <filter name="filter_universal" string="Universal"
                        domain="[('religion', '=', 'universal')]"/>
                <group name="group_by">
                    <filter name="group_religion" string="Religion"
                            context="{'group_by': 'religion'}"/>
                    <filter name="group_country" string="Country"
                            context="{'group_by': 'country_id'}"/>
                    <filter name="group_bonus_type" string="Bonus Type"
                            context="{'group_by': 'bonus_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         FESTIVE BONUS — Action
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_dotbd_festive_bonus" model="ir.actions.act_window">
        <field name="name">Festive Bonus</field>
        <field name="res_model">dotbd.festive.bonus</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first festive bonus rule
            </p>
            <p>
                Define bonus rules for religious and cultural festivals.
                Activate a rule to have it automatically included as an
                earning line on payslips for matching employees.
            </p>
        </field>
    </record>

</odoo>
