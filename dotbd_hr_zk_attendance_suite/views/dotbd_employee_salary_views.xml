<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         EMPLOYEE SALARY — LIST VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="dotbd_employee_salary_view_list" model="ir.ui.view">
        <field name="name">dotbd.employee.salary.view.list</field>
        <field name="model">dotbd.employee.salary</field>
        <field name="arch" type="xml">
            <tree string="Salary Assignments"
                  decoration-success="state == 'active'"
                  decoration-muted="state == 'expired'"
                  decoration-info="state == 'draft'">
                <field name="name" optional="hide"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="template_id"/>
                <field name="wage_type" widget="badge"
                       decoration-info="wage_type == 'monthly'"
                       decoration-success="wage_type == 'fixed'"
                       decoration-warning="wage_type in ('daily', 'hourly')"
                       optional="show"/>
                <field name="basic_wage" string="Contract Wage"/>
                <field name="currency_id" optional="hide"/>
                <field name="gross_estimate" string="Est. Monthly Gross" optional="show"/>
                <field name="effective_date"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'draft'"
                       decoration-danger="state == 'expired'"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         EMPLOYEE SALARY — FORM VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="dotbd_employee_salary_view_form" model="ir.ui.view">
        <field name="name">dotbd.employee.salary.view.form</field>
        <field name="model">dotbd.employee.salary</field>
        <field name="arch" type="xml">
            <form string="Salary Assignment">
                <header>
                    <button name="action_activate"
                            string="Activate"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'active'"
                            confirm="This will expire any existing active salary for this employee. Continue?"/>
                    <button name="action_expire"
                            string="Mark as Expired"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'active'"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'expired'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                name="action_view_payslips"
                                type="object"
                                icon="fa-file-text-o">
                            <field name="payslip_count" widget="statinfo" string="Payslips"/>
                        </button>
                        <button class="oe_stat_button"
                                name="action_view_contract"
                                type="object"
                                icon="fa-book"
                                string="Contract"
                                invisible="not employee_id"/>
                    </div>

                    <!-- Warning: No active contract -->
                    <div class="alert alert-warning mb-2"
                         role="alert"
                         invisible="not employee_id or has_active_contract">
                        <strong><i class="fa fa-exclamation-triangle" title="Exclamation triangle" aria-label="Exclamation triangle"/> No Active Contract!</strong>
                        <p class="mb-0">
                            Employee <field name="employee_id" readonly="1" class="fw-bold" nolabel="1"/>
                            has no active (Running) contract.
                            Please create a contract first from
                            <strong>Employees → Contracts</strong>,
                            then come back to activate this salary assignment.
                        </p>
                    </div>
                    <field name="has_active_contract" invisible="1"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Warning: Employee type mismatch -->
                    <div class="alert alert-warning mb-2"
                         role="alert"
                         invisible="not employee_type_mismatch">
                        <strong><i class="fa fa-exclamation-triangle" title="Exclamation triangle" aria-label="Exclamation triangle"/> Employee Type Mismatch</strong>
                        <p class="mb-0">
                            This employee's type does not match the template's
                            <strong>Suitable For</strong> setting.
                            The assignment will still work — this is advisory only.
                        </p>
                    </div>
                    <field name="employee_type_mismatch" invisible="1"/>

                    <group>
                        <group string="Employee">
                            <field name="employee_id"
                                   options="{'no_create': True}"
                                   readonly="state == 'active'"/>
                            <field name="department_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="employee_type" readonly="1"
                                   widget="badge"
                                   decoration-info="employee_type == 'employee'"
                                   decoration-warning="employee_type in ('student', 'freelance')"
                                   decoration-danger="employee_type == 'daily_labour'"/>
                            <field name="employee_category_ids"
                                   readonly="1"
                                   widget="many2many_tags"/>
                        </group>
                        <group string="Salary">
                            <field name="template_id"
                                   options="{'no_create': True}"/>
                            <field name="wage_type" readonly="1"
                                   widget="badge"
                                   decoration-info="wage_type == 'monthly'"
                                   decoration-success="wage_type == 'fixed'"
                                   decoration-warning="wage_type in ('daily', 'hourly')"/>
                            <field name="currency_id"
                                   options="{'no_create': True}"
                                   readonly="state == 'active'"/>
                            <field name="basic_wage" readonly="1"
                                   string="Contract Wage"
                                   help="Monthly rate, daily rate, or hourly rate — as set on the employee's active contract. Interpreted according to the template's Wage Type."/>
                            <field name="gross_estimate"
                                   readonly="1"
                                   widget="monetary"
                                   string="Est. Monthly Gross"/>
                            <field name="effective_date"/>
                            <field name="company_id"
                                   options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <!-- Salary breakdown preview -->
                    <group string="Estimated Salary Breakdown"
                           invisible="not template_id or not basic_wage">
                        <div class="col-12">
                            <table class="table table-sm table-bordered"
                                   style="max-width:500px;">
                                <thead>
                                    <tr style="background-color:#f8f9fa;">
                                        <th>Component</th>
                                        <th>Type</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Basic Salary</td>
                                        <td>
                                            <span class="badge text-bg-primary">Earning</span>
                                        </td>
                                        <td class="text-end">
                                            <field name="basic_wage"
                                                   readonly="1"
                                                   nolabel="1"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr style="background-color:#f0f8ff; font-weight:bold;">
                                        <td colspan="2">Estimated Gross Total</td>
                                        <td class="text-end">
                                            <field name="gross_estimate"
                                                   readonly="1"
                                                   nolabel="1"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                            <div class="text-muted" style="font-size:12px;">
                                <i class="fa fa-info-circle me-1" title="Info circle" aria-label="Info circle"/>
                                <span invisible="wage_type not in ('daily', 'hourly')">
                                    Estimate assumes a full month.
                                    Actual payslip amount depends on days/hours worked.
                                </span>
                                <span invisible="wage_type in ('daily', 'hourly')">
                                    Fines and deductions are calculated monthly from attendance data.
                                </span>
                            </div>
                        </div>
                    </group>

                    <group string="Notes">
                        <field name="note"
                               nolabel="1"
                               placeholder="e.g. Salary revised after annual appraisal..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         EMPLOYEE SALARY — SEARCH VIEW
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="dotbd_employee_salary_view_search" model="ir.ui.view">
        <field name="name">dotbd.employee.salary.view.search</field>
        <field name="model">dotbd.employee.salary</field>
        <field name="arch" type="xml">
            <search string="Search Salary Assignments">
                <field name="employee_id"/>
                <field name="template_id"/>
                <field name="department_id"/>
                <filter string="Active"
                        name="active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Draft"
                        name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Expired"
                        name="expired"
                        domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter string="Regular Employees"
                        name="type_employee"
                        domain="[('employee_type', '=', 'employee')]"/>
                <filter string="Daily Labour"
                        name="type_daily_labour"
                        domain="[('employee_type', '=', 'daily_labour')]"/>
                <filter string="Students / Interns"
                        name="type_student"
                        domain="[('employee_type', '=', 'student')]"/>
                <filter string="Freelancers"
                        name="type_freelance"
                        domain="[('employee_type', '=', 'freelance')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Employee"
                            name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Department"
                            name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Template"
                            name="group_template"
                            context="{'group_by': 'template_id'}"/>
                    <filter string="Status"
                            name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Employee Type"
                            name="group_employee_type"
                            context="{'group_by': 'employee_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         EMPLOYEE SALARY — ACTION
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_dotbd_employee_salary" model="ir.actions.act_window">
        <field name="name">Salary Assignments</field>
        <field name="res_model">dotbd.employee.salary</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Assign a salary to your first employee
            </p>
            <p>
                Link employees to salary templates and set their basic wage.
                Payslips are automatically generated each month based on
                attendance data and the configured fine rules.
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         EMPLOYEE FORM — SMART BUTTON (inherit hr.employee)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="hr_employee_view_form_inherit_salary" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.dotbd.salary</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button"
                        name="%(action_dotbd_employee_salary)d"
                        type="action"
                        icon="fa-money"
                        context="{'default_employee_id': id, 'search_default_employee_id': id}">
                    <span class="o_stat_text">Salary</span>
                </button>
            </div>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         EMPLOYEE FORM — PAYROLL TAB (inherit hr.employee)
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="hr_employee_view_form_inherit_payroll_tab" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.dotbd.payroll.tab</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="ZK Payroll" name="dotbd_payroll_tab">
                    <group>
                        <group string="Active Salary Assignment">
                            <field name="dotbd_salary_template_id" readonly="1"/>
                            <field name="dotbd_basic_wage" readonly="1"
                                   string="Contract Wage"/>
                            <field name="dotbd_salary_assignment_id" readonly="1"/>
                            <field name="dotbd_currency_id" invisible="1"/>
                        </group>
                        <group string="Payslips">
                            <field name="dotbd_payslip_count" readonly="1"/>
                            <button name="action_view_dotbd_payslips"
                                    type="object"
                                    string="View Payslips"
                                    class="btn-link"
                                    icon="fa-arrow-right"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
