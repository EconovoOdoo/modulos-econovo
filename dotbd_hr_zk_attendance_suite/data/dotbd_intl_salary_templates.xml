<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        ═══════════════════════════════════════════════════════════════════════
        INTERNATIONAL SALARY TEMPLATES
        noupdate="1" — installed once; administrators may modify freely.

        Regions covered:
          1.  UAE / GCC (Middle East)
          2.  India (Standard Corporate)
          3.  Pakistan (Standard Private)
          4.  Nepal / Sri Lanka (Standard)
          5.  Malaysia (EPF / SOCSO)
          6.  Philippines (SSS / PhilHealth / Pag-IBIG)
          7.  Indonesia (BPJS)
          8.  General International (tax-free, minimal)

        IMPORTANT: Statutory deduction rates and minimum wages change frequently.
        Always verify current rates with local labour law before processing payroll.
        ═══════════════════════════════════════════════════════════════════════
        -->

        <!-- ───────────────────────────────────────────────────────────────
             1. UAE / GCC — STANDARD PACKAGE
             Applies to UAE, Saudi Arabia, Qatar, Kuwait, Bahrain, Oman.
             No income tax. Gratuity is statutory under UAE Labour Law
             (21 working days of basic per year for first 5 years).
             Monthly gratuity provision ≈ basic × 21/365 × 30 ≈ 5.83%.
             Annual air ticket allowance is common but paid once — not monthly.
        ─────────────────────────────────────────────────────────────────── -->
        <record id="tmpl_uae_gcc" model="dotbd.salary.template">
            <field name="name">UAE / GCC — Standard Package</field>
            <field name="template_type">uae_gcc</field>
            <field name="working_days_per_month">22</field>
            <field name="note">
Applicable to UAE, Saudi Arabia, Qatar, Kuwait, Bahrain and Oman.
No income tax deductions.
Gratuity (End of Service Benefit) is provisioned monthly at 5.83% of basic
(21 working days × basic/26 working days per month, annualised).
Remove gratuity provision if your company pays it at end of contract only.
Annual Air Ticket Allowance is typically paid once a year — not included here.
Add custom allowances for child education, furniture, telephone as applicable.
Working days: 22 (standard 5-day week). Adjust to 26 for 6-day operations.
Unpaid / unauthorised leave is deducted at per-day gross rate.
            </field>
        </record>

        <record id="comp_uae_hra" model="dotbd.salary.component">
            <field name="template_id" ref="tmpl_uae_gcc"/>
            <field name="sequence">10</field>
            <field name="name">Housing Allowance</field>
            <field name="code">HRA</field>
            <field name="component_type">allowance</field>
            <field name="calculation_type">percentage</field>
            <field name="percentage">25</field>
        </record>
        <record id="comp_uae_transport" model="dotbd.salary.component">
            <field name="template_id" ref="tmpl_uae_gcc"/>
            <field name="sequence">20</field>
            <field name="name">Transport Allowance</field>
            <field name="code">TRN</field>
            <field name="component_type">allowance</field>
            <field name="calculation_type">percentage</field>
            <field name="percentage">10</field>
        </record>
        <record id="comp_uae_gratuity" model="dotbd.salary.component">
            <field name="template_id" ref="tmpl_uae_gcc"/>
            <field name="sequence">30</field>
            <field name="name">Gratuity Provision (End of Service)</field>
            <field name="code">GRAT</field>
            <field name="component_type">allowance</field>
            <field name="calculation_type">percentage</field>
            <field name="percentage">5.83</field>
        </record>

        <record id="lvrule_uae_unpaid" model="dotbd.salary.leave.rule">
            <field name="template_id" ref="tmpl_uae_gcc"/>
            <field name="sequence">99</field>
            <field name="name">Unpaid / Unauthorised Leave Deduction</field>
            <field name="rule_action">deduct</field>
            <field name="amount_type">per_day_gross</field>
        </record>

        <!-- ───────────────────────────────────────────────────────────────
             2. INDIA — STANDARD CORPORATE PACKAGE
             Based on standard CTC structure for Indian private sector.
             Basic: 40-50% of gross. HRA: 40% of basic (metro city rate).
             PF Employee: 12% of basic (EPF Act 1952, capped at INR 15,000 basic).
             Professional Tax: fixed INR 200/month (most states — adjust by state).
             ESI: applicable if gross < INR 21,000 (0.75% employee share).
             Add income tax (TDS) as a custom deduction per employee slab.
        ─────────────────────────────────────────────────────────────────── -->
        <record id="tmpl_india" model="dotbd.salary.template">
            <field name="name">India — Standard Corporate Package</field>
            <field name="template_type">india</field>
            <field name="working_days_per_month">26</field>
            <field name="note">
Based on standard Indian CTC structure for private sector organisations.
Basic is set per employee. Allowances calculated as percentage of basic.
PF Employee (EPF): 12% of basic, capped at INR 15,000 basic = INR 1,800 max.
  For employees above the PF ceiling, disable the PF deduction component.
Professional Tax: fixed INR 200/month for most states (varies — Karnataka = INR 200,
  Maharashtra = up to INR 2,500/yr). Adjust as required.
ESI (Employee): 0.75% of gross, applicable only if gross ≤ INR 21,000/month.
  Disable this component for higher-salary employees.
HRA rate: 40% of basic for non-metro, 50% for metro cities.
TDS/Income Tax: add per employee as a custom fixed deduction.
LTA (Leave Travel Allowance): included at 8.33% for annual encashment provision.
            </field>
        </record>

        <record id="comp_india_hra" model="dotbd.salary.component">
            <field name="template_id" ref="tmpl_india"/>
            <field name="sequence">10</field>
            <field name="name">House Rent Allowance</field>
            <field name="code">HRA</field>
            <field name="component_type">allowance</field>
            <field name="calculation_type">percentage</field>
            <field name="percentage">40</field>
        </record>
        <record id="comp_india_special" model="dotbd.salary.component">
            <field name="template_id" ref="tmpl_india"/>
            <field name="sequence">20</field>
            <field name="name">Special Allowance</field>
            <field name="code">SPA</field>
            <field name="component_type">allowance</field>
            <field name="calculation_type">percentage</field>
            <field name="percentage">15</field>
        </record>
        <record id="comp_india_lta" model="dotbd.salary.component">
            <field name="template_id" ref="tmpl_india"/>
            <field name="sequence">30</field>
            <field name="name">Leave Travel Allowance</field>
            <field name="code">LTA</field>
            <field name="component_type">allowance</field>
            <field name="calculation_type">percentage</field>
            <field name="percentage">8.33</field>
        </record>
        <record id="comp_india_medical" model="dotbd.salary.component">
            <field name="template_id" ref="tmpl_india"/>
            <field name="sequence">40</field>
            <field name="name">Medical Reimbursement</field>
            <field name="code">MED</field>
            <field name="component_type">allowance</field>
            <field name="calculation_type">percentage</field>
            <field name="percentage">5</field>
        </record>
        <!-- Statutory deductions -->
        <record id="comp_india_pf" model="dotbd.salary.component">
            <field name="template_id" ref="tmpl_india"/>
            <field name="sequence">50</field>
            <field name="name">Provident Fund — Employee (EPF 12%)</field>
            <field name="code">PF_EMP</field>
            <field name="component_type">deduction</field>
            <field name="calculation_type">percentage</field>
            <field name="percentage">12</field>
        </record>
        <record id="comp_india_esi" model="dotbd.salary.component">
            <field name="template_id" ref="tmpl_india"/>
            <field name="sequence">60</field>
            <field name="name">ESI — Employee (0.75%)</field>
            <field name="code">ESI_EMP</field>
            <field name="component_type">deduction</field>
            <field name="calculation_type">percentage</field>
            <field name="percentage">0.75</field>
        </record>
        <record id="comp_india_pt" model="dotbd.salary.component">
            <field name="template_id" ref="tmpl_india"/>
            <field name="sequence">70</field>
            <field name="name">Professional Tax</field>
            <field name="code">PT</field>
            <field name="component_type">deduction</field>
            <field name="calculation_type">fixed</field>
            <field name="fixed_amount">200</field>
        </record>

        <record id="lvrule_india_unpaid" model="dotbd.salary.leave.rule">
            <field name="template_id" ref="tmpl_india"/>
            <field name="sequence">99</field>
            <field name="name">Loss of Pay (LOP) — Unpaid Leave</field>
            <field name="rule_action">deduct</field>
            <field name="amount_type">per_day_gross</field>
        </record>

