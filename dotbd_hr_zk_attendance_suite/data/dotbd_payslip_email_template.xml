<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Payslip Email Template ──────────────────────────────────── -->
        <record id="email_template_dotbd_payslip" model="mail.template">
            <field name="name">Payslip: Send to Employee</field>
            <field name="model_id" ref="model_dotbd_payslip"/>
            <field name="subject">Your Payslip for {{ object.month_label }}</field>
            <field name="partner_to">{{ object.employee_id.work_email }}</field>
            <field name="email_from">{{ (user.email_formatted or user.company_id.email) }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                    <p>Dear <strong><t t-out="object.employee_id.name"/></strong>,</p>
                    <p>
                        Please find attached your salary payslip for
                        <strong><t t-out="object.month_label"/></strong>.
                    </p>
                    <table style="border-collapse: collapse; width: 320px; margin: 16px 0;">
                        <tr style="background: #875A7B; color: #fff;">
                            <th colspan="2" style="padding: 8px 12px; text-align: left;">
                                Salary Summary
                            </th>
                        </tr>
                        <tr>
                            <td style="padding: 6px 12px; border: 1px solid #ddd; font-weight: bold;">Basic Wage</td>
                            <td style="padding: 6px 12px; border: 1px solid #ddd;">
                                <t t-out="object.currency_id.symbol"/>
                                <t t-out="'{:,.2f}'.format(object.basic_wage)"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 6px 12px; border: 1px solid #ddd; font-weight: bold;">Gross</td>
                            <td style="padding: 6px 12px; border: 1px solid #ddd;">
                                <t t-out="object.currency_id.symbol"/>
                                <t t-out="'{:,.2f}'.format(object.gross_amount)"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 6px 12px; border: 1px solid #ddd; font-weight: bold;">Deductions</td>
                            <td style="padding: 6px 12px; border: 1px solid #ddd; color: #c0392b;">
                                - <t t-out="object.currency_id.symbol"/>
                                <t t-out="'{:,.2f}'.format(object.total_deductions)"/>
                            </td>
                        </tr>
                        <tr style="background: #e8f4fc;">
                            <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold; font-size: 15px;">Net Salary</td>
                            <td style="padding: 8px 12px; border: 1px solid #ddd; font-weight: bold; font-size: 15px; color: #1a5276;">
                                <t t-out="object.currency_id.symbol"/>
                                <t t-out="'{:,.2f}'.format(object.net_amount)"/>
                            </td>
                        </tr>
                    </table>
                    <p>
                        Please contact HR if you have any questions about this payslip.
                    </p>
                    <p>
                        Regards,<br/>
                        <strong><t t-out="user.company_id.name"/></strong><br/>
                        HR Department
                    </p>
                </div>
            </field>
            <!-- Attach the PDF payslip -->
            <field name="report_template_ids"
                   eval="[(4, ref('action_report_dotbd_payslip_pdf'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
