<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Tree View -->
    <record id="view_currency_rate_source_tree" model="ir.ui.view">
        <field name="name">currency.rate.source.tree</field>
        <field name="model">currency.rate.source</field>
        <field name="arch" type="xml">
            <tree string="Currency Rate Sources" 
                  decoration-danger="last_status == 'error'"
                  decoration-warning="last_status == 'warning'"
                  decoration-success="last_status == 'success'"
                  decoration-muted="state == 'draft' or not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="source_currency_id"/>
                <field name="target_currency_id" optional="show"/>
                <field name="url" optional="hide"/>
                <field name="extraction_method"/>
                <field name="last_rate" digits="[16, 4]"/>
                <field name="last_sync_date"/>
                <field name="last_status" widget="badge"
                       decoration-success="last_status == 'success'"
                       decoration-warning="last_status == 'warning'"
                       decoration-danger="last_status == 'error'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'error'"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_currency_rate_source_form" model="ir.ui.view">
        <field name="name">currency.rate.source.form</field>
        <field name="model">currency.rate.source</field>
        <field name="arch" type="xml">
            <form string="Currency Rate Source">
                <header>
                    <button name="action_update_rate" 
                            type="object" 
                            string="Update Now" 
                            class="oe_highlight"/>
                    <button name="action_test_extraction" 
                            type="object" 
                            string="Test Extraction"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-history">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., USD - Bank Central"/>
                        </h1>
                    </div>
                    
                    <!-- Status Panel -->
                    <group name="status_panel" invisible="not last_sync_date">
                        <group>
                            <field name="last_rate" readonly="1"/>
                            <field name="last_sync_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_status" widget="badge" readonly="1"
                                   decoration-success="last_status == 'success'"
                                   decoration-warning="last_status == 'warning'"
                                   decoration-danger="last_status == 'error'"/>
                            <field name="success_rate" widget="progressbar" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- General Tab -->
                        <page string="General" name="general">
                            <group>
                                <group string="Currency Configuration">
                                    <field name="source_currency_id" options="{'no_create': True}"/>
                                    <field name="target_currency_id" options="{'no_create': True}"/>
                                    <field name="active"/>
                                    <field name="sequence"/>
                                </group>
                                <group string="Source URL">
                                    <field name="url" widget="url" placeholder="https://api.example.com/rates"/>
                                    <field name="notes" placeholder="Description of this source"/>
                                </group>
                            </group>
                        </page>

                        <!-- HTTP Configuration Tab -->
                        <page string="HTTP Configuration" name="http_config">
                            <group>
                                <group string="Request Settings">
                                    <field name="http_method"/>
                                    <field name="http_timeout"/>
                                    <field name="http_retries"/>
                                    <field name="http_user_agent"/>
                                </group>
                                <group string="Response Type">
                                    <field name="response_type"/>
                                </group>
                            </group>
                            <group string="Custom Headers" name="headers">
                                <field name="http_headers" 
                                       widget="code"
                                       placeholder='{"Authorization": "Bearer xxx"}'/>
                            </group>
                            <group string="Request Body (for POST)" 
                                   invisible="http_method != 'POST'"
                                   name="request_body">
                                <field name="http_body" widget="code"/>
                            </group>
                        </page>

                        <!-- Extraction Method Tab -->
                        <page string="Extraction Method" name="extraction">
                            <group>
                                <group string="Method Selection">
                                    <field name="extraction_method"/>
                                </group>
                            </group>

                            <!-- Automatic Extraction -->
                            <group string="Automatic Detection Settings" 
                                   invisible="extraction_method != 'auto'">
                                <field name="auto_keyword" 
                                       placeholder="dolar, dollar, usd"/>
                            </group>
                            <!-- Auto Detection Quick Reference -->
                            <group string="Quick Reference" invisible="extraction_method != 'auto'">
                                <div colspan="2" class="alert alert-info mb-0">
                                    <p class="mb-2"><strong>Automatic detection analyzes the response and applies the best method:</strong></p>
                                    <ol class="mb-2">
                                        <li>Check Content-Type: JSON -&gt; JSONPath, XML -&gt; XPath, HTML -&gt; Regex</li>
                                        <li>For JSON: Search common fields (rate, value, price)</li>
                                        <li>For HTML: Find numeric patterns near the keyword</li>
                                    </ol>
                                    <p class="mb-0 text-warning"><strong>Note:</strong> Less precise than manual methods. Not recommended for critical production.</p>
                                </div>
                            </group>

                            <!-- Regex Extraction -->
                            <group string="Regex Configuration" 
                                   invisible="extraction_method != 'regex'">
                                <field name="regex_pattern" 
                                       widget="code"
                                       placeholder="Dolar[^0-9]*([0-9]+[.,][0-9]+)"/>
                                <field name="regex_group"/>
                                <field name="regex_flag_ignorecase"/>
                                <field name="regex_flag_multiline"/>
                                <field name="regex_flag_dotall"/>
                            </group>
                            <!-- Regex Quick Reference -->
                            <group string="Quick Reference" invisible="extraction_method != 'regex'">
                                <div colspan="2">
                                    <p><strong>Use () for capture groups. The value is extracted from the specified group.</strong></p>
                                    <table class="table table-sm table-bordered mb-2">
                                        <thead><tr><th>Symbol</th><th>Meaning</th><th>Example</th></tr></thead>
                                        <tbody>
                                            <tr><td><code>.</code></td><td>Any character</td><td><code>USD.+</code></td></tr>
                                            <tr><td><code>\d</code></td><td>Digit (0-9)</td><td><code>\d+</code></td></tr>
                                            <tr><td><code>\s</code></td><td>Whitespace</td><td><code>\s*</code></td></tr>
                                            <tr><td><code>*</code> / <code>+</code></td><td>0+ / 1+ repetitions</td><td><code>[0-9]+</code></td></tr>
                                            <tr><td><code>?</code></td><td>Optional</td><td><code>\d+\.?\d*</code></td></tr>
                                            <tr><td><code>(...)</code></td><td>Capture group</td><td><code>USD.*?([0-9.,]+)</code></td></tr>
                                            <tr><td><code>[abc]</code></td><td>Character class</td><td><code>[0-9.,]+</code></td></tr>
                                        </tbody>
                                    </table>
                                    <p class="mb-0"><strong>Common:</strong> <code>([0-9]+[.,][0-9]+)</code> | <code>USD&lt;/td&gt;\s*&lt;td&gt;([0-9.,]+)</code></p>
                                </div>
                            </group>

                            <!-- XPath Extraction -->
                            <group string="XPath Configuration" 
                                   invisible="extraction_method != 'xpath'">
                                <field name="xpath_expression" 
                                       widget="code"
                                       placeholder="//table[@id='rates']//tr[contains(.,'USD')]/td[2]/text()"/>
                                <field name="xpath_attribute"/>
                                <field name="xpath_result_index"/>
                            </group>
                            <!-- XPath Quick Reference -->
                            <group string="Quick Reference" invisible="extraction_method != 'xpath'">
                                <div colspan="2">
                                    <p><strong>Navigate HTML/XML by position, attributes, or content.</strong></p>
                                    <table class="table table-sm table-bordered mb-2">
                                        <thead><tr><th>Expression</th><th>Meaning</th><th>Example</th></tr></thead>
                                        <tbody>
                                            <tr><td><code>//</code></td><td>Any level</td><td><code>//table//td</code></td></tr>
                                            <tr><td><code>[@id='x']</code></td><td>By attribute</td><td><code>//table[@id='rates']</code></td></tr>
                                            <tr><td><code>[n]</code></td><td>By position (1-indexed)</td><td><code>//tr[2]/td[3]</code></td></tr>
                                            <tr><td><code>contains()</code></td><td>Text contains</td><td><code>//tr[td[contains(.,'USD')]]</code></td></tr>
                                            <tr><td><code>text()</code></td><td>Text content</td><td><code>//span/text()</code></td></tr>
                                            <tr><td><code>[last()]</code></td><td>Last element</td><td><code>//tr[last()]/td</code></td></tr>
                                        </tbody>
                                    </table>
                                    <p class="text-muted mb-0"><em>Use "XPath Attribute" to extract an attribute (e.g., "value") instead of text.</em></p>
                                </div>
                            </group>

                            <!-- JSONPath Extraction -->
                            <group string="JSONPath Configuration" 
                                   invisible="extraction_method != 'jsonpath'">
                                <field name="jsonpath_expression" 
                                       widget="code"
                                       placeholder="$.data.rates.USD.value"/>
                                <field name="jsonpath_result_index"/>
                            </group>
                            <!-- JSONPath Quick Reference -->
                            <group string="Quick Reference" invisible="extraction_method != 'jsonpath'">
                                <div colspan="2">
                                    <p><strong>Navigate JSON structures using XPath-like syntax.</strong></p>
                                    <table class="table table-sm table-bordered mb-2">
                                        <thead><tr><th>Expression</th><th>Meaning</th><th>Example</th></tr></thead>
                                        <tbody>
                                            <tr><td><code>$</code></td><td>Root of JSON</td><td><code>$.rate</code></td></tr>
                                            <tr><td><code>.property</code></td><td>Access property</td><td><code>$.data.rates.USD</code></td></tr>
                                            <tr><td><code>[0]</code></td><td>Array index (0-based)</td><td><code>$.rates[0].value</code></td></tr>
                                            <tr><td><code>[*]</code></td><td>All elements</td><td><code>$.rates[*].value</code></td></tr>
                                            <tr><td><code>[?(@.x=='y')]</code></td><td>Filter condition</td><td><code>$.rates[?(@.code=='USD')].value</code></td></tr>
                                            <tr><td><code>..property</code></td><td>Recursive search</td><td><code>$..USD</code></td></tr>
                                        </tbody>
                                    </table>
                                    <p class="mb-0"><strong>APIs:</strong> CoinGecko: <code>$.bitcoin.usd</code> | Open Exchange: <code>$.rates.ARS</code></p>
                                </div>
                            </group>

                            <!-- CSS Selector Extraction -->
                            <group string="CSS Selector Configuration" 
                                   invisible="extraction_method != 'css'">
                                <field name="css_selector" 
                                       widget="code"
                                       placeholder="table.rates tr.usd td.value"/>
                                <field name="css_attribute"/>
                                <field name="css_result_index"/>
                            </group>
                            <!-- CSS Quick Reference -->
                            <group string="Quick Reference" invisible="extraction_method != 'css'">
                                <div colspan="2">
                                    <p><strong>Find HTML elements using stylesheet/querySelector syntax.</strong></p>
                                    <table class="table table-sm table-bordered mb-2">
                                        <thead><tr><th>Selector</th><th>Meaning</th><th>Example</th></tr></thead>
                                        <tbody>
                                            <tr><td><code>#id</code></td><td>Select by ID</td><td><code>#rate-usd</code></td></tr>
                                            <tr><td><code>.class</code></td><td>Select by class</td><td><code>.price-value</code></td></tr>
                                            <tr><td><code>[attr="val"]</code></td><td>By attribute</td><td><code>td[data-currency="USD"]</code></td></tr>
                                            <tr><td><code>parent child</code></td><td>Descendant</td><td><code>#rates table td</code></td></tr>
                                            <tr><td><code>parent &gt; child</code></td><td>Direct child</td><td><code>tr &gt; td</code></td></tr>
                                            <tr><td><code>:nth-child(n)</code></td><td>N-th child (1-indexed)</td><td><code>tr td:nth-child(3)</code></td></tr>
                                        </tbody>
                                    </table>
                                    <p class="text-muted mb-0"><em>Leave "CSS Attribute" empty to extract text content.</em></p>
                                </div>
                            </group>

                            <!-- General Tips -->
                            <separator string="Tips"/>
                            <div class="alert alert-secondary">
                                <ul class="mb-0">
                                    <li><strong>Test first:</strong> Always use "Test Extraction" before activating</li>
                                    <li><strong>Result Index:</strong> If multiple elements match, specify which one (1 = first)</li>
                                    <li><strong>Decimal Format:</strong> Configure in "Value Processing" tab to match source format</li>
                                </ul>
                            </div>
                        </page>

                        <!-- Value Processing Tab -->
                        <page string="Value Processing" name="processing">
                            <group>
                                <group string="Decimal Format">
                                    <field name="decimal_format"/>
                                    <field name="custom_thousand_sep" 
                                           invisible="decimal_format != 'custom'"
                                           placeholder="e.g., . or , or space"/>
                                    <field name="custom_decimal_sep" 
                                           invisible="decimal_format != 'custom'"
                                           placeholder="e.g., , or ."/>
                                </group>
                                <group string="Value Transformations">
                                    <field name="invert_rate"/>
                                    <field name="value_multiplier"/>
                                </group>
                            </group>
                        </page>

                        <!-- Validation & Error Handling Tab -->
                        <page string="Validation &amp; Error Handling" name="validation">
                            <group>
                                <group string="Rate Limits">
                                    <field name="min_valid_rate"/>
                                    <field name="max_valid_rate"/>
                                </group>
                                <group string="Variation Control">
                                    <field name="max_variation_percent"/>
                                </group>
                            </group>
                            <group string="Error Handling">
                                <group>
                                    <field name="on_validation_fail"/>
                                    <field name="fallback_source_id" 
                                           invisible="on_validation_fail != 'fallback'"
                                           required="on_validation_fail == 'fallback'"/>
                                    <div class="text-muted small o_row" invisible="on_validation_fail != 'fallback'">
                                        <span>When this source fails, the fallback source will be executed automatically. Only sources with "Automatic Update" disabled are available.</span>
                                    </div>
                                </group>
                            </group>
                            
                            <!-- Error Notifications Section -->
                            <separator string="Error Notifications"/>
                            <group>
                                <group>
                                    <field name="notify_on_error"/>
                                </group>
                            </group>
                            
                            <!-- Users to Notify Table -->
                            <separator string="Users to Notify" invisible="not notify_on_error"/>
                            <field name="notify_user_ids" nolabel="1" invisible="not notify_on_error">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="user_email" optional="show"/>
                                    <field name="force_email"/>
                                    <field name="notes" optional="hide"/>
                                </tree>
                            </field>
                            
                            <!-- External Contacts to Notify -->
                            <separator string="External Contacts to Notify" invisible="not notify_on_error"/>
                            <group invisible="not notify_on_error">
                                <group colspan="2">
                                    <field name="notify_partner_ids" 
                                           widget="many2many_tags" 
                                           placeholder="Add contacts to receive email notifications..."
                                           options="{'no_create_edit': True}"
                                           context="{'show_email': True}"/>
                                </group>
                            </group>
                            <div class="text-muted" invisible="not notify_on_error">
                                <small><i class="fa fa-info-circle"/> External contacts will receive email notifications directly. They don't need an Odoo user account.</small>
                            </div>
                            
                            <!-- Channel Notifications -->
                            <separator string="Channel Notification" invisible="not notify_on_error"/>
                            <group invisible="not notify_on_error">
                                <group>
                                    <field name="notify_channel_id" 
                                           placeholder="Select a Discuss channel..."/>
                                </group>
                                <group invisible="not notify_channel_id">
                                    <field name="notify_channel_mention_all"/>
                                    <field name="notify_channel_send_email"/>
                                </group>
                            </group>
                            
                            <!-- Message Template -->
                            <separator string="Message Template" invisible="not notify_on_error"/>
                            <group invisible="not notify_on_error">
                                <group>
                                    <field name="notify_template_id" 
                                           placeholder="Use default template if empty"
                                           help="Available variables: object.name, object.source_currency_id.name, object.target_currency_id.name, ctx.get('error_message'), ctx.get('error_datetime')"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Date Extraction Tab (moved between Validation and Scheduling) -->
                        <page string="Date Extraction" name="date_extraction">
                            <group string="Configuration">
                                <group>
                                    <field name="extract_date"/>
                                    <field name="date_extraction_method" invisible="not extract_date"/>
                                </group>
                                <group>
                                    <field name="date_format" invisible="not extract_date"/>
                                </group>
                            </group>
                            
                            <!-- Method-specific fields -->
                            <group string="Extraction Pattern" invisible="not extract_date">
                                <group>
                                    <!-- Regex -->
                                    <field name="date_regex" widget="code" 
                                           invisible="date_extraction_method != 'regex'"
                                           placeholder="(\d{2}/\d{2}/\d{4})"/>
                                    <!-- XPath -->
                                    <field name="date_xpath" widget="code" 
                                           invisible="date_extraction_method != 'xpath'"
                                           placeholder="//span[@class='date']/text()"/>
                                    <!-- JSONPath -->
                                    <field name="date_jsonpath" widget="code" 
                                           invisible="date_extraction_method != 'jsonpath'"
                                           placeholder="$.data.date"/>
                                    <!-- CSS Selector -->
                                    <field name="date_css_selector" widget="code" 
                                           invisible="date_extraction_method != 'css'"
                                           placeholder=".date-value, #rate-date"/>
                                </group>
                            </group>
                            
                            <group string="Quick Reference" invisible="not extract_date">
                                <div class="text-muted" colspan="2">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p><strong>Extraction Methods:</strong></p>
                                            <ul class="mb-0">
                                                <li><strong>Regex:</strong> Pattern with capturing group - <code>(\d{2}/\d{2}/\d{4})</code></li>
                                                <li><strong>XPath:</strong> Path expression - <code>//span[@class='date']/text()</code></li>
                                                <li><strong>JSONPath:</strong> JSON path - <code>$.data.date</code></li>
                                                <li><strong>CSS:</strong> CSS selector - <code>.date-value</code></li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <p><strong>Date Format</strong> (Python strptime):</p>
                                            <ul class="mb-0">
                                                <li><code>%d/%m/%Y</code> - 31/12/2024</li>
                                                <li><code>%Y-%m-%d</code> - 2024-12-31</li>
                                                <li><code>%d-%m-%Y</code> - 31-12-2024</li>
                                                <li><code>%m/%d/%Y</code> - 12/31/2024</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </group>
                        </page>

                        <!-- Scheduling Tab -->
                        <page string="Scheduling" name="scheduling">
                            <div class="alert alert-info mb-3" role="alert">
                                <p class="mb-1"><strong>Native Cron Scheduling</strong></p>
                                <p class="mb-0">This source uses Odoo's native cron scheduling. Configure the schedule using the fields below, which directly control the dedicated scheduled action.</p>
                            </div>
                            
                            <group>
                                <group string="Automatic Updates">
                                    <field name="auto_update"/>
                                    <field name="source_tz" help="Timezone for displaying scheduled times. All times in the cron are stored in UTC."/>
                                </group>
                                <group string="Schedule Information">
                                    <field name="next_execution_display" readonly="1" 
                                           invisible="not auto_update"
                                           help="Next execution time in your configured timezone"/>
                                    <field name="nextcall" string="Next Execution Date (UTC)" 
                                           widget="datetime"
                                           invisible="not auto_update"
                                           help="You can modify this to schedule a specific time for the next run. Time is in UTC."/>
                                    <field name="cron_id" readonly="1" 
                                           invisible="not auto_update"
                                           options="{'no_create': True}"
                                           help="Click to view/edit the dedicated scheduled action for this source"/>
                                </group>
                            </group>
                            
                            <!-- Native Cron Configuration -->
                            <group string="Schedule Configuration" invisible="not auto_update">
                                <group>
                                    <label for="interval_number" string="Execute Every"/>
                                    <div class="o_row">
                                        <field name="interval_number" class="oe_inline" style="width: 80px;"/>
                                        <field name="interval_type" class="oe_inline" nolabel="1"/>
                                    </div>
                                </group>
                                <group>
                                    <field name="numbercall" 
                                           help="Number of times to execute. Use -1 for unlimited executions."/>
                                    <field name="priority" 
                                           help="Lower values = higher priority"/>
                                    <field name="doall" 
                                           help="Execute missed runs after server restart"/>
                                </group>
                            </group>
                            
                            <group invisible="not auto_update">
                                <div class="text-muted small" colspan="2">
                                    <p class="mb-1"><strong>Examples:</strong></p>
                                    <ul class="mb-0">
                                        <li><strong>1 Days</strong> = Daily execution</li>
                                        <li><strong>7 Days</strong> = Weekly execution</li>
                                        <li><strong>30 Days</strong> = Monthly execution (approximate)</li>
                                        <li><strong>2 Hours</strong> = Every 2 hours</li>
                                    </ul>
                                </div>
                            </group>
                            
                            <div class="alert alert-warning mt-3" role="alert" invisible="not auto_update">
                                <p class="mb-1"><strong>Important Notes:</strong></p>
                                <ul class="mb-0">
                                    <li><strong>Next Execution Date:</strong> You can manually modify the "Next Execution Date" above to schedule a specific time for the next run.</li>
                                    <li><strong>Timezone Display:</strong> Times are stored in UTC but displayed in your configured Source Timezone for convenience.</li>
                                    <li><strong>Advanced Configuration:</strong> For complex schedules, you can click on the Scheduled Action link above to access all cron options.</li>
                                </ul>
                            </div>
                        </page>

                        <!-- Companies Tab -->
                        <page string="Companies" name="companies">
                            <group>
                                <group string="Multi-Company Settings">
                                    <field name="update_all_companies"/>
                                </group>
                            </group>
                            <group invisible="update_all_companies">
                                <field name="company_ids" 
                                       widget="many2many_tags"
                                       options="{'no_create': True}"/>
                            </group>
                        </page>

                        <!-- Statistics Tab -->
                        <page string="Statistics" name="statistics">
                            <group>
                                <group string="Execution Statistics">
                                    <field name="execution_count" readonly="1"/>
                                    <field name="success_count" readonly="1"/>
                                    <field name="error_count" readonly="1"/>
                                    <field name="success_rate" widget="progressbar" readonly="1"/>
                                </group>
                                <group string="Last Execution">
                                    <field name="last_sync_date" readonly="1"/>
                                    <field name="last_status" readonly="1"/>
                                    <field name="last_rate" readonly="1"/>
                                    <field name="last_raw_value" readonly="1"/>
                                </group>
                            </group>
                            <group string="Error Information" invisible="not last_error">
                                <field name="last_error" readonly="1" widget="code"/>
                            </group>
                            <group string="Debug Information" invisible="not last_http_response">
                                <field name="last_http_response" readonly="1" widget="code"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_currency_rate_source_search" model="ir.ui.view">
        <field name="name">currency.rate.source.search</field>
        <field name="model">currency.rate.source</field>
        <field name="arch" type="xml">
            <search string="Currency Rate Sources">
                <field name="name"/>
                <field name="source_currency_id"/>
                <field name="target_currency_id"/>
                <field name="url"/>
                <separator/>
                <filter string="Active" name="active_sources" domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft_sources" domain="[('state', '=', 'draft')]"/>
                <filter string="Error" name="error_sources" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="Success" name="success" domain="[('last_status', '=', 'success')]"/>
                <filter string="Errors" name="errors" domain="[('last_status', '=', 'error')]"/>
                <filter string="Warnings" name="warnings" domain="[('last_status', '=', 'warning')]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Source Currency" name="group_source_currency" context="{'group_by': 'source_currency_id'}"/>
                    <filter string="Target Currency" name="group_target_currency" context="{'group_by': 'target_currency_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'last_status'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Method" name="group_method" context="{'group_by': 'extraction_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_currency_rate_source" model="ir.actions.act_window">
        <field name="name">Currency Rate Sources</field>
        <field name="res_model">currency.rate.source</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_currency_rate_source_search"/>
        <field name="context">{'search_default_active_sources': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first currency rate source
            </p>
            <p>
                Configure external sources (URLs, APIs) to automatically 
                fetch and update currency exchange rates.
            </p>
        </field>
    </record>

</odoo>
