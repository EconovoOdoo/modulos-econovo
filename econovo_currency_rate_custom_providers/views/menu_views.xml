<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Menu Items -->
    <!-- Parent menu under Invoicing/Configuration -->
    <!-- Uses group_custom_rate_sources which is controlled by implied_group in Settings -->
    <menuitem id="menu_currency_rate_custom_providers_root"
              name="Currency Rate Sources"
              parent="account.menu_finance_configuration"
              groups="econovo_currency_rate_custom_providers.group_custom_rate_sources"
              sequence="35"/>

    <!-- Sources submenu -->
    <menuitem id="menu_currency_rate_source"
              name="Rate Sources"
              parent="menu_currency_rate_custom_providers_root"
              action="action_currency_rate_source"
              groups="econovo_currency_rate_custom_providers.group_custom_rate_sources"
              sequence="10"/>

    <!-- Logs submenu -->
    <menuitem id="menu_currency_rate_log"
              name="Update Logs"
              parent="menu_currency_rate_custom_providers_root"
              action="action_currency_rate_log"
              groups="econovo_currency_rate_custom_providers.group_custom_rate_sources"
              sequence="20"/>

</odoo>
