<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Extend res.config.settings form view - Add to Currencies block -->
    <record id="res_config_settings_view_form_currency_rate_custom_providers" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.currency.rate.custom.providers</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Insert after the native "Automatic Currency Rates" setting in the Currencies block -->
            <xpath expr="//block[@name='main_currency_setting_container']" position="inside">
                
                <!-- Econovo Custom Rate Providers Setting -->
                <setting id="econovo_currency_rate_custom_providers_setting" 
                         invisible="not group_multi_currency"
                         string="Custom Rate Sources"
                         help="Update rates from custom sources (websites, APIs, banks)">
                    <field name="group_currency_rate_custom_providers"/>
                    <div class="content-group" invisible="not group_currency_rate_custom_providers">
                        <div class="mt-2 text-muted small">
                            <em>Each source has its own dedicated scheduled action that runs exactly at the configured time.</em>
                        </div>
                        <div class="mt-3">
                            <button name="action_open_currency_rate_sources" 
                                    type="object" 
                                    string="Configure Sources" 
                                    class="btn-link"
                                    icon="oi-arrow-right"/>
                            <span class="ms-2 text-muted">
                                (<field name="currency_rate_custom_providers_sources_count" class="oe_inline"/> active)
                            </span>
                        </div>
                        <div class="mt-2">
                            <button name="action_open_currency_rate_crons" 
                                    type="object" 
                                    string="View Scheduled Actions" 
                                    class="btn-link"
                                    icon="fa-clock-o"/>
                            <span class="ms-2 text-muted">
                                (<field name="currency_rate_custom_providers_crons_count" class="oe_inline"/> active)
                            </span>
                        </div>
                    </div>
                </setting>
                
            </xpath>
            
            <!-- Keep detailed settings in a separate block below -->
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Custom Rate Providers - Advanced" 
                       name="currency_rate_custom_providers_advanced_settings"
                       invisible="not group_currency_rate_custom_providers">
                    <setting id="currency_rate_custom_providers_general" 
                             string="General Settings">
                        <div class="content-group">
                            <div class="row mt-2">
                                <label for="currency_rate_custom_providers_log_retention_days" class="col-lg-4 o_light_label"/>
                                <field name="currency_rate_custom_providers_log_retention_days" class="col-lg-2"/>
                                <span class="text-muted">days</span>
                            </div>
                            <div class="row mt-2">
                                <label for="currency_rate_custom_providers_default_timeout" class="col-lg-4 o_light_label"/>
                                <field name="currency_rate_custom_providers_default_timeout" class="col-lg-2"/>
                                <span class="text-muted">seconds</span>
                            </div>
                            <div class="row mt-2">
                                <label for="currency_rate_custom_providers_max_retries" class="col-lg-4 o_light_label"/>
                                <field name="currency_rate_custom_providers_max_retries" class="col-lg-2"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="currency_rate_custom_providers_notifications" 
                             string="Notifications">
                        <div class="content-group">
                            <div class="mt-2">
                                <field name="currency_rate_custom_providers_enable_notifications"/>
                                <label for="currency_rate_custom_providers_enable_notifications"/>
                            </div>
                            <div class="mt-2 ms-4" invisible="not currency_rate_custom_providers_enable_notifications">
                                <field name="currency_rate_custom_providers_notify_on_error"/>
                                <label for="currency_rate_custom_providers_notify_on_error"/>
                            </div>
                            <div class="mt-2 ms-4" invisible="not currency_rate_custom_providers_enable_notifications">
                                <field name="currency_rate_custom_providers_notify_on_high_variation"/>
                                <label for="currency_rate_custom_providers_notify_on_high_variation"/>
                            </div>
                            <div class="row mt-2 ms-4" 
                                 invisible="not currency_rate_custom_providers_enable_notifications or not currency_rate_custom_providers_notify_on_high_variation">
                                <label for="currency_rate_custom_providers_variation_threshold" class="col-lg-4 o_light_label"/>
                                <field name="currency_rate_custom_providers_variation_threshold" class="col-lg-2"/>
                                <span class="text-muted">%</span>
                            </div>
                        </div>
                    </setting>
                    <setting id="currency_rate_custom_providers_actions" 
                             string="Manual Actions">
                        <div class="content-group">
                            <div class="row mt-2">
                                <div class="col-lg-4">
                                    <button name="action_update_all_rates_now" 
                                            type="object" 
                                            string="Update All Rates Now" 
                                            class="btn-secondary"
                                            icon="fa-refresh"/>
                                </div>
                                <div class="col-lg-4">
                                    <button name="action_cleanup_old_logs" 
                                            type="object" 
                                            string="Cleanup Old Logs" 
                                            class="btn-secondary"
                                            icon="fa-trash"/>
                                </div>
                                <div class="col-lg-4">
                                    <button name="action_recreate_all_crons" 
                                            type="object" 
                                            string="Sync Scheduled Actions" 
                                            class="btn-secondary"
                                            icon="fa-cogs"
                                            help="Recreate or update scheduled actions for all sources"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>