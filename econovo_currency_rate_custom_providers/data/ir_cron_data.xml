<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 
        DEPRECATED: Legacy cron for backward compatibility only.
        Each source now has its own dedicated cron created automatically.
        This cron is kept inactive and will be removed in a future version.
    -->
    <record id="ir_cron_update_currency_rates" model="ir.cron">
        <field name="name">Custom Rate Providers: Update Rates (DEPRECATED)</field>
        <field name="model_id" ref="model_currency_rate_source"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_rates()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
        <field name="doall" eval="False"/>
        <field name="priority">10</field>
    </record>

    <!-- Scheduled Action: Cleanup Old Logs -->
    <record id="ir_cron_cleanup_currency_rate_logs" model="ir.cron">
        <field name="name">Custom Rate Providers: Cleanup Old Logs</field>
        <field name="model_id" ref="model_currency_rate_log"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_old_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall" eval="False"/>
        <field name="priority">100</field>
    </record>

</odoo>