<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_inherit_delivered_lots" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.delivered.lots</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object"
                        name="action_view_delivered_lots"
                        class="oe_stat_button"
                        icon="fa-barcode"
                        groups="stock.group_production_lot"
                        invisible="delivered_lot_count == 0">
                    <field name="delivered_lot_count" widget="statinfo" string="Lots &amp; S/N"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
