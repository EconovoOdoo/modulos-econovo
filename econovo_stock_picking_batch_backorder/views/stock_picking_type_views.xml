<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="stock_picking_type_view_form" model="ir.ui.view">
        <field name="name">stock.picking.type.view.form.inherit.econovo_stock_picking_batch_backorder</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <field name="create_backorder" position="after">
                <field name="create_backorder_batch"/>
                <field name="backorder_batch_state" invisible="not create_backorder_batch"/>
            </field>
        </field>
    </record>

</odoo>
