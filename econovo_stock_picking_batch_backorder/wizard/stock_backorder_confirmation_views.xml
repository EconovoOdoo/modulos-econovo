<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="stock_backorder_confirmation_view_form" model="ir.ui.view">
        <field name="name">stock.backorder.confirmation.view.form.inherit.econovo_stock_picking_batch_backorder</field>
        <field name="model">stock.backorder.confirmation</field>
        <field name="inherit_id" ref="stock.view_backorder_confirmation"/>
        <field name="arch" type="xml">
            <field name="backorder_confirmation_line_ids" position="after">
                <field name="show_create_backorder_batch" invisible="1"/>
                <group invisible="not show_create_backorder_batch">
                    <field name="create_backorder_batch"/>
                </group>
            </field>
        </field>
    </record>

</odoo>
