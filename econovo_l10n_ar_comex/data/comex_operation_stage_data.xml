<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequences -->
        <record id="sequence_comex_operation_import" model="ir.sequence">
            <field name="name">COMEX Import Operation</field>
            <field name="code">comex.operation.import</field>
            <field name="prefix">IMP/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="sequence_comex_operation_export" model="ir.sequence">
            <field name="name">COMEX Export Operation</field>
            <field name="code">comex.operation.export</field>
            <field name="prefix">EXP/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="sequence_comex_shipment" model="ir.sequence">
            <field name="name">COMEX Shipment</field>
            <field name="code">comex.shipment</field>
            <field name="prefix">SHP/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="sequence_comex_customs_clearance" model="ir.sequence">
            <field name="name">COMEX Customs Clearance</field>
            <field name="code">comex.customs.clearance</field>
            <field name="prefix">DSP/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="sequence_comex_mulc" model="ir.sequence">
            <field name="name">COMEX MULC Operation</field>
            <field name="code">comex.mulc</field>
            <field name="prefix">MULC/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <!-- Default Stages for Import Operations -->
        <record id="stage_draft" model="comex.operation.stage">
            <field name="name">Draft</field>
            <field name="sequence">10</field>
            <field name="operation_type">all</field>
            <field name="is_starting_stage">True</field>
            <field name="description">Initial stage for new operations. Documents are being prepared.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_confirmed" model="comex.operation.stage">
            <field name="name">Confirmed</field>
            <field name="sequence">20</field>
            <field name="operation_type">all</field>
            <field name="description">Operation confirmed, waiting for shipment.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_in_transit_sea" model="comex.operation.stage">
            <field name="name">In Transit (Sea)</field>
            <field name="sequence">30</field>
            <field name="operation_type">import</field>
            <field name="description">Goods are in transit via sea freight.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_in_transit_air" model="comex.operation.stage">
            <field name="name">In Transit (Air)</field>
            <field name="sequence">31</field>
            <field name="operation_type">import</field>
            <field name="description">Goods are in transit via air freight.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_at_port" model="comex.operation.stage">
            <field name="name">At Port</field>
            <field name="sequence">40</field>
            <field name="operation_type">import</field>
            <field name="description">Goods have arrived at destination port, waiting for customs clearance.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_free_zone" model="comex.operation.stage">
            <field name="name">Free Zone</field>
            <field name="sequence">45</field>
            <field name="operation_type">import</field>
            <field name="description">Goods are in a free trade zone.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_fiscal_warehouse" model="comex.operation.stage">
            <field name="name">Fiscal Warehouse</field>
            <field name="sequence">50</field>
            <field name="operation_type">import</field>
            <field name="description">Goods are stored in fiscal deposit awaiting nationalization.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_customs_clearance" model="comex.operation.stage">
            <field name="name">Customs Clearance</field>
            <field name="sequence">60</field>
            <field name="operation_type">import</field>
            <field name="description">Customs clearance in progress with ARCA.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_nationalized" model="comex.operation.stage">
            <field name="name">Nationalized</field>
            <field name="sequence">70</field>
            <field name="operation_type">import</field>
            <field name="is_closing_stage">True</field>
            <field name="description">Goods have been nationalized and cleared customs.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_delivered" model="comex.operation.stage">
            <field name="name">Delivered</field>
            <field name="sequence">80</field>
            <field name="operation_type">all</field>
            <field name="is_closing_stage">True</field>
            <field name="fold">True</field>
            <field name="description">Goods have been delivered to final destination.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_cancelled" model="comex.operation.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">100</field>
            <field name="operation_type">all</field>
            <field name="is_cancel_stage">True</field>
            <field name="fold">True</field>
            <field name="description">Operation has been cancelled.</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Stages for Export Operations -->
        <record id="stage_export_preparing" model="comex.operation.stage">
            <field name="name">Preparing Goods</field>
            <field name="sequence">30</field>
            <field name="operation_type">export</field>
            <field name="description">Preparing goods for export shipment.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_export_quality_control" model="comex.operation.stage">
            <field name="name">Quality Control</field>
            <field name="sequence">35</field>
            <field name="operation_type">export</field>
            <field name="description">Quality inspection and certification process.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_export_at_warehouse" model="comex.operation.stage">
            <field name="name">At Warehouse</field>
            <field name="sequence">40</field>
            <field name="operation_type">export</field>
            <field name="description">Goods ready at warehouse waiting for pickup/shipment.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_export_customs_documentation" model="comex.operation.stage">
            <field name="name">Customs Documentation</field>
            <field name="sequence">50</field>
            <field name="operation_type">export</field>
            <field name="description">Preparing export customs declaration and documentation.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_export_customs_clearance" model="comex.operation.stage">
            <field name="name">Customs Clearance</field>
            <field name="sequence">60</field>
            <field name="operation_type">export</field>
            <field name="description">Export customs clearance in progress with ARCA.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_export_at_port" model="comex.operation.stage">
            <field name="name">At Port/Airport</field>
            <field name="sequence">65</field>
            <field name="operation_type">export</field>
            <field name="description">Goods at port or airport ready for departure.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_export_in_transit" model="comex.operation.stage">
            <field name="name">In Transit</field>
            <field name="sequence">70</field>
            <field name="operation_type">export</field>
            <field name="description">Goods in transit to international destination.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stage_export_arrived" model="comex.operation.stage">
            <field name="name">Arrived at Destination</field>
            <field name="sequence">75</field>
            <field name="operation_type">export</field>
            <field name="is_closing_stage">True</field>
            <field name="description">Goods have arrived at international destination.</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
