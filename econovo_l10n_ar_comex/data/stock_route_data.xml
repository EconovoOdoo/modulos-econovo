<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 
        COMEX Import Route
        ==================
        This route is used to identify products that go through COMEX operations.
        
        Note: Stock rules are NOT defined here because:
        1. Rules with picking_type_id cannot be global (company_id=False)
        2. The actual destination redirection is handled dynamically in 
           purchase_order.button_confirm() based on the COMEX operation's 
           current stage location.
        
        To assign this route to products:
        - Go to Product > Inventory tab > Routes
        - Or set it on Product Category for bulk assignment
        -->
        <record id="route_comex_import" model="stock.route">
            <field name="name">COMEX - Importación Argentina</field>
            <field name="sequence">10</field>
            <field name="product_selectable">True</field>
            <field name="product_categ_selectable">True</field>
            <field name="sale_selectable">False</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
