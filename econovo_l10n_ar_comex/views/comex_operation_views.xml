<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kanban View -->
    <record id="comex_operation_view_kanban" model="ir.ui.view">
        <field name="name">comex.operation.view.kanban</field>
        <field name="model">comex.operation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="stage_id"/>
                <field name="color"/>
                <field name="priority"/>
                <field name="partner_id"/>
                <field name="date_eta"/>
                <field name="amount_cif"/>
                <field name="currency_id"/>
                <field name="purchase_order_count"/>
                <progressbar field="priority" colors='{"3": "danger", "2": "warning", "1": "muted", "0": "success"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''} oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                            <div role="separator" class="dropdown-divider"/>
                                            <ul class="oe_kanban_colorpicker" data-field="color"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="partner_id"/>
                                    <div class="mt-2">
                                        <span class="text-muted">ETA:</span>
                                        <field name="date_eta"/>
                                    </div>
                                    <div>
                                        <span class="text-muted">CIF:</span>
                                        <field name="amount_cif" widget="monetary"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <t t-if="record.purchase_order_count.raw_value > 0">
                                            <span class="badge rounded-pill text-bg-primary" title="Purchase Orders">
                                                <i class="fa fa-shopping-cart"/> <t t-esc="record.purchase_order_count.value"/>
                                            </span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree View -->
    <record id="comex_operation_view_tree" model="ir.ui.view">
        <field name="name">comex.operation.view.tree</field>
        <field name="model">comex.operation</field>
        <field name="arch" type="xml">
            <tree string="COMEX Operations" multi_edit="1">
                <field name="name" decoration-bf="1"/>
                <field name="operation_type" optional="hide"/>
                <field name="partner_id"/>
                <field name="stage_id" widget="badge"/>
                <field name="date_operation"/>
                <field name="date_eta"/>
                <field name="date_arrival" optional="show"/>
                <field name="transport_mode" optional="show"/>
                <field name="origin_country_id" optional="show"/>
                <field name="incoterm_id" optional="hide"/>
                <field name="amount_fob" optional="hide"/>
                <field name="amount_cif" sum="Total CIF"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="purchase_order_count" string="POs"/>
                <field name="shipment_count" string="Shipments" optional="show"/>
                <field name="container_total_count" string="Containers" optional="show"/>
                <button name="action_view_containers" 
                        type="object" 
                        icon="fa-cube" 
                        title="View Containers"
                        invisible="container_total_count == 0"
                        class="btn-link"/>
                <field name="shipment_ids" 
                       widget="many2many_tags"
                       string="BL Numbers"
                       options="{'no_create': True, 'limit': 5}"
                       optional="show"/>
                <field name="payment_terms_display" string="Payment Terms" optional="show"/>
                <field name="nominated_bank_id" optional="show"/>
                <field name="invoice_ids" 
                       widget="many2many_tags" 
                       string="Invoices"
                       options="{'color_field': 'state', 'no_create': True, 'limit': 5}"
                       optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="priority" widget="priority" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="comex_operation_view_form" model="ir.ui.view">
        <field name="name">comex.operation.view.form</field>
        <field name="model">comex.operation</field>
        <field name="arch" type="xml">
            <form string="COMEX Operation">
                <header>
                    <button name="action_create_shipment" string="Create Shipment" type="object" 
                            class="btn-primary" icon="fa-ship"/>
                    <button name="action_create_mulc" string="Create MULC" type="object" 
                            icon="fa-usd"/>
                    <button name="action_create_customs_clearance" string="Create Customs Clearance" type="object" 
                            icon="fa-gavel"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                        <button name="action_view_shipments" type="object" class="oe_stat_button" icon="fa-ship"
                                invisible="shipment_count == 0">
                            <field name="shipment_count" widget="statinfo" string="Shipments"/>
                        </button>
                        <button name="action_view_customs_clearances" type="object" class="oe_stat_button" icon="fa-gavel"
                                invisible="customs_clearance_count == 0">
                            <field name="customs_clearance_count" widget="statinfo" string="Clearances"/>
                        </button>
                        <button name="action_view_mulc" type="object" class="oe_stat_button" icon="fa-usd"
                                invisible="mulc_count == 0">
                            <field name="mulc_count" widget="statinfo" string="MULC"/>
                        </button>
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. IMP/2026/00001"/>
                        </h1>
                    </div>
                    <group>
                        <group name="main_left">
                            <field name="operation_type"/>
                            <field name="partner_id" context="{'show_vat': True}"/>
                            <field name="current_location_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group name="main_right">
                            <field name="date_operation"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Logistics" name="logistics">
                            <group>
                                <group name="transport">
                                    <field name="transport_mode" widget="radio" options="{'horizontal': true}"/>
                                    <field name="incoterm_id"/>
                                    <field name="origin_country_id"/>
                                    <field name="destination_country_id"/>
                                </group>
                                <group name="dates">
                                    <field name="date_etd"/>
                                    <field name="date_eta"/>
                                    <field name="date_arrival"/>
                                    <field name="date_nationalization"/>
                                </group>
                            </group>
                        </page>
                        <page string="Financial" name="financial">
                            <group>
                                <group name="payment_terms">
                                    <field name="currency_id"/>
                                    <field name="payment_instrument_id"/>
                                    <field name="payment_timing_id"/>
                                    <field name="requires_bank_intervention" invisible="1"/>
                                    <field name="nominated_bank_id" 
                                           widget="res_partner_many2one"
                                           context="{'default_is_company': True, 'show_vat': True}"/>
                                </group>
                                <group name="amounts">
                                    <field name="amount_fob"/>
                                    <field name="amount_freight"/>
                                    <field name="amount_insurance"/>
                                    <field name="amount_cif"/>
                                </group>
                            </group>
                            <group>
                                <group name="partners">
                                    <field name="customs_broker_id"/>
                                    <field name="freight_forwarder_id"/>
                                </group>
                                <group name="empty"/>
                            </group>
                        </page>
                        <page string="Invoices/Bills" name="invoices">
                            <field name="invoice_ids" nolabel="1">
                                <tree editable="bottom"
                                      decoration-success="state == 'posted'" 
                                      decoration-warning="state == 'draft'"
                                      decoration-muted="state == 'cancel'">
                                    <field name="name" readonly="1"/>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="move_type" optional="hide" readonly="1"/>
                                    <field name="invoice_date" readonly="1"/>
                                    <field name="amount_total" sum="Total" readonly="1"/>
                                    <field name="currency_id" optional="hide" readonly="1"/>
                                    <field name="state" widget="badge" readonly="1"
                                           decoration-success="state == 'posted'"
                                           decoration-info="state == 'draft'"/>
                                </tree>
                            </field>
                            <div class="alert alert-info" role="alert" style="margin-top: 10px;">
                                <i class="fa fa-info-circle"/> Invoices from Purchase Orders are automatically added. You can also add additional invoices manually using the "Add a line" button above.
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="description" placeholder="Add internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="comex_operation_view_search" model="ir.ui.view">
        <field name="name">comex.operation.view.search</field>
        <field name="model">comex.operation</field>
        <field name="arch" type="xml">
            <search string="Search COMEX Operations">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
                <separator/>
                <filter name="filter_import" string="Imports" domain="[('operation_type', '=', 'import')]"/>
                <filter name="filter_export" string="Exports" domain="[('operation_type', '=', 'export')]"/>
                <separator/>
                <filter name="filter_my_operations" string="My Operations" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="groupby_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="groupby_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="groupby_transport" string="Transport Mode" context="{'group_by': 'transport_mode'}"/>
                    <filter name="groupby_date" string="Operation Date" context="{'group_by': 'date_operation:month'}"/>
                    <filter name="groupby_eta" string="ETA" context="{'group_by': 'date_eta:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="comex_operation_view_calendar" model="ir.ui.view">
        <field name="name">comex.operation.view.calendar</field>
        <field name="model">comex.operation</field>
        <field name="arch" type="xml">
            <calendar string="COMEX Operations" date_start="date_eta" color="stage_id" mode="month" quick_create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
            </calendar>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="comex_operation_view_pivot" model="ir.ui.view">
        <field name="name">comex.operation.view.pivot</field>
        <field name="model">comex.operation</field>
        <field name="arch" type="xml">
            <pivot string="COMEX Operations">
                <field name="stage_id" type="row"/>
                <field name="date_operation" type="col" interval="month"/>
                <field name="amount_cif" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="comex_operation_view_graph" model="ir.ui.view">
        <field name="name">comex.operation.view.graph</field>
        <field name="model">comex.operation</field>
        <field name="arch" type="xml">
            <graph string="COMEX Operations" type="bar">
                <field name="stage_id"/>
                <field name="amount_cif" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Actions -->
    <record id="comex_operation_action" model="ir.actions.act_window">
        <field name="name">COMEX Operations</field>
        <field name="res_model">comex.operation</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="comex_operation_view_search"/>
        <field name="context">{'default_operation_type': 'import'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first COMEX operation
            </p>
            <p>
                Track your import and export operations, manage shipments, 
                customs clearances, and MULC transactions.
            </p>
        </field>
    </record>

    <record id="comex_operation_action_import" model="ir.actions.act_window">
        <field name="name">Imports</field>
        <field name="res_model">comex.operation</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="comex_operation_view_search"/>
        <field name="domain">[('operation_type', '=', 'import')]</field>
        <field name="context">{'default_operation_type': 'import', 'search_default_filter_import': 1}</field>
    </record>

    <record id="comex_operation_action_export" model="ir.actions.act_window">
        <field name="name">Exports</field>
        <field name="res_model">comex.operation</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="comex_operation_view_search"/>
        <field name="domain">[('operation_type', '=', 'export')]</field>
        <field name="context">{'default_operation_type': 'export', 'search_default_filter_export': 1}</field>
    </record>

</odoo>
