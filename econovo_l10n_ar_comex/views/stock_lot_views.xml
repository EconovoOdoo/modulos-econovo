<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="stock_lot_view_form" model="ir.ui.view">
        <field name="name">stock.lot.view.form.inherit.econovo_l10n_ar_comex</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_comex_operations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-ship"
                        invisible="comex_operation_count == 0"
                        groups="econovo_l10n_ar_comex.group_comex_user">
                    <field name="comex_operation_count" widget="statinfo" string="COMEX"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
