<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Sale Order Form -->
    <record id="sale_order_view_form_inherit_comex" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.comex</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add COMEX button box -->
            <div name="button_box" position="inside">
                <button name="action_view_comex_operation" type="object" 
                        class="oe_stat_button" icon="fa-globe"
                        invisible="not comex_operation_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">COMEX</span>
                    </div>
                </button>
                <button name="action_create_comex_operation" type="object"
                        class="oe_stat_button" icon="fa-plus-circle"
                        invisible="comex_operation_id or state == 'cancel'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Create</span>
                        <span class="o_stat_text">COMEX</span>
                    </div>
                </button>
            </div>
            <!-- Add COMEX field in main group -->
            <field name="partner_id" position="after">
                <field name="comex_operation_id" 
                       options="{'no_create': True}"
                       context="{'default_partner_id': partner_id, 'default_operation_type': 'export'}"/>
            </field>
        </field>
    </record>

    <!-- Inherit Sale Order Tree -->
    <record id="sale_order_view_tree_inherit_comex" model="ir.ui.view">
        <field name="name">sale.order.view.tree.inherit.comex</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="comex_operation_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Inherit Sale Order Search -->
    <record id="sale_order_view_search_inherit_comex" model="ir.ui.view">
        <field name="name">sale.order.view.search.inherit.comex</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="comex_operation_id"/>
            </field>
            <filter name="customer" position="after">
                <separator/>
                <filter name="comex_operations" string="COMEX Operations" 
                        domain="[('comex_operation_id', '!=', False)]"/>
            </filter>
        </field>
    </record>

</odoo>
