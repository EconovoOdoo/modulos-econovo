              name="Llegadas a Puerto"
              parent="menu_comex_stock"
              action="action_comex_picking_arrival"
              sequence="20"/>

    <menuitem id="menu_comex_picking_fiscal"
              name="Depósito Fiscal"
              parent="menu_comex_stock"
              action="action_comex_picking_fiscal"
              sequence="30"/>

    <menuitem id="menu_comex_picking_nationalize"
              name="Nacionalizaciones"
              parent="menu_comex_stock"
              action="action_comex_picking_nationalize"
              sequence="40"/>

    <!-- Customs Menu -->
    <menuitem id="menu_comex_customs"
              name="Customs"
              parent="menu_comex_root"
              sequence="30"/>

    <menuitem id="menu_comex_customs_clearance"
              name="Customs Clearances"
              parent="menu_comex_customs"
              action="comex_customs_clearance_action"
              sequence="10"/>

    <!-- Financial Menu -->
    <menuitem id="menu_comex_financial"
              name="Financial"
              parent="menu_comex_root"
              sequence="40"/>

    <menuitem id="menu_comex_mulc"
              name="MULC Operations"
              parent="menu_comex_financial"
              action="comex_mulc_action"
              sequence="10"/>

