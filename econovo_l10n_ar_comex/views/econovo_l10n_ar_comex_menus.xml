<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root Menu -->
    <menuitem id="menu_comex_root"
              name="COMEX"
              web_icon="econovo_l10n_ar_comex,static/description/icon.png"
              sequence="45"/>

    <!-- Operations Menu -->
    <menuitem id="menu_comex_operations"
              name="Operations"
              parent="menu_comex_root"
              sequence="10"/>

    <menuitem id="menu_comex_operation_all"
              name="All Operations"
              parent="menu_comex_operations"
              action="comex_operation_action"
              sequence="10"/>

    <menuitem id="menu_comex_operation_import"
              name="Imports"
              parent="menu_comex_operations"
              action="comex_operation_action_import"
              sequence="20"/>

    <menuitem id="menu_comex_operation_export"
              name="Exports"
              parent="menu_comex_operations"
              action="comex_operation_action_export"
              sequence="30"/>

    <!-- Logistics Menu -->
    <menuitem id="menu_comex_logistics"
              name="Logistics"
              parent="menu_comex_root"
              sequence="20"/>

    <menuitem id="menu_comex_shipments"
              name="Shipments"
              parent="menu_comex_logistics"
              action="comex_shipment_action"
              sequence="10"/>

    <!-- Stock Transfers Menu (under Logistics) -->
    <menuitem id="menu_comex_stock"
              name="Stock Transfers"
              parent="menu_comex_logistics"
              sequence="20"/>

    <menuitem id="menu_comex_picking_all"
              name="All COMEX Transfers"
              parent="menu_comex_stock"
              action="action_comex_picking_all"
              sequence="5"/>

    <menuitem id="menu_comex_picking_in"
              name="Recepciones COMEX"
              parent="menu_comex_stock"
              action="action_comex_picking_in"
