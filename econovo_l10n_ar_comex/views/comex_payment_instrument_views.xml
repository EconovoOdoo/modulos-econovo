<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree view -->
    <record id="comex_payment_instrument_view_tree" model="ir.ui.view">
        <field name="name">comex.payment.instrument.view.tree</field>
        <field name="model">comex.payment.instrument</field>
        <field name="arch" type="xml">
            <tree string="Payment Instruments" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="risk_level" optional="show"/>
                <field name="bank_intervention" optional="show"/>
                <field name="typical_cost_pct" optional="show"/>
                <field name="description" optional="hide"/>
                <field name="active" optional="show" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="comex_payment_instrument_view_form" model="ir.ui.view">
        <field name="name">comex.payment.instrument.view.form</field>
        <field name="model">comex.payment.instrument</field>
        <field name="arch" type="xml">
            <form string="Payment Instrument">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Letter of Credit"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. LC"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="risk_level"/>
                            <field name="bank_intervention"/>
                            <field name="typical_cost_pct"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Detailed description of this payment instrument..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="comex_payment_instrument_action" model="ir.actions.act_window">
        <field name="name">Payment Instruments</field>
        <field name="res_model">comex.payment.instrument</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new payment instrument
            </p>
            <p>
                Define the payment instruments available for COMEX operations,
                such as Telegraphic Transfer (TT), Letter of Credit (L/C), etc.
            </p>
        </field>
    </record>

</odoo>
