<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="comex_operation_tag_view_tree" model="ir.ui.view">
        <field name="name">comex.operation.tag.view.tree</field>
        <field name="model">comex.operation.tag</field>
        <field name="arch" type="xml">
            <tree string="COMEX Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="comex_operation_tag_view_form" model="ir.ui.view">
        <field name="name">comex.operation.tag.view.form</field>
        <field name="model">comex.operation.tag</field>
        <field name="arch" type="xml">
            <form string="COMEX Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="comex_operation_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">comex.operation.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tag
            </p>
            <p>
                Tags allow you to classify and organize your COMEX operations.
            </p>
        </field>
    </record>

</odoo>
