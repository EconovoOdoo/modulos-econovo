<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- COMEX Tribute Product Mapping Views                         -->
    <!-- ============================================================ -->

    <!-- Tree View -->
    <record id="comex_tribute_product_mapping_view_tree" model="ir.ui.view">
        <field name="name">comex.tribute.product.mapping.view.tree</field>
        <field name="model">comex.tribute.product.mapping</field>
        <field name="arch" type="xml">
            <tree string="Tribute Product Mappings" 
                  decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="product_id"/>
                <field name="tribute_field_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="notes" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="comex_tribute_product_mapping_view_form" model="ir.ui.view">
        <field name="name">comex.tribute.product.mapping.view.form</field>
        <field name="model">comex.tribute.product.mapping</field>
        <field name="arch" type="xml">
            <form string="Tribute Product Mapping">
                <sheet>
                    <group>
                        <group name="mapping_config">
                            <field name="sequence"/>
                            <field name="product_id" 
                                   placeholder="Select a service product (e.g., DIE, Tasa Estadística)"
                                   options="{'no_create': True}"/>
                            <field name="tribute_field_id"/>
                        </group>
                        <group name="company">
                            <field name="company_id" 
                                   groups="base.group_multi_company"
                                   placeholder="All companies"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" 
                                   placeholder="Optional: Add internal documentation about this mapping..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="comex_tribute_product_mapping_view_search" model="ir.ui.view">
        <field name="name">comex.tribute.product.mapping.view.search</field>
        <field name="model">comex.tribute.product.mapping</field>
        <field name="arch" type="xml">
            <search string="Tribute Product Mappings">
                <field name="product_id" 
                       filter_domain="['|', ('product_id', 'ilike', self), ('notes', 'ilike', self)]"/>
                <field name="tribute_field_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                
                <filter string="Active" name="filter_active" 
                        domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_inactive" 
                        domain="[('active', '=', False)]"/>
                
                <separator/>
                
                <group expand="0" string="Group By">
                    <filter string="Tribute Field" name="group_tribute_field" 
                            context="{'group_by': 'tribute_field_id'}"/>
                    <filter string="Company" name="group_company" 
                            context="{'group_by': 'company_id'}" 
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_comex_tribute_product_mapping" model="ir.actions.act_window">
        <field name="name">Tribute Product Mappings</field>
        <field name="res_model">comex.tribute.product.mapping</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'search_default_filter_active': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first tribute product mapping
            </p>
            <p>
                Configure which products in Type 66 invoices should be parsed
                to which tribute amount fields in customs clearance.
            </p>
            <p>
                <strong>Example:</strong><br/>
                Product "DIE - Derecho de Importación" → Import Duties<br/>
                Product "Tasa de Estadística 3%" → Statistics Fee
            </p>
        </field>
    </record>

</odoo>
