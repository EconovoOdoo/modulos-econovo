<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- COMEX Operation: Company Rule -->
        <record id="comex_operation_rule_company" model="ir.rule">
            <field name="name">COMEX Operation: Company</field>
            <field name="model_id" ref="model_comex_operation"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

