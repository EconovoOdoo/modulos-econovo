msgid ""
"<strong>COMEX Operations:</strong> Link this invoice to COMEX import/export "
"operations for tracking."
msgstr "<strong>Operaciones COMEX:</strong> Vincule esta factura a las operaciones de importación/exportación COMEX para su seguimiento."

#. module: econovo_l10n_ar_comex
#: model_terms:ir.actions.act_window,help:econovo_l10n_ar_comex.action_comex_tribute_parse_log
msgid ""
"<strong>Color coding:</strong><br>\n"
"                <span style=\"color: #d32f2f;\">⬤ Red</span> = Unmatched (needs configuration)<br>\n"
"                <span style=\"color: #388e3c;\">⬤ Green</span> = Matched by product<br>\n"
"                <span style=\"color: #1976d2;\">⬤ Blue</span> = Matched by keyword"
msgstr "<strong>Codificación por colores:</strong><br>\n <span style=\"color: #d32f2f;\">⬤ Rojo</span> = Sin coincidencia (necesita configuración)<br>\n <span style=\"color: #388e3c;\">⬤ Verde</span> = Coincidencia por producto<br>\n <span style=\"color: #1976d2;\">⬤ Azul</span> = Coincidencia por palabra clave"

#. module: econovo_l10n_ar_comex
#: model_terms:ir.ui.view,arch_db:econovo_l10n_ar_comex.comex_tribute_keyword_mapping_view_form
msgid ""
"<strong>Contains:</strong> Keyword appears anywhere (e.g., \"estadística\" "
"matches \"Tasa Estadística 3%\")"
msgstr "<strong>Contiene:</strong> La palabra clave aparece en cualquier lugar (p. ej., “estadística” coincide con “Tasa Estadística 3%”)"

#. module: econovo_l10n_ar_comex
#: model_terms:ir.ui.view,arch_db:econovo_l10n_ar_comex.view_move_form_inherit_comex
msgid "<strong>Customer Invoices:</strong> Link to EXPORT operations"
msgstr "<strong>Facturas de cliente:</strong> Enlace a operaciones de EXPORTACIÓN"

#. module: econovo_l10n_ar_comex
#: model_terms:ir.ui.view,arch_db:econovo_l10n_ar_comex.view_move_form_inherit_comex
msgid ""
"<strong>Customs Clearances (Document Type 66 only):</strong> If this is a "
"tribute invoice (Despacho Type 66), it will be automatically linked when "
"created from a customs clearance."
msgstr "<strong>Despachos de aduana (solo tipo de documento 66):</strong> Si se trata de una factura de tributo (Despacho tipo 66), se vinculará automáticamente cuando se cree a partir de un despacho de aduana."

#. module: econovo_l10n_ar_comex
#: model_terms:ir.ui.view,arch_db:econovo_l10n_ar_comex.comex_tribute_keyword_mapping_view_form
msgid "<strong>Ends With:</strong> Text must end with keyword"
msgstr "<strong>Termina con:</strong> El texto debe terminar con la palabra clave"

#. module: econovo_l10n_ar_comex
#: model_terms:ir.ui.view,arch_db:econovo_l10n_ar_comex.comex_tribute_keyword_mapping_view_form
msgid "<strong>Exact:</strong> Must match exactly (case-insensitive)"
msgstr "<strong>Exacto:</strong> Debe coincidir exactamente (sin distinción entre mayúsculas y minúsculas)"

#. module: econovo_l10n_ar_comex
#: model_terms:ir.actions.act_window,help:econovo_l10n_ar_comex.action_comex_tribute_keyword_mapping
msgid ""
"<strong>Example:</strong><br>\n"
"                Keyword \"tasa estadística\" (contains) → Statistics Fee<br>\n"
"                Keyword \"perc.*iigg\" (regex) → Income Tax Perception"
msgstr "<strong>Ejemplo:</strong><br>\n                Palabra clave “tasa estadística” (contiene) → Tasa de estadística<br>\n                Palabra clave “perc.*iigg” (regex) → Percepción de impuesto a las ganancias"

#. module: econovo_l10n_ar_comex
#: model_terms:ir.actions.act_window,help:econovo_l10n_ar_comex.action_comex_tribute_product_mapping
msgid ""
"<strong>Example:</strong><br>\n"
"                Product \"DIE - Derecho de Importación\" → Import Duties<br>\n"
"                Product \"Tasa de Estadística 3%\" → Statistics Fee"
msgstr "<strong>Ejemplo:</strong><br>\n                Producto “DIE - Derecho de Importación” → Derechos de importación<br>\n                Producto “Tasa de Estadística 3%” → Tasa de estadística"

#. module: econovo_l10n_ar_comex
#: model_terms:ir.ui.view,arch_db:econovo_l10n_ar_comex.comex_tribute_keyword_mapping_view_form
msgid "<strong>Pattern Matching Tips:</strong>"
msgstr "<strong>Consejos para la coincidencia de patrones:</strong>"

#. module: econovo_l10n_ar_comex
#: model_terms:ir.ui.view,arch_db:econovo_l10n_ar_comex.comex_tribute_keyword_mapping_view_form
msgid ""
"<strong>Priority:</strong> Higher priority patterns are checked first. Use "
"for disambiguation."
msgstr "<strong>Prioridad:</strong> Los patrones de mayor prioridad se comprueban primero. Utilizar para la desambiguación."

#. module: econovo_l10n_ar_comex
#: model_terms:ir.ui.view,arch_db:econovo_l10n_ar_comex.comex_tribute_keyword_mapping_view_form
msgid ""
"<strong>Regex:</strong> Use Python regex (e.g., "
"\"perc(epción)?.*?(ganancias|iigg)\" matches variants)"
msgstr "<strong>Regex:</strong> Utilice regex de Python (por ejemplo, “perc(epción)?.*?(ganancias|iigg)” coincide con variantes)"

#. module: econovo_l10n_ar_comex
#: model_terms:ir.ui.view,arch_db:econovo_l10n_ar_comex.comex_tribute_keyword_mapping_view_form
msgid "<strong>Starts With:</strong> Text must begin with keyword"
msgstr "<strong>Empieza por:</strong> El texto debe empezar por la palabra clave"

#. module: econovo_l10n_ar_comex
