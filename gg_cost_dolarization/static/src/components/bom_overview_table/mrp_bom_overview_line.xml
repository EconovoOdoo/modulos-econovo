<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="mrp.BomOverviewLine"
       t-inherit-mode="extension">

        <!-- Nueva columna en cabecera -->
        <xpath expr="//td[@t-if='showCosts'][2]" position="after">
            <td t-if="showCosts" class="text-end">
                <span t-if="data.hasOwnProperty('standard_price_usd')" t-esc="formatMonetary(data.standard_price_usd * data.quantity)"/>
            </td>
        </xpath>

    </t>
</templates>
