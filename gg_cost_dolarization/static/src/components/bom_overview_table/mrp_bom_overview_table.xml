<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="mrp.BomOverviewTable"
       t-inherit-mode="extension">

        <!-- Nueva columna en cabecera -->
        <xpath expr="//thead/tr" position="inside">
            <th t-if="showCosts" class="text-end">Costo en Dolares</th>
        </xpath>

        <!-- Nueva columna en pie -->
        <xpath expr="//tfoot/tr" position="inside">
            <td class="text-end" t-esc="formatMonetary(data.standard_price_usd * data.quantity)"/>
        </xpath>
    </t>
</templates>
